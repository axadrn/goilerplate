	"Unlimited projects",
	"Every future release",
	"Every frontend and database",
	"Stripe or Polar",
	"Tests, CI and Docker",
	"Stack aware AGENTS.md",
}

type homeFeatureGroup struct {
	Title    string
	Features []string
}

