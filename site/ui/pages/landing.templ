package pages

import (
	"github.com/axadrn/goilerplate/v4/site/brand"
	"github.com/axadrn/goilerplate/v4/site/ui/blocks"
	"github.com/axadrn/goilerplate/v4/site/ui/components/accordion"
	"github.com/axadrn/goilerplate/v4/site/ui/components/badge"
	"github.com/axadrn/goilerplate/v4/site/ui/components/button"
	"github.com/axadrn/goilerplate/v4/site/ui/components/card"
	"github.com/axadrn/goilerplate/v4/site/ui/components/icon"
	"github.com/axadrn/goilerplate/v4/site/ui/components/separator"
	"github.com/axadrn/goilerplate/v4/site/ui/icons"
	"github.com/axadrn/goilerplate/v4/site/ui/layouts"
)

const (
	homeWrap    = "mx-auto w-full max-w-[1240px] px-4 sm:px-8"
	homeDisplay = "font-display leading-[0.95]"
	// homeH2 is the title of a section.
	homeH2 = "font-display leading-[0.95] text-[clamp(2.4rem,6.4vw,5rem)] text-balance"
	// homeLead is the paragraph under a title.
	homeLead = "text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9"
	// homeSection is the space above a section.
	homeSection = "scroll-mt-24 pt-32 sm:pt-44"
)

templ Landing() {
	@layouts.Home(layouts.SEOProps{
		Title:       "The Go SaaS starter kit, free and open source",
		Description: "Login, Stripe billing, teams, admin, API and tests. Already built in Go, already tested, free and open source, and every line yours.",
		Path:        "/",
	}) {
		<main>
			@homeHero()
			@homeInside()
			@homeStack()
			@homeAI()
			@homeFree()
			@homeOps()
			@homeFounder()
			@homeFAQ()
			@homeFinal()
		</main>
		@homeCopyScript()
	}
}

templ homeActions() {
	<div class="flex flex-col gap-3 sm:flex-row">
		@button.Button(button.Props{Href: "/docs/installation", Size: button.SizeLg}) {
			Get started
			@icon.ArrowRight()
		}
		@button.Button(button.Props{Href: "/new", Variant: button.VariantSecondary, Size: button.SizeLg}) {
			Build your stack
		}
	</div>
}

// ---------------------------------------------------------------- hero
templ homeHero() {
	<section class="pt-16 sm:pt-28">
		<div class={ homeWrap }>
			@badge.Badge(badge.Props{Href: "/changelog", Variant: badge.VariantSecondary}) {
				Free and open source now
				@icon.ArrowRight(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-end"}})
			}
			<h1 class={ homeDisplay, "mt-8 text-[clamp(3.2rem,10vw,7.6rem)]" }>
				<span class="block">Your SaaS.</span>
				<span class="block">Without the</span>
				<span class="block text-muted-foreground">boring part.</span>
			</h1>
			<div class="mt-12 grid gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
				<p class={ homeLead, "max-w-xl" }>
					<span class="text-foreground">Login, Stripe billing, teams, admin, API and tests.</span>
					Already built in Go, already tested, and every line is yours. You and your agent start on the product, not the plumbing.
				</p>
				@homeActions()
			</div>
			<div class="mt-12">
				@homeInstall()
			</div>
			<div class="mt-6 flex flex-wrap gap-2">
				for _, fact := range []string{"Free and open source", "No account", "Unlimited projects", "Updates with Git"} {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
						{ fact }
					}
				}
			</div>
		</div>
	</section>
}

// homeInstall is the one line to copy.
templ homeInstall() {
	<div class="ops-term flex items-center gap-3 overflow-hidden rounded-4xl bg-terminal py-2 pr-2 pl-6 text-terminal-foreground" data-copy-root>
		<span class="shrink-0 text-terminal-foreground/45">$</span>
		<code class="min-w-0 flex-1 overflow-x-auto font-mono text-[13px] whitespace-nowrap [scrollbar-width:none] sm:text-[14px]" data-copy-text>{ brand.Install }</code>
		@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Class: "shrink-0 text-terminal-foreground/70 hover:text-terminal-foreground dark:hover:text-terminal-foreground", Attributes: templ.Attributes{"aria-label": "Copy the install command", "data-copy": true}}) {
			<span data-copy-icon>
				@icon.Copy()
			</span>
			<span data-copy-check class="hidden">
				@icon.Check()
			</span>
		}
	</div>
}

templ homeCopyScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		document.addEventListener("click", async (event) => {
			const button = event.target.closest("[data-copy]");
			if (!button) return;
			const text = button.closest("[data-copy-root]")?.querySelector("[data-copy-text]");
			if (!text) return;
			try {
				await navigator.clipboard.writeText(text.textContent.trim());
				button.querySelector("[data-copy-icon]").classList.add("hidden");
				button.querySelector("[data-copy-check]").classList.remove("hidden");
				setTimeout(() => {
					button.querySelector("[data-copy-icon]").classList.remove("hidden");
					button.querySelector("[data-copy-check]").classList.add("hidden");
				}, 1600);
			} catch {}
		});
	</script>
}

// ---------------------------------------------------------------- inside
templ homeInside() {
	<section id="product" class={ homeSection }>
		<div class={ homeWrap }>
			<h2 class={ homeH2, "max-w-[18ch]" }>Everything before your first customer. Done.</h2>
			<div class="mt-12 grid gap-3 sm:mt-16 sm:grid-cols-2 lg:grid-cols-3">
				@homeTile("Auth", "Passwords, magic links, Google and GitHub OAuth, email verification and revocable sessions.")
				@homeTile("Billing", "Stripe or Polar. Subscriptions, trials, customer portal and signed, idempotent webhooks.")
				@homeTile("Teams", "Workspaces with Owner, Admin and Member roles, invitations, seat limits and audit history.")
				@homeTile("Admin", "User search, metrics, session revocation and read only support impersonation.")
				@homeTile("API and MCP", "A JSON API, personal API tokens and an MCP server for your customers' agents.")
				@homeTile("Production", "Tests with the race detector, GitHub Actions CI, Dockerfile, Sentry and migrations.")
			</div>
		</div>
	</section>
}

templ homeTile(title, text string) {
	@card.Card() {
		@card.Header() {
			@card.Title(card.TitleProps{Class: "font-display text-[clamp(1.6rem,3vw,2.2rem)]"}) {
				{ title }
			}
			@card.Description(card.DescriptionProps{Class: "text-base leading-7"}) {
				{ text }
			}
		}
	}
}

// ---------------------------------------------------------------- stack
templ homeStack() {
	<section id="stack" class={ homeSection }>
		<div class={ homeWrap }>
			@card.Card() {
				@card.Content(card.ContentProps{Class: "grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16"}) {
					<div>
						<h2 class={ homeH2 }>Your stack. Your choice.</h2>
						<p class={ homeLead, "mt-6 max-w-md" }>Pick what you need. The generator writes a clean Go repository and leaves everything else out.</p>
						<div class="mt-10 grid gap-5">
							@homeChoice("Frontend", []string{"htmx 4.0", "Datastar 1.0", "SvelteKit", "Headless"})
							@homeChoice("Database", []string{"SQLite", "PostgreSQL"})
							@homeChoice("Payments", []string{"Stripe", "Polar"})
							@homeChoice("Email", []string{"SMTP", "Resend"})
						</div>
						<div class="mt-10">
							@button.Button(button.Props{Href: "/new", Variant: button.VariantSecondary, Size: button.SizeLg}) {
								Open the stack builder
								@icon.ArrowRight()
							}
						</div>
					</div>
					<div class="ops-term overflow-x-auto rounded-3xl bg-terminal px-6 py-5 text-[13px] leading-6 whitespace-pre text-terminal-foreground sm:text-[14px]" aria-label="A terminal session with goilerplate">
						<p><span class="text-terminal-foreground/45">$ </span>goilerplate new --name Acme --module example.com/acme \</p>
						<p>{ "    --framework htmx --database postgres --payment stripe \\" }</p>
						<p>{ "    --workspaces ./acme" }</p>
						<p class="mt-2 text-live">✓ Created Acme in ./acme with v4.0.0</p>
						<p class="text-terminal-foreground/60">› Git is ready on main with an initial commit</p>
						<p class="mt-4"><span class="text-terminal-foreground/45">$ </span>cd acme && cp .env.example .env</p>
						<p><span class="text-terminal-foreground/45">$ </span>task dev</p>
					</div>
				}
			}
		</div>
	</section>
}

templ homeChoice(label string, options []string) {
	<div class="grid gap-2 sm:grid-cols-[7rem_minmax(0,1fr)] sm:items-center">
		<p class="text-sm text-muted-foreground">{ label }</p>
		<div class="flex flex-wrap gap-2">
			for _, option := range options {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					{ option }
				}
			}
		</div>
	</div>
}

// ---------------------------------------------------------------- ai
templ homeAI() {
	<section id="ai" class={ homeSection }>
		<div class={ homeWrap }>
			<div class="rounded-4xl bg-foreground px-7 py-16 text-background sm:px-14 sm:py-24 lg:px-20">
				<h2 class={ homeH2, "max-w-4xl" }>
					AI writes the easy 80%.
					<span class="text-background/55">The last 20% costs you weeks.</span>
				</h2>
				<div class="mt-14 grid gap-10 md:grid-cols-3">
					@homeAIPoint("Billing that survives reality", "Retried webhooks, out of order events, failed renewals, seat changes. Solved once, tested, and kept up to date.")
					@homeAIPoint("Tenant isolation", "Every query scoped to the right workspace. The kind of bug an agent writes quietly and a customer finds loudly.")
					@homeAIPoint("Updates that keep coming", "Security fixes like templ v0.3.1100 land in your project with goilerplate update. Your own code stays yours.")
				</div>
				<p class="mt-14 max-w-2xl text-lg leading-8 text-background/65">
					Every project ships a stack aware <span class="font-mono text-background">AGENTS.md</span>, so Claude, Cursor or Codex extend a tested foundation instead of inventing a new one each session.
				</p>
			</div>
		</div>
	</section>
}

templ homeAIPoint(title, text string) {
	<div class="border-t border-background/20 pt-6">
		<h3 class="text-xl font-bold tracking-[-0.02em]">{ title }</h3>
		<p class="mt-3 text-base leading-7 text-background/65">{ text }</p>
	</div>
}

// ---------------------------------------------------------------- free
// homeFree is where the price used to be: everything is in it, for free.
templ homeFree() {
	<section id="free" class={ homeSection }>
		<div class={ homeWrap }>
			<h2 class={ homeH2, "max-w-[16ch]" }>Free. Everything in it.</h2>
			<p class={ homeLead, "mt-8 max-w-2xl" }>
				<span class="text-foreground">Every frontend, both databases, both payment providers, both mail providers and every module.</span>
				No account, no license key, no telemetry.
			</p>
			<div class="mt-12 grid gap-3 sm:mt-16 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
				@card.Card() {
					@card.Header() {
						@card.Description() {
							The license
						}
						@card.Title(card.TitleProps{Class: "font-display text-[clamp(3rem,6vw,4.5rem)] leading-none"}) {
							MIT and 0BSD
						}
					}
					@card.Content(card.ContentProps{Class: "grid gap-4 text-base leading-7 text-muted-foreground"}) {
						<p>The CLI is MIT. The template and every project it generates are 0BSD: use, change and sell what you build, with no notice to keep.</p>
						<p>Generated projects ship without a LICENSE file, so you choose your own.</p>
					}
					@card.Footer(card.FooterProps{Class: "mt-auto flex-wrap gap-3"}) {
						@button.Button(button.Props{Href: "/docs/installation", Size: button.SizeLg}) {
							Get started
							@icon.ArrowRight()
						}
						@button.Button(button.Props{Href: blocks.GitHubURL, Target: "_blank", Variant: button.VariantSecondary, Size: button.SizeLg, Attributes: templ.Attributes{"rel": "noopener"}}) {
							@icons.GitHub(16)
							Star it on GitHub
						}
					}
				}
				@card.Card() {
					@card.Content() {
						<ul class="grid gap-4 text-base sm:grid-cols-2">
							for _, feature := range homeFeatures {
								@homeFeature(feature)
							}
						</ul>
						@separator.Separator(separator.Props{Class: "my-8"})
						<div class="grid gap-6 text-center sm:grid-cols-3">
							@homeTerm("Price", "Free")
							@homeTerm("Projects", "Unlimited")
							@homeTerm("Updates", "goilerplate update")
						</div>
					}
				}
			</div>
			@accordion.Accordion(accordion.Props{Class: "mt-3 rounded-4xl bg-card px-2 sm:px-4"}) {
				@accordion.Item() {
					@accordion.Trigger(accordion.TriggerProps{Class: "px-4 py-5 text-base font-semibold sm:px-5"}) {
						See every feature
					}
					@accordion.Content() {
						<div class="grid gap-3 px-4 pb-6 sm:px-5 md:grid-cols-2">
							for _, group := range homeFeatureGroups {
								<div class="rounded-2xl bg-background p-6">
									<p class="font-semibold">{ group.Title }</p>
									<ul class="mt-4 grid gap-3 text-sm text-muted-foreground">
										for _, feature := range group.Features {
											@homeFeature(feature)
										}
									</ul>
								</div>
							}
						</div>
					}
				}
			}
		</div>
	</section>
}

var homeFeatures = []string{
	"Go, templ, Tailwind CSS, shadcn-templ",
	"htmx, Datastar, SvelteKit or Headless",
	"SQLite or PostgreSQL",
	"Stripe or Polar billing",
	"Workspaces, roles, invitations",
	"Admin panel and impersonation",
	"Google and GitHub OAuth",
	"JSON API, API tokens, MCP",
	"S3 storage, blog and docs",
	"Tests, CI, Docker, Sentry",
	"Stack aware AGENTS.md",
	"Every future release",
}

