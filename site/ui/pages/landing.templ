package pages

import (
	"github.com/axadrn/goilerplate/v4/site/brand"
	"github.com/axadrn/goilerplate/v4/site/ui/blocks"
	"github.com/axadrn/goilerplate/v4/site/ui/components/accordion"
	"github.com/axadrn/goilerplate/v4/site/ui/components/badge"
	"github.com/axadrn/goilerplate/v4/site/ui/components/button"
	"github.com/axadrn/goilerplate/v4/site/ui/components/card"
	"github.com/axadrn/goilerplate/v4/site/ui/components/icon"
	"github.com/axadrn/goilerplate/v4/site/ui/layouts"
	"github.com/axadrn/goilerplate/v4/site/ui/utils"
)

const (
	homeWrap = "mx-auto w-full max-w-[1240px] px-4 sm:px-8"
	// The type scale of the home page: five sizes, two weights.
	typeH1     = "font-semibold tracking-[-0.045em] leading-[1.02] text-[clamp(2.6rem,6vw,4.5rem)] text-balance"
	typeH2     = "font-semibold tracking-[-0.04em] leading-[1.05] text-[clamp(2rem,4.5vw,3.25rem)] text-balance"
	typeH3     = "text-xl font-semibold tracking-[-0.02em]"
	typeLead   = "text-lg leading-8 text-muted-foreground"
	typeText   = "text-base leading-7 text-muted-foreground"
	typeNumber = "font-semibold tracking-[-0.04em] text-5xl tabular-nums"
	// homeSurface is a grouped surface: the card gray, no border, no shadow.
	homeSurface = "gap-0 py-0 text-base rounded-4xl bg-card shadow-none ring-0"
	// homeSection is the one gap between the sections of the home page.
	homeSection = "mt-28 sm:mt-36"
	// homeAnchor keeps the sticky navbar off a heading a link jumps to.
	homeAnchor = "scroll-mt-24 sm:scroll-mt-28"
	// homeLink is a link inside running text.
	homeLink = "text-foreground underline underline-offset-4"
	// homeDisplay and homeLead are the page titles of the changelog, the
	// builder and the legal pages.
	homeDisplay = "font-display leading-[0.95]"
	homeLead    = "text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9"
)

templ Landing() {
	@layouts.Home(layouts.SEOProps{
		Title:       "The Go SaaS starter kit, free and open source",
		Description: "Login, Stripe billing, teams, admin, API and tests. Already built in Go, already tested, free and open source, and every line yours.",
		Path:        "/",
	}) {
		<main>
			@homeHero()
			@homeInside()
			@homeAI()
			@homeFree()
			@homeOps()
			@homeFAQ()
			@homeStart()
		</main>
		@homeCopyScript()
	}
}

// homePrimary is the one main button of the page.
templ homePrimary(class string) {
	@button.Button(button.Props{Href: "/docs/installation", Size: button.SizeLg, Class: utils.CN("gap-2", class)}) {
		Get started
		@icon.ArrowRight(icon.Props{Class: "size-4"})
	}
}

// ---------------------------------------------------------------- hero
templ homeHero() {
	<section class="pt-16 sm:pt-28">
		<div class={ homeWrap, "grid grid-cols-1 items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-16" }>
			<div>
				@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "h-auto rounded-full px-3 py-1 text-sm font-medium text-muted-foreground"}) {
					Go, templ, Tailwind CSS and shadcn-templ.
				}
				<h1 class={ typeH1, "mt-6" }>
					<span class="block">Your SaaS.</span>
					<span class="block text-live">Without the boring part.</span>
				</h1>
				<p class={ typeLead, "mt-7 max-w-[34rem] sm:mt-9 sm:text-xl sm:leading-9" }>
					Login, billing, teams, admin, an API and tests. Built in Go, tested, and every line is yours.
				</p>
				<ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-base font-medium">
					@heroProof("Free and open source")
					@heroProof("No account")
					@heroProof("Updates with Git")
				</ul>
				<div class="mt-9 flex flex-col gap-3 sm:flex-row">
					@homePrimary("")
					@button.Button(button.Props{Href: "/docs", Variant: button.VariantSecondary, Size: button.SizeLg}) {
						Read the docs
					}
				</div>
			</div>
			@homeTerminal()
		</div>
	</section>
}

// heroProof is one promise under the hero, with a check.
templ heroProof(text string) {
	<li class="inline-flex items-center gap-2">
		<span class="flex size-5 items-center justify-center rounded-full bg-live text-background">
			@icon.Check(icon.Props{Class: "size-3 stroke-3"})
		</span>
		{ text }
	</li>
}

// homeTerminal is the whole start: install, generate, run. The button in
// its title bar copies the install command.
templ homeTerminal() {
	<div class="ops-term min-w-0 overflow-hidden rounded-4xl bg-terminal text-sm leading-[1.75] text-terminal-foreground" aria-label="A terminal session with goilerplate" data-copy-root>
		<div class="flex items-center gap-2 border-b border-terminal-foreground/10 py-2 pr-2 pl-5">
			<span class="size-3 rounded-full bg-terminal-foreground/20"></span>
			<span class="size-3 rounded-full bg-terminal-foreground/20"></span>
			<span class="size-3 rounded-full bg-terminal-foreground/20"></span>
			<span class="ml-3 text-xs text-terminal-foreground/50">~/dev</span>
			@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Class: "ml-auto gap-2 font-sans text-terminal-foreground/70 hover:bg-terminal-foreground/10 hover:text-terminal-foreground dark:hover:bg-terminal-foreground/10 dark:hover:text-terminal-foreground", Attributes: templ.Attributes{"data-copy": true}}) {
				<span data-copy-icon>
					@icon.Copy(icon.Props{Class: "size-4"})
				</span>
				<span data-copy-check class="hidden">
					@icon.Check(icon.Props{Class: "size-4"})
				</span>
				Copy install
			}
		</div>
		<div class="overflow-x-auto px-5 py-5 whitespace-pre sm:px-6">
			<p><span class="text-terminal-foreground/45">$ </span><span data-copy-text>{ brand.Install }</span></p>
			<p class="mt-4"><span class="text-terminal-foreground/45">$ </span>goilerplate new --name Acme --module example.com/acme \</p>
			<p>{ "    --framework htmx --database postgres --payment stripe \\" }</p>
			<p>{ "    --workspaces ./acme" }</p>
			<p class="text-live">✓ Created Acme in ./acme with v4.0.0</p>
			<p class="text-terminal-foreground/60">› Git is ready on main with an initial commit</p>
			<p class="mt-4"><span class="text-terminal-foreground/45">$ </span>cd acme && cp .env.example .env</p>
			<p><span class="text-terminal-foreground/45">$ </span>task dev</p>
		</div>
	</div>
}

templ homeCopyScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		document.addEventListener("click", async (event) => {
			const button = event.target.closest("[data-copy]");
			if (!button) return;
			const text = button.closest("[data-copy-root]")?.querySelector("[data-copy-text]");
			if (!text) return;
			try {
				await navigator.clipboard.writeText(text.textContent.trim());
				button.querySelector("[data-copy-icon]").classList.add("hidden");
				button.querySelector("[data-copy-check]").classList.remove("hidden");
				setTimeout(() => {
					button.querySelector("[data-copy-icon]").classList.remove("hidden");
					button.querySelector("[data-copy-check]").classList.add("hidden");
				}, 1600);
			} catch {}
		});
	</script>
}

// ---------------------------------------------------------------- inside
// homeInside is what every project has, and the choices that shape it.
templ homeInside() {
	<section id="product" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2, "max-w-[18ch]" }>Everything before your first customer.</h2>
			<p class={ typeLead, "mt-6 max-w-2xl" }>Built, tested and wired together. You start on the product.</p>
			<div class="mt-12 grid grid-cols-1 gap-3 sm:mt-16 sm:grid-cols-2 lg:grid-cols-3">
				@homeTile("Auth", "Passwords, magic links, Google and GitHub. Sessions you can revoke.")
				@homeTile("Billing", "Stripe or Polar. Subscriptions, trials, a customer portal and signed webhooks.")
				@homeTile("Teams", "Workspaces with roles, invitations and seat limits.")
				@homeTile("Admin", "Find users, see metrics, revoke sessions. Help as the user, read only.")
				@homeTile("API and MCP", "A JSON API with personal tokens. An MCP server for your customers' agents.")
				@homeTile("Production", "Tests, CI, a Dockerfile, Sentry and migrations.")
			</div>
			@card.Card(card.Props{Class: utils.CN(homeSurface, "mt-3 grid grid-cols-1 gap-10 p-7 sm:p-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16 lg:p-16")}) {
				<div>
					<h3 class={ typeH3 }>Your stack. Your choice.</h3>
					<p class={ typeText, "mt-3 max-w-md" }>
						Pick what you need. The rest stays out of your repo.
						<a href="/new" class={ homeLink }>Open the stack builder</a>
					</p>
				</div>
				<div class="grid gap-5 self-center">
					@homeChoice("Frontend", []string{"htmx 4.0", "Datastar 1.0", "SvelteKit", "Headless"})
					@homeChoice("Database", []string{"SQLite", "PostgreSQL"})
					@homeChoice("Payments", []string{"Stripe", "Polar"})
					@homeChoice("Email", []string{"SMTP", "Resend"})
				</div>
			}
		</div>
	</section>
}

templ homeTile(title, text string) {
	@card.Card(card.Props{Class: utils.CN(homeSurface, "block p-7 sm:p-8")}) {
		<h3 class={ typeH3 }>{ title }</h3>
		<p class={ typeText, "mt-2" }>{ text }</p>
	}
}

templ homeChoice(label string, options []string) {
	<div class="grid gap-2 sm:grid-cols-[7rem_minmax(0,1fr)] sm:items-center">
		<p class="text-sm text-muted-foreground">{ label }</p>
		<div class="flex flex-wrap gap-2">
			for _, option := range options {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "h-auto rounded-full px-3 py-1 text-sm font-medium"}) {
					{ option }
				}
			}
		</div>
	</div>
}

// ---------------------------------------------------------------- ai
templ homeAI() {
	<section id="ai" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2, "max-w-[20ch]" }>
				AI writes the easy 80%.
				<span class="text-muted-foreground">The last 20% costs you weeks.</span>
			</h2>
			<p class={ typeLead, "mt-6 max-w-2xl" }>
				Every project ships a stack aware <code class="font-mono text-foreground">AGENTS.md</code>. Claude, Cursor or Codex build on tested code, not on a new guess each session.
			</p>
			<div class="mt-12 grid grid-cols-1 gap-3 sm:mt-16 lg:grid-cols-3">
				@homeTile("Billing that holds up", "Retried webhooks, events out of order, failed renewals, seat changes. Solved once and tested.")
				@homeTile("Tenant isolation", "Every query scoped to the right workspace. The bug an agent writes quietly and a customer finds loudly.")
				@homeTile("Updates that keep coming", "Fixes like templ v0.3.1100 land in your project with goilerplate update. Your own code stays yours.")
			</div>
		</div>
	</section>
}

// ---------------------------------------------------------------- free
// homeFree is where a price would be: everything is in it, for free.
templ homeFree() {
	<section id="free" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2 }>Free. Everything in it.</h2>
			<p class={ typeLead, "mt-6 max-w-2xl" }>Every frontend, database, payment and mail provider. Every module.</p>
			<div class="mt-12 grid grid-cols-1 items-start gap-3 sm:mt-16 lg:grid-cols-2">
				@card.Card(card.Props{Class: utils.CN(homeSurface, "flex flex-col p-8 sm:p-10")}) {
					<div class="flex items-center justify-between gap-3">
						<h3 class={ typeH3 }>Everything</h3>
						@badge.Badge(badge.Props{Class: "h-auto rounded-full bg-live/15 px-3 py-1 text-sm font-medium text-live"}) {
							MIT and 0BSD
						}
					</div>
					<p class="mt-8 flex items-baseline gap-2">
						<span class={ typeNumber }>$0</span>
						<span class="text-base text-muted-foreground">/ forever</span>
					</p>
					<p class={ typeText, "mt-2" }>Unlimited projects. Every future release.</p>
					<div class="mt-8">
						@homePrimary("w-full")
					</div>
					<ul class="mt-8 grid grid-cols-1 gap-3 text-base sm:grid-cols-2">
						for _, feature := range homeFeatures {
							@homeCheck(feature)
						}
					</ul>
				}
				@card.Card(card.Props{Class: utils.CN(homeSurface, "block p-3 sm:p-4")}) {
					<div class="px-4 pt-5 pb-2 sm:px-6 sm:pt-6">
						<h3 class={ typeH3 }>Every feature</h3>
						<p class={ typeText, "mt-2" }>By area. Each module is yours to pick or leave out.</p>
					</div>
					@accordion.Accordion(accordion.Props{Multiple: true}) {
						for _, group := range homeFeatureGroups {
							@accordion.Item() {
								@homeTrigger(group.Title)
								@accordion.Content(accordion.ContentProps{Class: "pb-0"}) {
									<ul class="grid gap-3 px-4 pb-6 text-base text-muted-foreground sm:px-6">
										for _, feature := range group.Features {
											@homeCheck(feature)
										}
									</ul>
								}
							}
						}
					}
				}
			</div>
		</div>
	</section>
}

