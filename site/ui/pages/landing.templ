templ homeFeature(label string) {
	<li class="flex min-w-0 items-start gap-2.5">
		@icon.Check(icon.Props{Class: "mt-1 size-4 shrink-0 text-live"})
		<span>{ label }</span>
	</li>
}

templ homeTerm(label, value string) {
	<div>
		<p class="text-sm text-muted-foreground">{ label }</p>
		<p class="mt-1 font-semibold">{ value }</p>
	</div>
}

// ---------------------------------------------------------------- ops
templ homeOps() {
	<section id="ops" class={ homeSection }>
		<div class={ homeWrap }>
			@card.Card() {
				@card.Content(card.ContentProps{Class: "grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:items-end"}) {
					<div>
						<p class="text-sm font-semibold text-muted-foreground">ops</p>
						<h2 class={ homeH2, "mt-4" }>Ship it. ops keeps it running.</h2>
						<p class={ homeLead, "mt-6 max-w-xl" }>Deploys, backups, updates and a database UI for your Go and SQLite app. On your own server, with no open ports and no SSH keys. Open source too.</p>
					</div>
					<div>
						@button.Button(button.Props{Href: blocks.OpsURL, Size: button.SizeLg}) {
							Visit ops
							@icon.ArrowRight()
						}
					</div>
				}
			}
		</div>
	</section>
}

// ---------------------------------------------------------------- founder
templ homeFounder() {
	<section id="shadcn-templ" class={ homeSection }>
		<div class={ homeWrap, "grid gap-10 md:grid-cols-[auto_minmax(0,1fr)] md:items-center md:gap-16" }>
			<a href="https://x.com/axadrn" target="_blank" rel="me noopener" aria-label="Axel Adrian on X" class="shrink-0">
				<img src="https://github.com/axadrn.png?size=320" alt="Axel Adrian" width="320" height="320" loading="lazy" class="size-32 rounded-4xl object-cover sm:size-40"/>
			</a>
			<div class="max-w-2xl">
				<h2 class="font-display text-[clamp(2.2rem,5vw,3.75rem)] leading-none text-balance">Built by the maker of shadcn-templ.</h2>
				<p class={ homeLead, "mt-5" }>I'm Axel. I maintain shadcn-templ, the Go port of shadcn/ui, and I run my own products on goilerplate. Every component in your project comes from the library I ship every week.</p>
				<div class="mt-6 flex flex-wrap items-center gap-2">
					@button.Button(button.Props{Href: blocks.ShadcnTemplURL, Target: "_blank", Variant: button.VariantSecondary, Attributes: templ.Attributes{"rel": "noopener"}}) {
						Explore shadcn-templ
						@icon.ArrowRight()
					}
					@button.Button(button.Props{Href: "https://x.com/axadrn", Target: "_blank", Variant: button.VariantGhost, Size: button.SizeIcon, Attributes: templ.Attributes{"rel": "me noopener", "aria-label": "Axel Adrian on X"}}) {
						@icons.X(16)
					}
					@button.Button(button.Props{Href: "https://github.com/axadrn", Target: "_blank", Variant: button.VariantGhost, Size: button.SizeIcon, Attributes: templ.Attributes{"rel": "me noopener", "aria-label": "Axel Adrian on GitHub"}}) {
						@icons.GitHub(18)
					}
				</div>
			</div>
		</div>
	</section>
}

// ---------------------------------------------------------------- faq
templ homeFAQ() {
	<section id="support" class={ homeSection }>
		<div class={ homeWrap, "grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16" }>
			<div>
				<h2 class="font-display text-[clamp(2.2rem,5vw,3.75rem)] leading-none">Short answers.</h2>
				<div class="mt-6">
					@button.Button(button.Props{Href: "/docs", Variant: button.VariantSecondary}) {
						Browse the docs
						@icon.ArrowRight()
					}
				</div>
			</div>
			@accordion.Accordion(accordion.Props{Multiple: true, Class: "rounded-4xl bg-card px-2 sm:px-4"}) {
				@homeQuestion("Is it really free?", "Yes. The CLI, the template and everything it generates are open source. There is no account, no license key and nothing to unlock.", "", "")
				@homeQuestion("Why use a starter kit if AI writes my code?", "Because the agent copies whatever it finds. On an empty folder it invents auth, billing, and architecture differently in every session. On goilerplate it extends a tested foundation, follows a stack aware AGENTS.md, and runs into tests when it breaks something.", "", "")
				@homeQuestion("Which coding agents does it work with?", "Any agent that reads your repository. AGENTS.md is plain Markdown in the project root, the code is ordinary Go, and the checks are go vet and go test.", "", "")
				@homeQuestion("Is this a framework?", "No. goilerplate generates an ordinary Go repository. There is no runtime dependency on the generator and no proprietary framework to learn.", "", "")
				@homeQuestion("Does goilerplate access my repository?", "No. goilerplate new renders the project on your machine. goilerplate update downloads the public template of your version from the Go module proxy, and Git merges it on your machine.", "", "")
				@homeQuestion("Can I use React, Svelte, or a mobile app?", "Yes. Pick SvelteKit for a static app on the JSON API built into the same Go binary, or Headless for React, a mobile app, or any other client. htmx and Datastar stay the recommendation for a server rendered app.", "/docs/features/json-api", "Read the JSON API docs")
				@homeQuestion("What do I need to get started?", "Go 1.26 or newer, Git, and Task, on macOS, Linux, or WSL. No account and no login.", "/docs/installation", "Follow the setup guide")
				@homeQuestion("Can I sell what I build with it?", "Yes. Generated projects are 0BSD and ship without a LICENSE file. They belong to you, with no notice or attribution to keep.", "", "")
				@homeQuestion("Are future updates included?", "Yes. goilerplate update brings every later template version into projects made with v4 or newer. Projects made with v3 keep working as they are.", "/docs/guides/updating", "Read how updates work")
				@homeQuestion("Where do I get help?", "On GitHub, in public, where the next person finds it too. Calls, custom development, and debugging application specific code are not included.", "/docs/support", "See what support covers")
			}
		</div>
	</section>
}

templ homeQuestion(question, answer, href, label string) {
	@accordion.Item() {
		@accordion.Trigger(accordion.TriggerProps{Class: "px-4 py-5 text-base font-semibold sm:px-5"}) {
			{ question }
		}
		@accordion.Content() {
			<div class="max-w-2xl px-4 pb-5 text-base leading-7 text-muted-foreground sm:px-5">
				<p>{ answer }</p>
				if href != "" {
					@button.Button(button.Props{Href: href, Variant: button.VariantLink, Class: "mt-2 px-0"}) {
						{ label }
						@icon.ArrowRight()
					}
				}
			</div>
		}
	}
}

// ---------------------------------------------------------------- final
templ homeFinal() {
	<section class="py-32 sm:py-44">
		<div class={ homeWrap }>
			<div class="rounded-4xl bg-foreground px-7 py-16 text-background sm:px-14 sm:py-24 lg:px-20">
				<h2 class="max-w-4xl font-display text-[clamp(2.8rem,8vw,6.5rem)] leading-[0.94]">Stop building login pages.</h2>
				<div class="mt-12 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
					<p class="max-w-md text-lg leading-8 text-background/65">Auth, billing, teams, admin and tests. Free and open source. Every line yours.</p>
					@button.Button(button.Props{Href: "/docs/installation", Variant: button.VariantSecondary, Size: button.SizeLg}) {
						Get started
						@icon.ArrowRight()
					}
				</div>
			</div>
		</div>
	</section>
}
