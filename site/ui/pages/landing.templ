// homeCheck is one line of a list, with a check.
templ homeCheck(text string) {
	<li class="flex min-w-0 items-start gap-3">
		<span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-live/15 text-live">
			@icon.Check(icon.Props{Class: "size-3 stroke-3"})
		</span>
		<span class="min-w-0">{ text }</span>
	</li>
}

// ---------------------------------------------------------------- ops
// homeOps is the way to production: ops, by the same maker, deploys a
// goilerplate app and backs up its SQLite database.
templ homeOps() {
	<section id="ops" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			@card.Card(card.Props{Class: utils.CN(homeSurface, "grid grid-cols-1 gap-10 p-7 sm:p-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16 lg:p-16")}) {
				<div>
					<h2 class={ typeH2 }>Ship it with ops.</h2>
					<p class={ typeLead, "mt-6 max-w-lg" }>
						<span class="text-foreground">Live with HTTPS on your own server.</span>
						Every change of your SQLite database goes to your bucket. Go back to any second.
					</p>
					<p class={ typeText, "mt-6" }>
						<a href={ templ.SafeURL(blocks.RefURL(blocks.OpsURL, "card")) } target="_blank" rel="noopener" class={ homeLink }>Try ops free</a>: 30 days, no card. Or <a href="/docs/guides/deploy-with-ops" class={ homeLink }>read the guide</a>.
					</p>
				</div>
				<div class="ops-term self-center overflow-x-auto rounded-3xl bg-terminal px-6 py-5 text-sm leading-6 whitespace-pre text-terminal-foreground" aria-label="Three commands that put a goilerplate app live with ops">
					<p class="text-terminal-foreground/45"># 1. install ops</p>
					<p><span class="text-terminal-foreground/45">$ </span>curl -fsSL https://ops.goilerplate.com/cli.sh | sh</p>
					<p class="mt-4 text-terminal-foreground/45"># 2. add your server</p>
					<p><span class="text-terminal-foreground/45">$ </span>ops servers add web-1</p>
					<p class="mt-4 text-terminal-foreground/45"># 3. deploy</p>
					<p><span class="text-terminal-foreground/45">$ </span>ops deploy</p>
					<p class="text-terminal-foreground/60">→ snapshot of /app/data/app.db: 20261102T091500Z-before-v2</p>
					<p class="text-live">✓ v2 of acme is live</p>
				</div>
			}
		</div>
	</section>
}

// ---------------------------------------------------------------- faq
templ homeFAQ() {
	<section id="support" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2 }>Questions.</h2>
			@accordion.Accordion(accordion.Props{Multiple: true, Class: "mt-10 rounded-4xl bg-card px-2 sm:px-4"}) {
				@homeQuestion("Is it really free?") {
					Yes. The CLI, the template and every project it makes are open source. No account, no license key, nothing to unlock.
				}
				@homeQuestion("What do I need?") {
					Go 1.26 or newer, Git and Task, on macOS, Linux or WSL. <a href="/docs/installation" class={ homeLink }>The setup guide</a>
				}
				@homeQuestion("Why a starter kit if AI writes my code?") {
					Agents copy what they find. In an empty folder they invent auth and billing anew every session. On goilerplate they extend tested code, follow <code class="font-mono">AGENTS.md</code> and hit tests when they break something.
				}
				@homeQuestion("Which coding agents does it work with?") {
					Any agent that reads your repository. <code class="font-mono">AGENTS.md</code> is plain Markdown, the code is plain Go, the checks are <code class="font-mono">go vet</code> and <code class="font-mono">go test</code>.
				}
				@homeQuestion("Is this a framework?") {
					No. You get an ordinary Go repository. Nothing depends on the generator at runtime, and there is no framework to learn.
				}
				@homeQuestion("Does goilerplate see my code?") {
					No. <code class="font-mono">goilerplate new</code> runs on your machine. <code class="font-mono">goilerplate update</code> downloads the public template from the Go module proxy, and Git merges it on your machine.
				}
				@homeQuestion("Can I use React, Svelte or a mobile app?") {
					Yes. SvelteKit gives you a static app on the JSON API, in the same Go binary. Headless fits React, a mobile app or any other client. For a server rendered app, pick htmx or Datastar. <a href="/docs/features/json-api" class={ homeLink }>The JSON API</a>
				}
				@homeQuestion("Can I sell what I build?") {
					Yes. The CLI is MIT. The template and your projects are 0BSD and ship without a LICENSE file. Use, change and sell them, with no notice to keep.
				}
				@homeQuestion("Are updates included?") {
					Yes. <code class="font-mono">goilerplate update</code> brings every later release into projects made with v4 or newer. Projects made with v3 keep working as they are. <a href="/docs/guides/updating" class={ homeLink }>How updates work</a>
				}
				@homeQuestion("Who builds it?") {
					<a href="https://x.com/axadrn" target="_blank" rel="me noopener" class={ homeLink }>Axel Adrian</a>. He maintains <a href={ templ.SafeURL(blocks.RefURL(blocks.ShadcnTemplURL, "faq")) } target="_blank" rel="noopener" class={ homeLink }>shadcn-templ</a>, the Go port of shadcn/ui, and every component in your project comes from it. He runs his own products on goilerplate and deploys them with ops.
				}
				@homeQuestion("Where do I get help?") {
					On GitHub, in public, so the next person finds it too. Calls, custom work and debugging your own code are not included. <a href="/docs/support" class={ homeLink }>What support covers</a>
				}
			}
		</div>
	</section>
}

// homeTrigger is the head of an accordion item: the text and a plus that
// turns into a cross when open.
templ homeTrigger(text string) {
	@accordion.Trigger(accordion.TriggerProps{Class: "items-center gap-6 rounded-none px-4 py-5 text-base font-semibold hover:no-underline sm:px-6 sm:py-6 **:data-[slot=accordion-trigger-icon]:hidden"}) {
		{ text }
		@icon.Plus(icon.Props{Class: "ml-auto size-5 shrink-0 text-muted-foreground transition-transform duration-200 group-aria-expanded/accordion-trigger:rotate-45"})
	}
}

templ homeQuestion(question string) {
	@accordion.Item() {
		@homeTrigger(question)
		@accordion.Content(accordion.ContentProps{Class: "pb-0"}) {
			<p class={ typeText, "max-w-2xl px-4 pb-6 sm:px-6" }>
				{ children... }
			</p>
		}
	}
}

// ---------------------------------------------------------------- start
// homeStart is the last call to action, after the questions.
templ homeStart() {
	<section id="start" class={ homeAnchor, homeSection, "pb-28 sm:pb-36" }>
		<div class={ homeWrap }>
			<h2 class={ typeH2, "max-w-[16ch]" }>Stop building login pages.</h2>
			<ol class="mt-12 grid grid-cols-1 gap-3 sm:mt-16 lg:grid-cols-3">
				@homeStep("1", "Install", "One go install, with Go 1.26 or newer.")
				@homeStep("2", "Generate", "goilerplate new asks what you need.")
				@homeStep("3", "Build", "task dev, and you work on your product.")
			</ol>
			<div class="mt-10 flex flex-col items-start gap-3">
				@homePrimary("")
				<p class="text-sm text-muted-foreground">Free and open source. No account.</p>
			</div>
		</div>
	</section>
}

templ homeStep(number, title, text string) {
	<li>
		@card.Card(card.Props{Class: utils.CN(homeSurface, "block h-full p-7 sm:p-8")}) {
			<span class="flex size-9 items-center justify-center rounded-full bg-foreground text-base font-semibold text-background">{ number }</span>
			<h3 class={ typeH3, "mt-6" }>{ title }</h3>
			<p class={ typeText, "mt-2" }>{ text }</p>
		}
	</li>
}
