package pages

import (
	"github.com/axadrn/goilerplate/v4/site/brand"
	"github.com/axadrn/goilerplate/v4/site/githubstars"
	"github.com/axadrn/goilerplate/v4/site/sitectx"
	"github.com/axadrn/goilerplate/v4/site/ui/blocks"
	"github.com/axadrn/goilerplate/v4/site/ui/components/accordion"
	"github.com/axadrn/goilerplate/v4/site/ui/components/badge"
	"github.com/axadrn/goilerplate/v4/site/ui/components/button"
	"github.com/axadrn/goilerplate/v4/site/ui/components/card"
	"github.com/axadrn/goilerplate/v4/site/ui/components/checkbox"
	"github.com/axadrn/goilerplate/v4/site/ui/components/field"
	"github.com/axadrn/goilerplate/v4/site/ui/components/icon"
	"github.com/axadrn/goilerplate/v4/site/ui/components/separator"
	"github.com/axadrn/goilerplate/v4/site/ui/components/tabs"
	"github.com/axadrn/goilerplate/v4/site/ui/layouts"
	"github.com/axadrn/goilerplate/v4/site/ui/utils"
)

const (
	homeWrap = "mx-auto w-full max-w-[1240px] px-4 sm:px-8"
	// The type scale of the home page: five sizes, two weights.
	typeH1   = "font-semibold tracking-[-0.045em] leading-[1.02] text-[clamp(2.6rem,6vw,4.5rem)] text-balance"
	typeH2   = "font-semibold tracking-[-0.04em] leading-[1.05] text-[clamp(2rem,4.5vw,3.25rem)] text-balance"
	typeH3   = "text-xl font-semibold tracking-[-0.02em]"
	typeLead = "text-lg leading-8 text-muted-foreground"
	typeText = "text-base leading-7 text-muted-foreground"
	// homeSurface is a grouped surface: the card gray, no border, no shadow.
	homeSurface = "gap-0 py-0 text-base rounded-4xl bg-card shadow-none ring-0"
	// homeSection is the one gap between the sections of the home page.
	homeSection = "mt-28 sm:mt-36"
	// homeAnchor keeps the sticky navbar off a heading a link jumps to.
	homeAnchor = "scroll-mt-24 sm:scroll-mt-28"
	// homeLink is a link inside running text.
	homeLink = "text-foreground underline underline-offset-4"
	// homeCode is a dark code panel.
	homeCode = "ops-term min-w-0 rounded-3xl bg-terminal text-sm leading-[1.75] text-terminal-foreground"
	// homeDisplay and homeLead are the page titles of the changelog, the
	// builder and the legal pages.
	homeDisplay = "font-display leading-[0.95]"
	homeLead    = "text-lg leading-8 text-muted-foreground sm:text-xl sm:leading-9"
)

// homeCommand is the goilerplate new command of the stack the hero picker
// starts with. configurator.js builds the same string when it changes.
const homeCommand = "goilerplate new --name Acme --module example.com/acme --framework htmx --database sqlite --payment stripe --mail smtp ./acme"

// Landing sells the kit: pick a stack, see what is done, see the code, see
// the proof, start.
templ Landing() {
	@layouts.Home(layouts.SEOProps{
		Title:       "The Go SaaS starter kit, free and open source",
		Description: "Pick htmx, Datastar or SvelteKit, SQLite or PostgreSQL, Stripe or Polar. Get a Go SaaS with login, billing, emails, teams and admin already built and tested. Free and open source.",
		Path:        "/",
	}) {
		<main>
			@homeHero()
			@homeDone()
			@homeRepo()
			@homeAgents()
			@homeProof()
			@homeFAQ()
			@homeStart()
		</main>
		<script src="/assets/js/configurator.js" defer></script>
		@homeScript()
	}
}

// homePrimary is the one main button of the page.
templ homePrimary(class string) {
	@button.Button(button.Props{Href: "/docs/installation", Size: button.SizeLg, Class: utils.CN("gap-2", class)}) {
		Get started
		@icon.ArrowRight(icon.Props{Class: "size-4"})
	}
}

// ---------------------------------------------------------------- hero
// homeHero is the pitch on the left and the stack picker on the right.
templ homeHero() {
	<section class="pt-14 sm:pt-24">
		<div class={ homeWrap, "grid grid-cols-1 items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-16" }>
			<div>
				<p class="text-sm font-medium text-muted-foreground">The Go SaaS starter kit</p>
				<h1 class={ typeH1, "mt-5" }>
					<span class="block">Pick your stack.</span>
					<span class="block text-muted-foreground">Skip to the product.</span>
				</h1>
				<p class={ typeLead, "mt-7 max-w-[34rem] sm:mt-9 sm:text-xl sm:leading-9" }>
					One command gives you a Go SaaS with login, billing, emails, teams and an admin panel. Already built, already tested. Tonight you write the part that is yours.
				</p>
				<ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-base font-medium">
					@heroProof("Free and open source")
					@heroProof("No account")
					@heroProof("Every line yours")
				</ul>
				<div class="mt-9 flex flex-col gap-3 sm:flex-row">
					@homePrimary("")
					@button.Button(button.Props{Href: "#code", Variant: button.VariantSecondary, Size: button.SizeLg}) {
						See the code
					}
				</div>
			</div>
			@homePicker()
		</div>
	</section>
}

// heroProof is one promise under the hero, with a check.
templ heroProof(text string) {
	<li class="inline-flex items-center gap-2">
		<span class="flex size-5 items-center justify-center rounded-full bg-live text-background">
			@icon.Check(icon.Props{Class: "size-3 stroke-3"})
		</span>
		{ text }
	</li>
}

type pickOption struct {
	Value, Label, Note string
}

// homePicker is the stack picker: one row of tabs per choice, a workspaces
// switch, and the command it writes. homeScript rebuilds the command with
// configurator.js, the same code as the stack builder.
templ homePicker() {
	<div id="home-picker" class="min-w-0 overflow-hidden rounded-4xl bg-card" data-copy-root>
		<div class="grid gap-6 p-6 sm:p-8">
			<div class="flex items-center justify-between gap-4">
				<p class={ typeH3 }>Your stack</p>
				<a href="/new" class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">Every option</a>
			</div>
			@pickAxis("framework", "Frontend", []pickOption{
				{"htmx", "htmx", "Server rendered pages with templ and htmx 4.0."},
				{"datastar", "Datastar", "Server rendered pages with templ and Datastar 1.0."},
				{"svelte", "SvelteKit", "A SvelteKit app on the JSON API, served by the Go binary."},
			})
			@pickAxis("database", "Database", []pickOption{
				{"sqlite", "SQLite", "One file next to your app. Nothing else to run."},
				{"postgres", "PostgreSQL", "For when you already run PostgreSQL."},
			})
			@pickAxis("payment", "Payments", []pickOption{
				{"stripe", "Stripe", "Checkout, subscriptions and the customer portal."},
				{"polar", "Polar", "A merchant of record that handles sales tax for you."},
			})
			@pickAxis("mail", "Email", []pickOption{
				{"smtp", "SMTP", "Any mail server you already have."},
				{"resend", "Resend", "Send through the Resend API."},
			})
			@field.Label(field.LabelProps{For: "home-workspaces"}) {
				@field.Field(field.Props{Orientation: field.OrientationHorizontal}) {
					@checkbox.Checkbox(checkbox.Props{ID: "home-workspaces", Name: "workspaces"})
					@field.Content() {
						@field.Title() {
							Workspaces
						}
						@field.Description() {
							Teams with roles, invitations, seats and billing per workspace.
						}
					}
				}
			}
		</div>
		<div class="bg-terminal text-terminal-foreground">
			<div class="flex items-center gap-2 border-b border-terminal-foreground/10 py-2 pr-2 pl-5 sm:pl-6">
				<span class="text-xs text-terminal-foreground/50">macOS · Linux · WSL</span>
				@copyButton("Copy commands")
			</div>
			<div class="ops-term px-5 py-5 text-sm leading-[1.75] text-terminal-foreground sm:px-6">
				<p class="break-words whitespace-pre-wrap"><span class="text-terminal-foreground/45">$ </span><span data-copy-text>{ brand.Install }</span></p>
				<p class="mt-3 break-words whitespace-pre-wrap"><span class="text-terminal-foreground/45">$ </span><span data-copy-text data-pick-command>{ homeCommand }</span></p>
				<p class="text-live">✓ Created Acme in ./acme</p>
				<p class="mt-3"><span class="text-terminal-foreground/45">$ </span>cd acme && task dev</p>
			</div>
		</div>
	</div>
}

// pickAxis is one choice of the picker: a label, the options as tabs, and
// a line on the option that is picked.
templ pickAxis(axis, label string, options []pickOption) {
	@tabs.Tabs(tabs.Props{DefaultValue: options[0].Value, Class: "gap-1.5", Attributes: templ.Attributes{"data-pick": axis}}) {
		<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
			<p class="text-sm font-medium">{ label }</p>
			@tabs.List(tabs.ListProps{Attributes: templ.Attributes{"aria-label": label}}) {
				for _, option := range options {
					@tabs.Trigger(tabs.TriggerProps{Value: option.Value}) {
						{ option.Label }
					}
				}
			}
		</div>
		for _, option := range options {
			@tabs.Content(tabs.ContentProps{Value: option.Value, Class: "text-sm leading-6 text-muted-foreground"}) {
				{ option.Note }
			}
		}
	}
}

// copyButton copies every data-copy-text of its data-copy-root, one per line.
templ copyButton(label string) {
	@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Class: "ml-auto shrink-0 gap-2 font-sans text-terminal-foreground/70 hover:bg-terminal-foreground/10 hover:text-terminal-foreground dark:hover:bg-terminal-foreground/10 dark:hover:text-terminal-foreground", Attributes: templ.Attributes{"data-copy": true}}) {
		<span data-copy-icon>
			@icon.Copy(icon.Props{Class: "size-4"})
		</span>
		<span data-copy-check class="hidden">
			@icon.Check(icon.Props{Class: "size-4"})
		</span>
		{ label }
	}
}

templ homeScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		document.addEventListener("click", async (event) => {
			const button = event.target.closest("[data-copy]");
			if (!button) return;
			const root = button.closest("[data-copy-root]");
			if (!root) return;
			const text = [...root.querySelectorAll("[data-copy-text]")].map((el) => el.textContent.trim()).join("\n");
			try {
				await navigator.clipboard.writeText(text);
				button.querySelector("[data-copy-icon]").classList.add("hidden");
				button.querySelector("[data-copy-check]").classList.remove("hidden");
				setTimeout(() => {
					button.querySelector("[data-copy-icon]").classList.remove("hidden");
					button.querySelector("[data-copy-check]").classList.add("hidden");
				}, 1600);
			} catch {}
		});

		(() => {
			const picker = document.getElementById("home-picker");
			if (!picker) return;
			const command = picker.querySelector("[data-pick-command]");
			const state = {
				name: "Acme", module: "example.com/acme", destination: "./acme",
				framework: "htmx", database: "sqlite", payment: "stripe", mail: "smtp",
				api: false, mcp: false, workspaces: false, oauth: [], storage: false, content: [],
			};
			const render = () => {
				const builder = window.GoilerplateConfigurator;
				if (builder) command.textContent = builder.buildCommand(state);
			};
			picker.addEventListener("tabs-value-change", (event) => {
				const axis = event.target.closest("[data-pick]")?.dataset.pick;
				if (!axis) return;
				state[axis] = event.detail.value;
				render();
			});
			picker.addEventListener("change", (event) => {
				if (event.target.id !== "home-workspaces") return;
				state.workspaces = event.target.checked;
				render();
			});
		})();
	</script>
}

// ---------------------------------------------------------------- done
// homeDone is the list of the parts every SaaS needs, each already done.
templ homeDone() {
	<section id="done" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2, "max-w-[20ch]" }>Auth, billing, emails, admin. Done.</h2>
			<p class={ typeLead, "mt-6 max-w-2xl" }>The parts every SaaS needs and no customer pays for. Built once, tested, and wired together before you open the editor.</p>
			@card.Card(card.Props{Class: utils.CN(homeSurface, "mt-12 block px-6 sm:mt-16 sm:px-10")}) {
				<ul>
					for i, part := range homeParts {
						if i > 0 {
							@separator.Separator()
						}
						<li class="grid grid-cols-1 gap-2 py-6 sm:grid-cols-[12rem_minmax(0,1fr)_auto] sm:items-baseline sm:gap-8 sm:py-7">
							<h3 class="text-lg font-semibold tracking-[-0.02em]">{ part.Title }</h3>
							<p class={ typeText }>{ part.Text }</p>
							<div class="order-first sm:order-none">
								if part.Optional {
									@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "h-auto rounded-full px-3 py-0.5 text-sm font-medium text-muted-foreground"}) {
										If you pick it
									}
								} else {
									@badge.Badge(badge.Props{Class: "h-auto gap-1.5 rounded-full bg-live/15 px-3 py-0.5 text-sm font-medium text-live"}) {
										@icon.Check(icon.Props{Class: "size-3.5 stroke-3"})
										Done
									}
								}
							</div>
						</li>
					}
				</ul>
			}
		</div>
	</section>
}

type homePart struct {
	Title, Text string
	Optional    bool
}

var homeParts = []homePart{
	{"Sign in", "Passwords, magic links, email verification and password resets. Sessions live in your database, so you can revoke them.", false},
	{"Billing", "Stripe or Polar. Hosted checkout, monthly and yearly plans, trials and a customer portal. Signed webhooks, and an older event never overwrites a newer one.", false},
	{"Plans and limits", "Free, Pro and Enterprise in one catalog. Feature gates and limits, checked in the same transaction as the write.", false},
	{"Emails", "Welcome, magic link, password reset and email change, through SMTP or Resend.", false},
	{"Admin", "Find users, see the numbers, revoke sessions. Look at an account as the user, read only.", false},
	{"Production", "Migrations, security headers, CSRF, rate limits, structured logs, Sentry, a Dockerfile and CI.", false},
	{"Teams", "Workspaces with Owner, Admin and Member roles, invitations and seat limits.", true},
	{"Google and GitHub", "Sign in with OAuth next to passwords and magic links.", true},
	{"API and MCP", "A JSON API with personal tokens, and an MCP server so your users' agents can work in your app.", true},
	{"Blog, docs, uploads", "Markdown blog and docs, and S3 compatible file storage.", true},
}

// ---------------------------------------------------------------- repo
// homeRepo shows what lands on disk: the tree, the agent rules, the tests.
templ homeRepo() {
	<section id="code" class={ homeAnchor, homeSection }>
		<div class={ homeWrap, "grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16" }>
			<div>
				<h2 class={ typeH2, "max-w-[14ch]" }>It's just a Go repo.</h2>
				<p class={ typeLead, "mt-6 max-w-lg" }>Handlers, services, repositories and raw SQL. No framework to learn, and nothing at runtime depends on goilerplate.</p>
				<ul class="mt-10 grid gap-6">
					@homeFact("Only what you picked", "A Stripe project has no Polar code. A SQLite project has no PostgreSQL driver.")
					@homeFact("Yours to change", "Every file is plain source in your repository, with Git and a first commit ready.")
					@homeFact("Rules for your agent", "AGENTS.md knows your exact stack and how the code is laid out.")
				</ul>
			</div>
			@card.Card(card.Props{Class: utils.CN(homeSurface, "block min-w-0 p-3 sm:p-4")}) {
				@tabs.Tabs(tabs.Props{DefaultValue: "files", Class: "gap-3"}) {
					<div class="px-2 pt-2 sm:px-3">
						@tabs.List(tabs.ListProps{Attributes: templ.Attributes{"aria-label": "The generated project"}}) {
							@tabs.Trigger(tabs.TriggerProps{Value: "files"}) {
								Files
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "agents"}) {
								AGENTS.md
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "tests"}) {
								Tests
							}
						}
					</div>
					@tabs.Content(tabs.ContentProps{Value: "files"}) {
						@homeCodePanel(homeTree)
					}
					@tabs.Content(tabs.ContentProps{Value: "agents"}) {
						@homeCodePanel(homeAgentsFile)
					}
					@tabs.Content(tabs.ContentProps{Value: "tests"}) {
						@homeCodePanel(homeTests)
					}
				}
			}
		</div>
	</section>
}

templ homeFact(title, text string) {
	<li>
		<h3 class="text-lg font-semibold tracking-[-0.02em]">{ title }</h3>
		<p class={ typeText, "mt-1" }>{ text }</p>
	</li>
}

// codeLine is one line of a code panel. Kind dims it ("dim"), greens it
// ("ok") or puts a prompt before it ("cmd").
type codeLine struct {
	Text, Kind string
}

templ homeCodePanel(lines []codeLine) {
	<div class={ homeCode, "overflow-x-auto px-5 py-5 whitespace-pre sm:px-6" }>
		for _, line := range lines {
			switch line.Kind {
				case "dim":
					<p class="text-terminal-foreground/50">{ line.Text }</p>
				case "ok":
					<p class="text-live">{ line.Text }</p>
				case "cmd":
					<p><span class="text-terminal-foreground/45">$ </span>{ line.Text }</p>
				default:
					<p>{ line.Text }</p>
			}
		}
	</div>
}

// homeTree is the real tree of a project made with htmx, SQLite, Stripe,
// Resend and workspaces, shortened.
var homeTree = []codeLine{
	{"acme/", ""},
	{"├── AGENTS.md              rules for your coding agent", ""},
	{"├── Dockerfile", ""},
	{"├── Taskfile.yml           task dev", ""},
	{"├── goilerplate.lock       your stack, for updates", ""},
	{"├── .github/workflows/ci.yml", ""},
	{"├── cmd/server/main.go", ""},
	{"└── internal/", ""},
	{"    ├── access/            what each plan unlocks", ""},
	{"    ├── db/migrations/     001_initial_schema.sql", ""},
	{"    ├── handler/           auth.go  billing.go  admin.go", ""},
	{"    ├── middleware/        csrf.go  ratelimit.go", ""},
	{"    ├── repository/        raw SQL", ""},
	{"    ├── service/           subscription.go  workspace.go", ""},
	{"    │   ├── mailer/        resend.go", ""},
	{"    │   └── payment/       stripe.go", ""},
	{"    └── ui/                templ pages, shadcn-templ components", ""},
}

// homeAgentsFile is the start of AGENTS.md in that project.
var homeAgentsFile = []codeLine{
	{"## Stack", ""},
	{"", ""},
	{"- Go 1.26 with the standard library `net/http` router.", ""},
	{"- templ, htmx 4.0, vanilla JavaScript, and Tailwind CSS.", ""},
	{"- sqlx with raw SQL and SQLite.", ""},
	{"- Resend for transactional email.", ""},
	{"- Stripe for subscription billing.", ""},
	{"", ""},
	{"## House rules", ""},
	{"", ""},
	{"- Keep handlers thin. Put business rules in services", ""},
	{"  and SQL in repositories.", ""},
	{"- Enforce resource, seat, and quota increments in the", ""},
	{"  same database transaction as the protected write.", ""},
	{"- Never edit generated `*_templ.go` files.", ""},
	{"…", "dim"},
}

// homeTests is real output of go test in that project, shortened.
var homeTests = []codeLine{
	{"go test ./...", "cmd"},
	{"ok   example.com/acme/internal/access", "ok"},
	{"ok   example.com/acme/internal/handler", "ok"},
	{"ok   example.com/acme/internal/middleware", "ok"},
	{"ok   example.com/acme/internal/repository", "ok"},
	{"ok   example.com/acme/internal/service", "ok"},
	{"ok   example.com/acme/internal/service/payment", "ok"},
	{"…", "dim"},
	{"", ""},
	{"go test ./internal/service/payment -run Stripe -v", "cmd"},
	{"--- PASS: TestStripeStatusPreservesVisibleBillingStates", ""},
	{"--- PASS: TestStripeRejectsInvalidWebhookSignature", ""},
	{"--- PASS: TestStripeWebhookBindsCustomerToWorkspace", ""},
	{"ok   example.com/acme/internal/service/payment", "ok"},
}

// ---------------------------------------------------------------- agents
// homeAgents is the case for a kit when an agent writes the code.
templ homeAgents() {
	<section id="ai" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2, "max-w-[22ch]" }>
				Your agent writes a login page in a minute.
				<span class="text-muted-foreground">Billing is where it gets you.</span>
			</h2>
			<p class={ typeLead, "mt-6 max-w-2xl" }>Claude, Cursor or Codex start on code that already handles the hard cases, and the tests tell them when they break one.</p>
			<ol class="mt-12 grid grid-cols-1 gap-3 sm:mt-16 lg:grid-cols-3">
				@homeCase("01", "Webhooks out of order", "Stripe and Polar retry and reorder events. An older event never overwrites a newer state.")
				@homeCase("02", "Limits under load", "Two requests at once cannot pass a seat limit. The check runs in the same transaction as the write.")
				@homeCase("03", "The wrong tenant", "Workspace data is scoped by its workspace, and the member's role decides what they may do.")
			</ol>
		</div>
	</section>
}

templ homeCase(number, title, text string) {
	<li>
		@card.Card(card.Props{Class: utils.CN(homeSurface, "block h-full p-7 sm:p-8")}) {
			<span class="font-mono text-sm text-muted-foreground">{ number }</span>
			<h3 class={ typeH3, "mt-6" }>{ title }</h3>
			<p class={ typeText, "mt-2" }>{ text }</p>
		}
	</li>
}

// ---------------------------------------------------------------- proof
// homeProof is what anyone can check: stars, tests, licenses, releases.
templ homeProof() {
	<section id="proof" class={ homeAnchor, homeSection }>
		<div class={ homeWrap }>
			<h2 class={ typeH2 }>Out in the open.</h2>
			<p class={ typeLead, "mt-6 max-w-2xl" }>Read every line before you run it. The CLI, the template and this website live in one public repository.</p>
			<div class="mt-12 grid grid-cols-1 gap-3 sm:mt-16 sm:grid-cols-3">
				if stars := sitectx.Stars(ctx); stars > 0 {
					@homeStat(githubstars.Short(stars), "stars on GitHub", blocks.GitHubURL)
				} else {
					@homeStat("GitHub", "The whole source, in public", blocks.GitHubURL)
				}
				@homeStat("91+", "Go tests in the smallest project, over 300 with every module", "")
				@homeStat("$0", "MIT for the CLI, 0BSD for your project", "")
			</div>
			@card.Card(card.Props{Class: utils.CN(homeSurface, "mt-3 grid grid-cols-1 gap-10 p-7 sm:p-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16 lg:p-14")}) {
				<div>
					<h3 class={ typeH3 }>Fixes keep coming after day one.</h3>
					<p class={ typeText, "mt-3 max-w-md" }>
						<code class="font-mono text-foreground">goilerplate update</code> puts the next release on its own Git branch. You review it and merge it like any other branch. Your own code stays yours.
					</p>
					<p class={ typeText, "mt-4" }>
						<a href="/changelog" class={ homeLink }>Read the changelog</a>
					</p>
				</div>
				<div class={ homeCode, "self-center overflow-x-auto px-6 py-5 whitespace-pre" } aria-label="goilerplate update in a terminal">
					<p><span class="text-terminal-foreground/45">$ </span>goilerplate update</p>
					<p class="text-live">✓ Created goilerplate-update-v4.1.0</p>
					<p class="mt-3"><span class="text-terminal-foreground/45">$ </span>git switch goilerplate-update-v4.1.0</p>
					<p><span class="text-terminal-foreground/45">$ </span>git show --stat</p>
				</div>
			}
		</div>
	</section>
}

templ homeStat(number, label, href string) {
	@card.Card(card.Props{Class: utils.CN(homeSurface, "block p-7 sm:p-8")}) {
		<p class="text-5xl font-semibold tracking-[-0.04em] tabular-nums">
			if href != "" {
				<a href={ templ.SafeURL(href) } target="_blank" rel="noopener" class="hover:underline hover:underline-offset-8">{ number }</a>
			} else {
				{ number }
			}
		</p>
		<p class={ typeText, "mt-3" }>{ label }</p>
	}
}

// ---------------------------------------------------------------- faq
templ homeFAQ() {
	<section id="faq" class={ homeAnchor, homeSection }>
		<div class={ homeWrap, "grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-16" }>
			<div>
				<h2 class={ typeH2 }>Questions.</h2>
				<p class={ typeText, "mt-4 max-w-xs" }>
					More in <a href="/docs" class={ homeLink }>the docs</a>, or ask on <a href={ templ.SafeURL(blocks.GitHubURL) } target="_blank" rel="noopener" class={ homeLink }>GitHub</a>.
				</p>
			</div>
			@accordion.Accordion(accordion.Props{Multiple: true, Class: "min-w-0 rounded-4xl bg-card px-2 sm:px-4"}) {
				@homeQuestion("Is it really free?") {
					Yes. The CLI, the template and every project it makes are open source. No account, no license key, no paid tier.
				}
				@homeQuestion("Can I sell what I build?") {
					Yes. The CLI is MIT. The template and your projects are 0BSD and ship without a LICENSE file. Use, change and sell them, with no notice to keep.
				}
				@homeQuestion("Why a kit if AI writes my code?") {
					An agent in an empty folder invents auth and billing anew every session. On goilerplate it extends tested code, follows <code class="font-mono">AGENTS.md</code> and hits a failing test when it breaks something.
				}
				@homeQuestion("Is this a framework?") {
					No. You get an ordinary Go repository. Nothing depends on the generator at runtime.
				}
				@homeQuestion("What do I need?") {
					Go 1.26 or newer, Git and Task, on macOS, Linux or WSL. SvelteKit also needs Node.js 22.17 or newer and pnpm. <a href="/docs/installation" class={ homeLink }>The setup guide</a>
				}
				@homeQuestion("Who builds it?") {
					<a href="https://x.com/axadrn" target="_blank" rel="me noopener" class={ homeLink }>Axel Adrian</a>. He also maintains <a href={ templ.SafeURL(blocks.RefURL(blocks.ShadcnTemplURL, "faq")) } target="_blank" rel="noopener" class={ homeLink }>shadcn-templ</a>, the Go port of shadcn/ui that every component in your project comes from.
				}
			}
		</div>
	</section>
}

// homeTrigger is the head of an accordion item: the text and a plus that
// turns into a cross when open.
templ homeTrigger(text string) {
	@accordion.Trigger(accordion.TriggerProps{Class: "items-center gap-6 rounded-none px-4 py-5 text-base font-semibold hover:no-underline sm:px-6 sm:py-6 **:data-[slot=accordion-trigger-icon]:hidden"}) {
		{ text }
		@icon.Plus(icon.Props{Class: "ml-auto size-5 shrink-0 text-muted-foreground transition-transform duration-200 group-aria-expanded/accordion-trigger:rotate-45"})
	}
}

templ homeQuestion(question string) {
	@accordion.Item() {
		@homeTrigger(question)
		@accordion.Content(accordion.ContentProps{Class: "pb-0"}) {
			<p class={ typeText, "max-w-2xl px-4 pb-6 sm:px-6" }>
				{ children... }
			</p>
		}
	}
}

// ---------------------------------------------------------------- start
// homeStart is the last call to action: the install, the way in, and the
// one line on ops.
templ homeStart() {
	<section id="start" class={ homeAnchor, homeSection, "pb-28 sm:pb-36" }>
		<div class={ homeWrap, "flex flex-col items-center text-center" }>
			<h2 class={ typeH2, "max-w-[18ch]" }>Someone will ship your idea. Make it you.</h2>
			<p class={ typeLead, "mt-6 max-w-xl" }>Install the CLI, pick your stack, and start on the part only you can build.</p>
			<div class={ homeCode, "mt-10 flex w-full max-w-2xl items-center gap-2 py-2 pr-2 pl-5 text-left" } data-copy-root>
				<p class="min-w-0 flex-1 truncate"><span class="text-terminal-foreground/45">$ </span><span data-copy-text>{ brand.Install }</span></p>
				@copyButton("Copy")
			</div>
			<div class="mt-8 flex flex-col gap-3 sm:flex-row">
				@homePrimary("")
				@button.Button(button.Props{Href: "/new", Variant: button.VariantSecondary, Size: button.SizeLg}) {
					Open the stack builder
				}
			</div>
			<p class={ typeText, "mt-10" }>
				Ready to go live? <a href="/docs/guides/deploy-with-ops" class={ homeLink }>Deploy it with ops</a> on your own server.
			</p>
		</div>
	</section>
}
