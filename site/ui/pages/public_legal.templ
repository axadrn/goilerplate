package pages

import (
	"github.com/axadrn/goilerplate/v4/site/docs"
	"github.com/axadrn/goilerplate/v4/site/ui/blocks"
	"github.com/axadrn/goilerplate/v4/site/ui/layouts"
)

templ Legal(page *docs.LegalPage) {
	@layouts.Home(layouts.SEOProps{
		Title:       page.Title,
		Description: "Legal information and policies",
		Path:        "/legal/" + page.Slug,
	}) {
		<main class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
			<div class="grid gap-10 lg:grid-cols-[12rem_minmax(0,46rem)] lg:gap-16">
				<nav class="flex gap-1 overflow-x-auto text-sm lg:sticky lg:top-24 lg:flex-col lg:self-start" aria-label="Legal">
					@legalLink("privacy", "Privacy Policy", page.Slug)
				</nav>
				<article>
					<header class="mb-10 border-b pb-8">
												<h1 class="font-display text-[clamp(2.1rem,5vw,3.25rem)] leading-[1.02] tracking-[-0.03em]">{ page.Title }</h1>
						<p class="mt-4 font-mono text-[12.5px] text-muted-foreground">Last updated { page.LastUpdated }</p>
					</header>
					@blocks.Typeset(page.Content)
				</article>
			</div>
		</main>
	}
}

templ legalLink(slug, label, current string) {
	<a
		href={ templ.SafeURL("/legal/" + slug) }
		class={ "shrink-0 rounded-full px-4 py-2 transition-colors", templ.KV("bg-accent font-medium text-foreground", slug == current), templ.KV("text-muted-foreground hover:text-foreground", slug != current) }
	>{ label }</a>
}
