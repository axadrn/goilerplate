package pages

import (
	"github.com/axadrn/goilerplate/v4/site/docs"
	"github.com/axadrn/goilerplate/v4/site/ui/blocks"
	"github.com/axadrn/goilerplate/v4/site/ui/components/card"
	"github.com/axadrn/goilerplate/v4/site/ui/layouts"
)

templ Legal(page *docs.LegalPage) {
	@layouts.Home(layouts.SEOProps{
		Title:       page.Title,
		Description: "Legal information and policies",
		Path:        "/legal/" + page.Slug,
	}) {
		<main>
			<header class="pt-16 sm:pt-28">
				<div class={ homeWrap }>
					<h1 class={ homeDisplay, "text-[clamp(2.8rem,8vw,5.5rem)] text-balance" }>{ page.Title }</h1>
					<p class="mt-8 font-mono text-[13px] text-muted-foreground">Last updated { page.LastUpdated }</p>
				</div>
			</header>
			<section class="pt-12 pb-32 sm:pt-16 sm:pb-44">
				<div class={ homeWrap }>
					@card.Card() {
						@card.Content() {
							<article class="mx-auto min-w-0 max-w-3xl py-4 sm:py-8">
								@blocks.Typeset(page.Content)
							</article>
						}
					}
				</div>
			</section>
		</main>
	}
}
