package pages

import (
	"github.com/axadrn/goilerplate/v4/site/ui/blocks"
	"github.com/axadrn/goilerplate/v4/site/ui/components/card"
	"github.com/axadrn/goilerplate/v4/site/ui/layouts"
)

templ Changelog(htmlContent string) {
	@layouts.Home(layouts.SEOProps{Title: "Changelog", Description: "Product updates for goilerplate, newest first.", Path: "/changelog"}) {
		<main>
			<header class="pt-16 sm:pt-28">
				<div class={ homeWrap }>
					<h1 class={ homeDisplay, "text-[clamp(3rem,9vw,6rem)]" }>What shipped.</h1>
					<p class={ homeLead, "mt-8 max-w-2xl" }>Product updates, improvements, and fixes. Newest first.</p>
				</div>
			</header>
			<section class="pt-12 pb-32 sm:pt-16 sm:pb-44">
				<div class={ homeWrap }>
					@card.Card() {
						@card.Content() {
							<article class="changelog-typeset mx-auto min-w-0 max-w-3xl py-4 sm:py-8">
								@blocks.Typeset(htmlContent)
							</article>
						}
					}
				</div>
			</section>
		</main>
	}
}
