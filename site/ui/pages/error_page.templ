package pages

import (
	"github.com/axadrn/goilerplate/v4/site/ui/components/button"
	"github.com/axadrn/goilerplate/v4/site/ui/components/empty"
	"github.com/axadrn/goilerplate/v4/site/ui/components/icon"
	"github.com/axadrn/goilerplate/v4/site/ui/layouts"
)

// NotFound is the 404 page the server answers for every unknown path,
// built from the empty component: an icon, what happened in words, the
// way back and the code as a small log line.
templ NotFound() {
	@layouts.Home(layouts.SEOProps{Title: "Page not found", Description: "This page does not exist.", Path: "/404", NoIndex: true}) {
		<main class="flex min-h-[70svh] items-center justify-center px-5 py-20">
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.SearchX()
					}
					@empty.Title() {
						Page not found
					}
					@empty.Description() {
						The address does not exist or has moved.
					}
				}
				@empty.Content(empty.ContentProps{Class: "flex-row flex-wrap justify-center gap-2"}) {
					@button.Button(button.Props{Href: "/"}) {
						Back to goilerplate
					}
					@button.Button(button.Props{Href: "/docs", Variant: button.VariantOutline}) {
						Read the docs
					}
				}
				<p class="font-mono text-xs text-muted-foreground">404 Page not found</p>
			}
		</main>
	}
}
