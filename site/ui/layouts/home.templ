package layouts

import "github.com/axadrn/goilerplate/v4/site/ui/blocks"

templ Home(seo SEOProps) {
	@Base(seo) {
		<div class="min-h-svh bg-background">
			@blocks.Navbar()
			{ children... }
			@blocks.Footer()
		</div>
		@blocks.FloatingNews("moin-1", blocks.RefURL(blocks.MoinURL, "float"), "moin: deploy anything, lose nothing")
	}
}
