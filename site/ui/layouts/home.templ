package layouts

import "github.com/axadrn/goilerplate/v4/site/ui/blocks"

templ Home(seo SEOProps) {
	@Base(seo) {
		<div class="min-h-svh bg-background">
			@blocks.Navbar()
			{ children... }
			@blocks.Footer()
		</div>
		@blocks.FloatingNews("ops-1", blocks.RefURL(blocks.OpsURL, "float"), "ops is out")
	}
}
