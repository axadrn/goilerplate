package blocks

import (
	"github.com/axadrn/goilerplate/v4/site/brand"
	"github.com/axadrn/goilerplate/v4/site/githubstars"
	"github.com/axadrn/goilerplate/v4/site/sitectx"
	"github.com/axadrn/goilerplate/v4/site/ui/components/button"
	"github.com/axadrn/goilerplate/v4/site/ui/components/icon"
	"github.com/axadrn/goilerplate/v4/site/ui/components/sheet"
	"github.com/axadrn/goilerplate/v4/site/ui/icons"
	"github.com/axadrn/goilerplate/v4/site/ui/utils"
)

// GitHubURL is the open source repository of goilerplate.
const GitHubURL = "https://github.com/" + githubstars.Repo

// MoinURL is moin, which deploys and backs up the apps goilerplate makes.
const MoinURL = "https://moin.run"

// ShadcnTemplURL is the component library every page is built with.
const ShadcnTemplURL = "https://shadcn-templ.com"

// RefURL links another product of the same maker and tells it where on
// goilerplate.com the link sits, such as RefURL(MoinURL, "footer").
func RefURL(url, placement string) string {
	return url + "/?ref=goilerplate-" + placement
}

// navItem is one link of the main navigation.
type navItem struct {
	Href, Label string
}

var navItems = []navItem{
	{"/docs", "Docs"},
	{"/new", "Builder"},
	{"/changelog", "Changelog"},
}

// Navbar is the floating pill: the emblem and name on the left, the main
// links in the middle, GitHub, the theme and the way in on the right.
templ Navbar() {
	<header class="sticky top-0 z-50 px-3 pt-3 sm:px-6">
		<nav class="mx-auto flex h-14 max-w-[1240px] items-center justify-between gap-4 rounded-full border border-border bg-card/80 shadow-sm backdrop-blur-xl pr-2 pl-5 sm:h-16 sm:pl-7 lg:grid lg:grid-cols-[1fr_auto_1fr]" aria-label="Main">
			<a href="/" class="justify-self-start text-lg leading-none transition-opacity hover:opacity-75 sm:text-xl" aria-label={ brand.Name + " home" }>
				@Brand("navbar", "")
			</a>
			<div class="hidden items-center gap-0.5 lg:flex">
				for _, item := range navItems {
					@button.Button(button.Props{Href: item.Href, Variant: button.VariantGhost, Class: "text-muted-foreground"}) {
						{ item.Label }
					}
				}
			</div>
			<div class="flex items-center justify-self-end gap-1">
				@button.Button(button.Props{Href: GitHubURL, Target: "_blank", Variant: button.VariantGhost, Class: "hidden text-muted-foreground lg:inline-flex", Attributes: templ.Attributes{"rel": "noopener", "aria-label": brand.Name + " on GitHub"}}) {
					@icons.GitHub(18)
					if stars := sitectx.Stars(ctx); stars > 0 {
						<span class="tabular-nums">{ githubstars.Short(stars) }</span>
					}
				}
				<div class="hidden lg:block">
					@ThemeSwitcher(ThemeSwitcherProps{Class: "text-muted-foreground"})
				</div>
				@button.Button(button.Props{Href: "/docs/installation", Size: button.SizeLg, Class: "ml-1 hidden sm:inline-flex"}) {
					Get started
				}
				@sheet.Sheet(sheet.Props{ID: "mobile-nav"}) {
					@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconLg, Class: "lg:hidden", Attributes: utils.MergeAttributes(sheet.Trigger(ctx), templ.Attributes{"aria-label": "Open menu"})}) {
						@icon.Menu(icon.Props{Class: "size-5"})
					}
					@sheet.Content(sheet.ContentProps{Side: sheet.SideRight, Class: "w-full gap-0 sm:max-w-sm"}) {
						@MobileNav()
					}
				}
			</div>
		</nav>
	</header>
}

templ MobileLink(href, label string) {
	<a href={ templ.SafeURL(href) } class="flex items-center justify-between border-b py-4 text-lg font-medium tracking-tight text-foreground" { sheet.CloseFor("mobile-nav")... }>
		{ label }
		@icon.ArrowRight(icon.Props{Class: "size-4 text-muted-foreground"})
	</a>
}

templ MobileNav() {
	<div class="flex h-full flex-col">
		<div class="flex h-16 shrink-0 items-center border-b px-6 text-xl leading-none">
			@Brand("mobile-nav", "")
		</div>
		<div class="flex-1 overflow-y-auto px-6 pt-1">
			for _, item := range navItems {
				@MobileLink(item.Href, item.Label)
			}
			@MobileLink(GitHubURL, "GitHub")
		</div>
		<div class="space-y-2.5 border-t p-6">
			@button.Button(button.Props{Href: "/docs/installation", Size: button.SizeLg, Class: "flex w-full"}) {
				Get started
			}
			<div class="flex items-center justify-between pt-3">
				<span class="text-sm text-muted-foreground">Theme</span>
				@ThemeSwitcher()
			</div>
		</div>
	</div>
}
