package blocks

import (
	"github.com/axadrn/goilerplate/v4/site/ui/components/icon"
	"github.com/axadrn/goilerplate/v4/site/ui/components/item"
)

// makerProject is one of the three projects by the same maker.
type makerProject struct {
	Name, Text, Href string
}

var makerProjects = []makerProject{
	{"shadcn-templ", "The Go port of shadcn/ui", RefURL(ShadcnTemplURL, "maker")},
	{"goilerplate", "The Go SaaS starter, free and open source", "https://goilerplate.com"},
	{"ops", "Deploys and backups on your own server", RefURL(OpsURL, "maker")},
}

// MakerProjects links shadcn-templ, goilerplate and ops side by side.
templ MakerProjects(class string) {
	@item.Group(item.GroupProps{Class: "grid gap-3 sm:grid-cols-3 " + class}) {
		for _, p := range makerProjects {
			@item.Item(item.Props{Href: p.Href, Variant: item.VariantOutline, Class: "items-start"}) {
				@item.Content() {
					@item.Title() {
						{ p.Name }
					}
					@item.Description() {
						{ p.Text }
					}
				}
				@item.Actions() {
					@icon.ArrowUpRight(icon.Props{Class: "size-4 text-muted-foreground"})
				}
			}
		}
	}
}
