package blocks

import (
	"strconv"
	"time"

	"github.com/axadrn/goilerplate/v4/site/brand"
)

// Footer is the brand and one quiet line: support, the maker and
// the year, with the credit the gopher in the emblem needs. It lays out by
// its own width, not the viewport: in the docs it sits next to the sidebar.
templ Footer() {
	<footer class="@container border-t border-border">
		<div class="mx-auto w-full max-w-[1240px] px-4 py-10 sm:px-8">
			<div class="flex flex-col gap-6 @3xl:flex-row @3xl:items-center @3xl:justify-between">
				<a href="/" aria-label={ brand.Name + " home" } class="inline-flex w-fit text-xl leading-none">
					@Brand("footer", "")
				</a>
				<nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-muted-foreground" aria-label="Footer">
					@footerLink("/docs/support", "Support")
					<span>Built by <a href="https://x.com/axadrn" target="_blank" rel="me noopener" class="text-foreground underline-offset-4 transition-colors hover:underline">Axel Adrian</a></span>
					<span>© { strconv.Itoa(time.Now().Year()) } { brand.Name }</span>
				</nav>
			</div>
			<p class="mt-6 text-sm text-muted-foreground">
				Go Gopher by <a href="https://go.dev/blog/gopher" target="_blank" rel="noopener" class="underline-offset-4 transition-colors hover:text-foreground hover:underline">Renée French</a>, adapted under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="license noopener" class="underline-offset-4 transition-colors hover:text-foreground hover:underline">CC BY 4.0</a>.
			</p>
		</div>
	</footer>
}

templ footerLink(href, label string) {
	<a href={ templ.SafeURL(href) } class="transition-colors hover:text-foreground">{ label }</a>
}
