package checkbox

import (
	"github.com/axadrn/goilerplate/v4/site/ui/components/icon"
	"github.com/axadrn/goilerplate/v4/site/ui/utils"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Name       string
	Value      string
	Disabled   bool
	// Checked is the controlled checked state. Use DefaultChecked when the
	// browser should own the state after the initial render.
	Checked        *bool
	DefaultChecked bool
	ReadOnly       bool
	Required       bool
	// Indeterminate renders the mixed state (Base UI's indeterminate prop):
	// aria-checked="mixed", data-indeterminate and a visible indicator. A
	// user click leaves the mixed state like the native input does.
	Indeterminate bool
	Form          string
}

func initialChecked(p Props) bool {
	if p.Checked != nil {
		return *p.Checked
	}
	return p.DefaultChecked
}

// Checkbox is the vanilla port of Base UI's Checkbox.Root
// (checkbox/root/CheckboxRoot.tsx): a span root carries role="checkbox",
// aria-checked and the data-checked/data-unchecked/data-disabled state
// attributes the style CSS keys on, and a visually hidden native input
// rendered beside it carries id/name/value/form for label association and
// form submission. checkbox.js ports the runtime behavior.
templ Checkbox(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ checked := initialChecked(p) }}
	<span
		data-slot="checkbox"
		role="checkbox"
		if p.Indeterminate {
			aria-checked="mixed"
			data-indeterminate
		} else {
			if checked {
				aria-checked="true"
				data-checked
			} else {
				aria-checked="false"
				data-unchecked
			}
		}
		if p.Disabled {
			data-disabled
			aria-disabled="true"
			tabindex="-1"
		} else {
			tabindex="0"
		}
		aria-readonly?={ p.ReadOnly }
		aria-required?={ p.Required }
		data-templ-checked?={ p.Checked != nil }
		class={
			utils.CN(
				// 1:1 base/ui/checkbox.tsx: structure lives here, the look comes
				// from the active style-*.css via.
				"bg-input/90 data-checked:bg-primary data-checked:text-primary-foreground dark:data-checked:bg-primary data-checked:border-primary border-transparent aria-invalid:aria-checked:border-primary aria-invalid:border-destructive dark:aria-invalid:border-destructive/50 focus-visible:border-ring focus-visible:ring-ring/30 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 flex size-4 items-center justify-center rounded-[5px] border transition-shadow group-has-disabled/field:opacity-50 focus-visible:ring-3 aria-invalid:ring-3 group-has-[:focus-visible]/field-label:ring-0 group-has-[:focus-visible]/field-label:not-data-checked:border-transparent group-has-[:focus-visible]/field-label:data-checked:border-primary peer relative shrink-0 outline-none after:absolute after:-inset-x-3 after:-inset-y-2 disabled:cursor-not-allowed disabled:opacity-50",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		// Base UI unmounts the indicator while unchecked; our pendant toggles
		// the hidden attribute instead (same precedent as the context-menu
		// indicator), checkbox.js keeps it in sync.
		<span
			data-slot="checkbox-indicator"
			data-indeterminate?={ p.Indeterminate }
			data-checked?={ checked && !p.Indeterminate }
			data-unchecked?={ !checked && !p.Indeterminate }
			data-disabled?={ p.Disabled }
			if !checked && !p.Indeterminate {
				hidden
			}
			class="[&>svg]:size-3.5 grid place-content-center text-current transition-none"
		>
			@icon.Check()
		</span>
	</span>
	// Base UI renders the hidden input beside the root. It owns the id, so
	// native <label for> association keeps working; the inline styles are the
	// visuallyHiddenInput/visuallyHidden pendants from
	// @base-ui/utils/visuallyHidden.ts (named inputs stay absolute so native
	// validation popups anchor near the control).
	<input
		type="checkbox"
		aria-hidden="true"
		tabindex="-1"
		checked?={ checked }
		disabled?={ p.Disabled }
		readonly?={ p.ReadOnly }
		required?={ p.Required }
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Name != "" {
			name={ p.Name }
		}
		if p.Value != "" {
			value={ p.Value }
		}
		if p.Form != "" {
			form={ p.Form }
		}
		if p.Name != "" {
			style="clip-path:inset(50%);overflow:hidden;white-space:nowrap;border:0;padding:0;width:1px;height:1px;margin:-1px;position:absolute"
		} else {
			style="clip-path:inset(50%);overflow:hidden;white-space:nowrap;border:0;padding:0;width:1px;height:1px;margin:-1px;position:fixed;top:0;left:0"
		}
	/>
}
