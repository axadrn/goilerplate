package field

import (
	"context"
	"strconv"
	"strings"

	"github.com/axadrn/goilerplate/v4/site/ui/utils"
)

type Orientation string

const (
	OrientationVertical   Orientation = "vertical"
	OrientationHorizontal Orientation = "horizontal"
	OrientationResponsive Orientation = "responsive"
)

type LegendVariant string

const (
	LegendVariantLegend LegendVariant = "legend"
	LegendVariantLabel  LegendVariant = "label"
)

type SetProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type LegendProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    LegendVariant
}

type GroupProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type Props struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Orientation Orientation
}

type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type LabelProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	For        string
}

type TitleProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type DescriptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type SeparatorProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ErrorProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// 1:1 the fieldVariants cva from base/ui/field.tsx; the [data-slot=checkbox],
// [data-slot=radio] selectors are our pendants of the tsx [role=checkbox],
// [role=radio] ones, our items carry data-slot instead of a role.
func fieldClasses(o Orientation) string {
	switch o {
	case OrientationHorizontal:
		return "flex-row items-center has-[>[data-slot=field-content]]:items-start *:data-[slot=field-label]:flex-auto has-[>[data-slot=field-content]]:[&>[role=checkbox],[role=radio]]:mt-px has-[>[data-slot=field-content]]:[&>[data-slot=checkbox],[data-slot=radio]]:mt-px"
	case OrientationResponsive:
		return "flex-col *:w-full @md/field-group:flex-row @md/field-group:items-center @md/field-group:*:w-auto @md/field-group:has-[>[data-slot=field-content]]:items-start @md/field-group:*:data-[slot=field-label]:flex-auto [&>.sr-only]:w-auto @md/field-group:has-[>[data-slot=field-content]]:[&>[role=checkbox],[role=radio]]:mt-px @md/field-group:has-[>[data-slot=field-content]]:[&>[data-slot=checkbox],[data-slot=radio]]:mt-px"
	default:
		return "flex-col *:w-full [&>.sr-only]:w-auto"
	}
}

templ Set(props ...SetProps) {
	{{ var p SetProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<fieldset
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="field-set"
		class={ utils.CN("gap-6 has-[>[data-slot=checkbox-group]]:gap-3 has-[>[data-slot=radio-group]]:gap-3 flex flex-col", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</fieldset>
}

templ Legend(props ...LegendProps) {
	{{ var p LegendProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Variant == "" {
		{{ p.Variant = LegendVariantLegend }}
	}
	<legend
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="field-legend"
		data-variant={ string(p.Variant) }
		class={ utils.CN("mb-3 font-medium data-[variant=label]:text-sm data-[variant=legend]:text-base", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</legend>
}

templ Group(props ...GroupProps) {
	{{ var p GroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
		// Allow data-slot to be overridden (e.g. "checkbox-group") without
		// emitting a duplicate attribute, so the matching gap variants fire.
		slot := "field-group"
		attrs := templ.Attributes{}
		for k, v := range p.Attributes {
			if k == "data-slot" {
				if s, ok := v.(string); ok && s != "" {
					slot = s
				}
				continue
			}
			attrs[k] = v
		}
	}}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot={ slot }
		class={ utils.CN("gap-7 data-[slot=checkbox-group]:gap-3 *:data-[slot=field-group]:gap-4 group/field-group @container/field-group flex w-full flex-col", p.Class) }
		{ attrs... }
	>
		{ children... }
	</div>
}

templ Field(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Orientation == "" {
		{{ p.Orientation = OrientationVertical }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="group"
		data-slot="field"
		data-orientation={ string(p.Orientation) }
		class={ utils.CN("data-[invalid=true]:text-destructive gap-3 group/field flex w-full", fieldClasses(p.Orientation), p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="field-content"
		class={ utils.CN("gap-1 group/field-content flex flex-1 flex-col leading-snug", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Label(props ...LabelProps) {
	{{ var p LabelProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<label
		if p.ID != "" {
			id={ p.ID }
		}
		if p.For != "" {
			for={ p.For }
		}
		data-slot="field-label"
		class={
			utils.CN(
				// 1:1 base/ui/field.tsx FieldLabel: it composes Label, so the
				// base string comes first, then the field-label strings.
				"gap-2 text-sm leading-none font-medium group-data-[disabled=true]:opacity-50 peer-disabled:opacity-50 flex items-center select-none group-data-[disabled=true]:pointer-events-none peer-disabled:cursor-not-allowed",
				"has-data-checked:bg-input/30 gap-2 leading-snug group-data-[disabled=true]/field:opacity-50 has-[>[data-slot=field]]:rounded-2xl has-[>[data-slot=field]]:border has-[>[data-slot=field]]:not-has-[:disabled,[data-disabled]]:hover:bg-input/40 has-[>[data-slot=field]]:has-[:focus-visible]:border-ring has-[>[data-slot=field]]:has-[:focus-visible]:ring-ring/50 has-[>[data-slot=field]]:has-[:focus-visible]:ring-3 *:data-[slot=field]:p-4 group/field-label peer/field-label flex w-fit",
				"has-[>[data-slot=field]]:w-full has-[>[data-slot=field]]:flex-col",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</label>
}

templ Title(props ...TitleProps) {
	{{ var p TitleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="field-label"
		class={ utils.CN("gap-2 text-sm font-medium group-data-[disabled=true]/field:opacity-50 flex w-fit items-center", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Description(props ...DescriptionProps) {
	{{ var p DescriptionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<p
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="field-description"
		class={ utils.CN("text-muted-foreground text-left text-sm [[data-variant=legend]+&]:-mt-1.5 leading-normal font-normal group-has-data-horizontal/field:text-balance last:mt-0 nth-last-2:-mt-1 [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</p>
}

templ Separator(props ...SeparatorProps) {
	{{ var p SeparatorProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	// data-content and the content span only with children, like shadcn's.
	{{ content := childrenHTML(ctx) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="field-separator"
		data-content={ strconv.FormatBool(content != "") }
		class={ utils.CN("-my-2 h-5 text-sm group-data-[variant=outline]/field-group:-mb-2 relative", p.Class) }
		{ p.Attributes... }
	>
		<div
			data-slot="separator"
			data-orientation="horizontal"
			role="separator"
			aria-orientation="horizontal"
			class="shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch absolute inset-0 top-1/2"
		></div>
		if content != "" {
			<span
				class="text-muted-foreground px-2 relative mx-auto block w-fit bg-background"
				data-slot="field-separator-content"
			>
				@templ.Raw(content)
			</span>
		}
	</div>
}

templ Error(props ...ErrorProps) {
	{{ var p ErrorProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="alert"
		data-slot="field-error"
		class={ utils.CN("text-destructive text-sm font-normal", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// childrenHTML renders the children, "" without any: React's {children &&}.
func childrenHTML(ctx context.Context) string {
	var b strings.Builder
	_ = templ.GetChildren(ctx).Render(ctx, &b)
	return strings.TrimSpace(b.String())
}
