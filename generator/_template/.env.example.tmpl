# Runtime values for this generated build. Brand and architecture live in code.

# Application
# development is for localhost. production enables secure cookies and cached assets.
APP_ENV=development
{{- if .IsHeadless }}
# The URL of your frontend. Emails link to pages under APP_URL/auth{{ if .OAuth }}, and OAuth sign-in returns to APP_URL/app{{ end }}.
{{- else if .IsSvelte }}
# The public URL of this server. It serves the SvelteKit app and the JSON API on one origin.
# Emails link to app pages under APP_URL/auth{{ if .OAuth }}, and OAuth sign-in returns to APP_URL/app{{ end }}.
{{- end }}
APP_URL=http://localhost:8090
PORT=8090
SUPPORT_EMAIL=hello@example.com
# Comma-separated operator addresses. Sign up with each address and verify it before accessing the Admin panel.
ADMIN_EMAILS=operator@example.com

# Database
{{- if eq .Database "postgres" }}
DB_CONNECTION=postgres://goilerplate:dev_password@localhost:5432/goilerplate_dev?sslmode=disable
{{- else }}
DB_CONNECTION=./data/app.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)
{{- end }}

# Session and token expiry
SESSION_EXPIRY=168h
TOKEN_EMAIL_VERIFY_EXPIRY=24h
TOKEN_PASSWORD_RESET_EXPIRY=1h
TOKEN_EMAIL_CHANGE_EXPIRY=24h
TOKEN_MAGIC_LINK_EXPIRY=10m

# Keep empty unless a reverse proxy reaches the app through a private network.
# Set it so auth rate limits use the visitor IP without trusting fake proxy headers.
# Trust only that exact network. Never use 0.0.0.0/0 or ::/0.
# Docker: docker network inspect YOUR_NETWORK --format '{{"{{"}}(index .IPAM.Config 0).Subnet{{"}}"}}'
TRUSTED_PROXY_CIDRS=
{{- if .API }}

# JSON API
# Comma-separated browser origins that may call /api/ with cookies or a bearer token,
# for example https://app.example.com,http://localhost:5173. Exact matches only, no wildcards.
# Keep empty when the frontend is served from APP_URL or the clients are native apps.
CORS_ALLOWED_ORIGINS=
{{- if and .IsHeadless .OAuth }}

# Public URL of this server, for example https://api.example.com. Keep empty when APP_URL serves it.
# OAuth providers return to API_URL/auth/{provider}/callback, and sign-in then redirects to APP_URL/app.
# The OAuth session is a cookie, so APP_URL and API_URL must share a site, for example app.example.com and api.example.com.
API_URL=
{{- end }}
{{- end }}

{{- if and .OAuth (not .IsHeadless) }}

# Public URL of this server for OAuth callbacks. Keep empty to use APP_URL.
API_URL=
{{- end }}
{{- if .HasGoogleOAuth }}
# Google OAuth. Callback: {API_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
{{- end }}
{{- if .HasGitHubOAuth }}
# GitHub OAuth. Callback: {API_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
{{- end }}

# Email delivery is required in every environment.
EMAIL_FROM=noreply@example.com
{{- if eq .Mail "resend" }}
RESEND_API_KEY=
{{- if .HasBlog }}
# Optional. Without an Audience ID, newsletter signups stay in the local database.
RESEND_AUDIENCE_ID=
{{- end }}
{{- else }}
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls, tls, or none.
SMTP_TLS=starttls
{{- end }}

# Payments
{{- if eq .Payment "polar" }}
POLAR_API_KEY=polar_sk_xxxxxxxxxxxxx
POLAR_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
# Defaults to true in development and false in production.
# POLAR_SANDBOX_MODE=true
POLAR_PRODUCT_ID_PRO_MONTHLY=prod_xxxxxxxxxxxxx
POLAR_PRODUCT_ID_PRO_YEARLY=prod_xxxxxxxxxxxxx
POLAR_PRODUCT_ID_ENTERPRISE_MONTHLY=prod_xxxxxxxxxxxxx
POLAR_PRODUCT_ID_ENTERPRISE_YEARLY=prod_xxxxxxxxxxxxx
{{- else if eq .Payment "stripe" }}
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
STRIPE_PRICE_ID_PRO_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_PRO_YEARLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=price_xxxxxxxxxxxxx
STRIPE_PRICE_ID_ENTERPRISE_YEARLY=price_xxxxxxxxxxxxx
{{- end }}

{{- if .Storage }}
# S3-compatible storage. Cloudflare R2 and AWS S3 are supported.
S3_REGION=auto
S3_BUCKET=my-app-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PRESIGN_EXPIRY_PUBLIC=168h
# S3_PRESIGN_EXPIRY_PRIVATE=1h
{{- end }}

{{- if .HasHTMLFrontend }}

# Optional analytics and error tracking
UMAMI_WEBSITE_ID=
UMAMI_HOST=cloud.umami.is
PLAUSIBLE_DOMAIN=
PLAUSIBLE_HOST=plausible.io
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=

# Prevent indexing on staging or private preview deployments.
ROBOTS_NOINDEX=false
{{- else }}

# Optional error tracking
SENTRY_DSN=
{{- end }}

# Logging
LOG_LEVEL=
LOG_FORMAT=pretty
LOG_HTTP=true
