version: "3"

tasks:
{{- if .IsSvelte }}
{{- if eq .Database "postgres" }}
  db:
    desc: Start PostgreSQL and wait until it is ready
    cmds:
      - docker compose up --detach --wait postgres
{{- end }}
  dev:
    desc: Start the Go server and the SvelteKit dev server with hot reload
    vars:
      APP_PORT:
        sh: go run ./cmd/devport {{"{{if .APP_PORT}}-port '{{.APP_PORT}}'{{else}}-start 8090{{end}}"}}
      DEV_PORT:
        sh: go run ./cmd/devport {{"{{if .DEV_PORT}}-port '{{.DEV_PORT}}'{{else}}-start 5173{{end}}"}}
{{- if eq .Database "postgres" }}
    deps: [db]
{{- end }}
    cmds:
      - task: web:install
      - 'echo "Local: http://localhost:{{"{{.DEV_PORT}}"}} (Go server: localhost:{{"{{.APP_PORT}}"}})"'
      - task: dev:run
        vars:
          APP_PORT: '{{"{{.APP_PORT}}"}}'
          DEV_PORT: '{{"{{.DEV_PORT}}"}}'

  dev:run:
    internal: true
    deps:
      - task: dev:server
        vars:
          APP_PORT: '{{"{{.APP_PORT}}"}}'
          DEV_PORT: '{{"{{.DEV_PORT}}"}}'
      - task: dev:web
        vars:
          APP_PORT: '{{"{{.APP_PORT}}"}}'
          DEV_PORT: '{{"{{.DEV_PORT}}"}}'

  # Emails and OAuth link to the Vite origin, which forwards the server paths
  # to the Go server.
  dev:server:
    internal: true
    requires:
      vars: [APP_PORT, DEV_PORT]
    env:
      APP_URL: 'http://localhost:{{"{{.DEV_PORT}}"}}'
      PORT: '{{"{{.APP_PORT}}"}}'
    cmds:
      - go run ./cmd/server

  dev:web:
    internal: true
    requires:
      vars: [APP_PORT, DEV_PORT]
    dir: web
    env:
      GO_ORIGIN: 'http://localhost:{{"{{.APP_PORT}}"}}'
    cmds:
      - pnpm dev --port {{"{{.DEV_PORT}}"}} --strictPort

  web:install:
    internal: true
    dir: web
    status:
      - test -d node_modules
    cmds:
      - pnpm install --frozen-lockfile

  build:
    desc: Build the SvelteKit app and the server binary with the app embedded
    cmds:
      - pnpm --dir web install --frozen-lockfile
      - pnpm --dir web build
      - go build -o bin/server ./cmd/server

  check:
    desc: Check the SvelteKit app with svelte-check
    deps: [web:install]
    dir: web
    cmds:
      - pnpm check
{{- else if not .HasHTMLFrontend }}
{{- if eq .Database "postgres" }}
  db:
    desc: Start PostgreSQL and wait until it is ready
    cmds:
      - docker compose up --detach --wait postgres
{{- end }}
  dev:
    desc: Start the API server. Restart it after code changes.
    vars:
      APP_PORT:
        sh: go run ./cmd/devport {{"{{if .APP_PORT}}-port '{{.APP_PORT}}'{{else}}-start 8090{{end}}"}}
{{- if eq .Database "postgres" }}
    deps: [db]
{{- end }}
    env:
      PORT: '{{"{{.APP_PORT}}"}}'
    cmds:
      - 'echo "API: http://localhost:{{"{{.APP_PORT}}"}}/api/v1"'
      - go run ./cmd/server
{{- else }}
  templ:
    desc: Run templ with integrated server and hot reload
    requires:
      vars: [APP_PORT, DEV_PORT, OPEN_BROWSER]
    env:
      APP_URL: 'http://localhost:{{"{{.DEV_PORT}}"}}'
      PORT: '{{"{{.APP_PORT}}"}}'
    cmds:
      - go tool templ generate --watch --cmd="go run ./cmd/server/main.go" --proxy="http://localhost:{{"{{.APP_PORT}}"}}" --proxyport="{{"{{.DEV_PORT}}"}}" --open-browser="{{"{{.OPEN_BROWSER}}"}}"

  tailwind:
    desc: Watch Tailwind CSS changes
    cmds:
      - tailwindcss -i ./assets/css/globals.css -o ./assets/css/output.css --watch
{{- if eq .Database "postgres" }}
  db:
    desc: Start PostgreSQL and wait until it is ready
    cmds:
      - docker compose up --detach --wait postgres
{{- end }}
  dev:
    desc: Start development server with hot reload
    vars:
      APP_PORT:
        sh: go run ./cmd/devport {{"{{if .APP_PORT}}-port '{{.APP_PORT}}'{{else}}-start 8090{{end}}"}}
      DEV_PORT:
        sh: go run ./cmd/devport {{"{{if .DEV_PORT}}-port '{{.DEV_PORT}}'{{else}}-start 7331{{end}}"}}
      OPEN_BROWSER: '{{"{{.OPEN_BROWSER | default \"false\"}}"}}'
{{- if eq .Database "postgres" }}
    deps: [db]
{{- end }}
    cmds:
      - task: dev:info
        vars:
          APP_PORT: '{{"{{.APP_PORT}}"}}'
          DEV_PORT: '{{"{{.DEV_PORT}}"}}'
      - task: dev:run
        vars:
          APP_PORT: '{{"{{.APP_PORT}}"}}'
          DEV_PORT: '{{"{{.DEV_PORT}}"}}'
          OPEN_BROWSER: '{{"{{.OPEN_BROWSER}}"}}'

  dev:info:
    internal: true
    silent: true
    cmds:
      - 'echo "Local: http://localhost:{{"{{.DEV_PORT}}"}} (app: localhost:{{"{{.APP_PORT}}"}})"'

  dev:run:
    internal: true
    deps:
      - task: tailwind
      - task: templ
        vars:
          APP_PORT: '{{"{{.APP_PORT}}"}}'
          DEV_PORT: '{{"{{.DEV_PORT}}"}}'
          OPEN_BROWSER: '{{"{{.OPEN_BROWSER}}"}}'
{{- end }}
