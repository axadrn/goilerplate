package layouts

import (
	"strings"
	"{{.ModulePath}}/internal/model"
	"{{.ModulePath}}/internal/ui/components/avatar"
)

templ AppSidebarAvatarContent(user *model.User) {
	@avatar.Avatar(avatar.Props{Class: "size-8 rounded-lg"}) {
		if user.AvatarURL != "" {
			@avatar.Image(avatar.ImageProps{Src: user.AvatarURL, Alt: user.Name})
		}
		@avatar.Fallback() {
			{ strings.ToUpper(string(user.Name[0])) }
		}
	}
}
