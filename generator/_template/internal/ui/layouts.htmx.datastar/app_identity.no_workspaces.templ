package layouts

import (
	"{{.ModulePath}}/internal/brand"
	"{{.ModulePath}}/internal/ctxkeys"
	"{{.ModulePath}}/internal/ui/components/icon"
	"{{.ModulePath}}/internal/ui/components/sidebar"
)

templ AppSidebarIdentity() {
	@sidebar.MenuButton(sidebar.MenuButtonProps{Size: sidebar.MenuButtonSizeLg, Href: ctxkeys.AppBasePath(ctx) + "/dashboard"}) {
		@icon.LayoutDashboard()
		<div class="flex flex-col">
			<span class="text-sm font-bold">{ brand.Name }</span>
			<span class="text-xs text-muted-foreground">Application</span>
		</div>
	}
}
