package layouts

import (
	"{{.ModulePath}}/internal/ctxkeys"
	"{{.ModulePath}}/internal/model"
	dropdown "{{.ModulePath}}/internal/ui/components/dropdownmenu"
	"{{.ModulePath}}/internal/ui/components/icon"
)

templ AppSidebarAccountLinks() {
	{{ member := ctxkeys.WorkspaceMember(ctx) }}
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	@dropdown.Item(dropdown.ItemProps{Href: basePath + "/settings"}) {
		<span class="flex items-center">
			@icon.Settings(icon.Props{Class: "mr-2 size-4"})
			Settings
		</span>
	}
	if ctxkeys.IsAdmin(ctx) {
		@dropdown.Item(dropdown.ItemProps{Href: "/admin"}) {
			<span class="flex items-center">
				@icon.Shield(icon.Props{Class: "mr-2 size-4"})
				Admin
			</span>
		}
	}
	if member.Can(model.WorkspacePermissionManageBilling) {
		@dropdown.Item(dropdown.ItemProps{Href: basePath + "/billing"}) {
			<span class="flex items-center">
				@icon.CreditCard(icon.Props{Class: "mr-2 size-4"})
				Billing
			</span>
		}
	}
}
