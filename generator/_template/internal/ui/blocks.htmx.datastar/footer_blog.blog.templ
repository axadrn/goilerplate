package blocks

import (
	"strconv"

	"{{.ModulePath}}/internal/ui/components/alert"
	"{{.ModulePath}}/internal/ui/components/button"
	field "{{.ModulePath}}/internal/ui/components/field"
	"{{.ModulePath}}/internal/ui/components/icon"
	"{{.ModulePath}}/internal/ui/components/input"
	"{{.ModulePath}}/internal/ui/csrf"
)

templ FooterBlogLink() {
	<li>
		<a href="/blog" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
			Blog
		</a>
	</li>
}

templ FooterNewsletter() {
	@FooterNewsletterForm("")
}

templ FooterNewsletterSection() {
	<div class="border-t border-b" id="newsletter-section">
		<div class="container mx-auto px-4 py-12">
			<div class="mx-auto max-w-md text-center">
				<h3 class="text-2xl font-bold">Stay Updated</h3>
				<p class="mt-2 text-muted-foreground">
					Get the latest updates on new features and components.
				</p>
				{ children... }
				<p class="mt-3 text-xs text-muted-foreground">
					No spam, ever. Unsubscribe anytime.
				</p>
			</div>
		</div>
	</div>
}

templ FooterNewsletterSuccess() {
	@FooterNewsletterSection() {
		<div class="mt-6 text-left">
			@alert.Alert() {
				@icon.CircleCheck()
				@alert.Title() {
					Success
				}
				@alert.Description() {
					<p>Thank you for subscribing.</p>
				}
			}
		</div>
	}
}

templ FooterNewsletterFields(errorMsg string) {
	@csrf.Token()
	@field.Field(field.Props{Class: "flex-1 text-left"}) {
		@input.Input(input.Props{ID: "footer-newsletter", Name: "email", Type: "email", Placeholder: "your@email.com", Attributes: templ.Attributes{"aria-invalid": strconv.FormatBool(errorMsg != "")}})
		if errorMsg != "" {
			@field.Error() {
				{ errorMsg }
			}
		}
	}
	@button.Button(button.Props{Type: button.TypeSubmit}) {
		if errorMsg != "" {
			Try Again
		} else {
			Subscribe
		}
	}
}
