package pages

import (
	"strconv"

	"{{.ModulePath}}/internal/ui/components/button"
	"{{.ModulePath}}/internal/ui/components/field"
	"{{.ModulePath}}/internal/ui/components/input"
	"{{.ModulePath}}/internal/ui/csrf"
)

templ AuthPasswordForm(errorMsg string) {
	<form
		id="password-form"
		action="/auth/password"
		method="POST"
		hx-post="/auth/password"
		hx-target="#password-form"
		hx-swap="outerHTML"
		hx-disable="find button[type='submit']"
	>
		@csrf.Token()
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "email"}) {
					Email 
				}
				@input.Input(input.Props{ID: "email", Name: "email", Type: "email", Placeholder: "name@example.com", Attributes: templ.Attributes{"aria-invalid": strconv.FormatBool(errorMsg != ""), "autofocus": ""}})
				if errorMsg != "" {
					@field.Error() {
						{ errorMsg }
					}
				}
			}
			@field.Field() {
				<div class="flex items-center">
					@field.Label(field.LabelProps{For: "password"}) {
						Password 
					}
					<a href="/auth/forgot-password" class="ml-auto text-sm underline-offset-4 hover:underline">Forgot password?</a>
				</div>
				@input.Input(input.Props{ID: "password", Name: "password", Type: "password", Placeholder: "••••••••"})
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
				Sign in 
			}
		}
	</form>
}
