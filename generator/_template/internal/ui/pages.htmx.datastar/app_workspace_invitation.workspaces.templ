package pages

import (
	"{{.ModulePath}}/internal/brand"
	"{{.ModulePath}}/internal/ctxkeys"
	"{{.ModulePath}}/internal/model"
	"{{.ModulePath}}/internal/ui/components/button"
	"{{.ModulePath}}/internal/ui/components/card"
	"{{.ModulePath}}/internal/ui/components/icon"
	"{{.ModulePath}}/internal/ui/csrf"
	"{{.ModulePath}}/internal/ui/layouts"
)

templ WorkspaceInvitation(invitation *model.WorkspaceInvitation, errorMessage string) {
	{{ user := ctxkeys.User(ctx) }}
	@layouts.Auth(layouts.SEOProps{
		Title:       "Workspace invitation",
		Description: "Accept a workspace invitation",
		Path:        ctxkeys.URLPath(ctx),
	}) {
		<div class="flex min-h-screen items-center justify-center p-4">
			@card.Card(card.Props{Class: "w-full max-w-md"}) {
				@card.Header() {
					<div class="mb-3 flex size-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
						@icon.Users(icon.Props{Class: "size-5"})
					</div>
					@card.Title() {
						Workspace invitation
					}
					@card.Description() {
						if invitation != nil {
							{ invitation.InviterName } invited you to join { invitation.WorkspaceName } as { model.WorkspaceRoleLabel(invitation.Role) }.
						} else {
							This invitation is not available.
						}
					}
				}
				@card.Content() {
					if errorMessage != "" {
						<div class="mb-4 rounded-lg border border-destructive/30 bg-destructive/10 p-3 text-sm text-destructive">
							{ errorMessage }
						</div>
					}
					if invitation != nil && user != nil {
						<div class="mb-5 rounded-lg border bg-muted/40 p-4 text-sm">
							<p class="font-medium">Signed in as { user.Email }</p>
							<p class="mt-1 text-muted-foreground">This must match { invitation.Email }.</p>
						</div>
						<form
							action={ templ.SafeURL(ctxkeys.URLPath(ctx)) }
							method="POST"
						>
							@csrf.Token()
							@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
								Join { invitation.WorkspaceName }
							}
						</form>
					}
				}
				@card.Footer() {
					@button.Button(button.Props{Href: "/", Variant: button.VariantGhost, Class: "w-full"}) {
						Back to { brand.Name }
					}
				}
			}
		</div>
	}
}
