package pages

import (
	"{{.ModulePath}}/internal/access"
	"{{.ModulePath}}/internal/ctxkeys"
	"{{.ModulePath}}/internal/model"
	"{{.ModulePath}}/internal/ui/components/badge"
	"{{.ModulePath}}/internal/ui/components/button"
	"{{.ModulePath}}/internal/ui/components/card"
	"{{.ModulePath}}/internal/ui/components/dialog"
	field "{{.ModulePath}}/internal/ui/components/field"
	"{{.ModulePath}}/internal/ui/components/input"
	selectcomp "{{.ModulePath}}/internal/ui/components/select"
	"{{.ModulePath}}/internal/ui/csrf"
	"{{.ModulePath}}/internal/ui/layouts"
	"{{.ModulePath}}/internal/ui/utils"
	"fmt"
)

// workspaceRoleItems gives the role selects their labels, so the trigger
// shows "Admin" instead of the raw value.
var workspaceRoleItems = []selectcomp.ItemData{
	{Value: model.WorkspaceRoleOwner, Label: "Owner"},
	{Value: model.WorkspaceRoleAdmin, Label: "Admin"},
	{Value: model.WorkspaceRoleMember, Label: "Member"},
}

templ Workspace(members []model.WorkspaceMember, invitations []model.WorkspaceInvitation) {
	@layouts.App("Workspace") {
		@WorkspaceContent(members, invitations)
	}
}

templ WorkspaceContent(members []model.WorkspaceMember, invitations []model.WorkspaceInvitation) {
	{{ workspace := ctxkeys.Workspace(ctx) }}
	{{ viewer := ctxkeys.WorkspaceMember(ctx) }}
	{{ subscription := ctxkeys.Subscription(ctx) }}
	{{ seatLimit := subscription.Access().Limit(access.LimitMembers) }}
	{{ basePath := "/app/" + workspace.Slug }}
	<div id="workspace-content" class="container max-w-5xl space-y-6 px-6 py-8">
		<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<h1 class="text-3xl font-bold">Workspace</h1>
				<p class="mt-2 text-muted-foreground">Manage { workspace.Name }, its settings, members, and invitations.</p>
			</div>
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				{ fmt.Sprintf("%d of %d seats", len(members), seatLimit) }
			}
		</div>
		if viewer.Can(model.WorkspacePermissionManageWorkspace) {
			@card.Card() {
				@card.Header() {
					@card.Title() {
						General 
					}
					@card.Description() {
						The slug in workspace URLs stays stable when the name changes. 
					}
				}
				@card.Content() {
					<form
						action={ templ.SafeURL(basePath + "/workspace/name") }
						method="POST"
						class="flex flex-col gap-3 sm:flex-row sm:items-end"
						data-on:submit={ fmt.Sprintf("@post(%q, {contentType: 'form'})", basePath+"/workspace/name") }
						data-indicator:_workspace-action
						data-attr:inert="$_workspaceAction"
						data-attr:aria-busy="$_workspaceAction"
					>
						@csrf.Token()
						@field.Field(field.Props{Class: "flex-1"}) {
							@field.Label(field.LabelProps{For: "workspace-name"}) {
								Workspace name 
							}
							@input.Input(input.Props{ID: "workspace-name", Name: "name", Value: workspace.Name})
						}
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							Save 
						}
					</form>
				}
			}
		}
		if viewer.Can(model.WorkspacePermissionManageMembers) {
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Invite a team member 
					}
					@card.Description() {
						Invitations expire after seven days. Pending invitations do not consume seats. 
					}
				}
				@card.Content() {
					<form
						action={ templ.SafeURL(basePath + "/workspace/invitations") }
						method="POST"
						class="grid gap-3 sm:grid-cols-[1fr_10rem_auto] sm:items-end"
						data-on:submit={ fmt.Sprintf("@post(%q, {contentType: 'form'})", basePath+"/workspace/invitations") }
						data-indicator:_workspace-action
						data-attr:inert="$_workspaceAction"
						data-attr:aria-busy="$_workspaceAction"
					>
						@csrf.Token()
						@field.Field() {
							@field.Label(field.LabelProps{For: "invite-email"}) {
								Email 
							}
							@input.Input(input.Props{ID: "invite-email", Name: "email", Type: "email", Placeholder: "teammate@example.com"})
						}
						@field.Field() {
							@field.Label(field.LabelProps{For: "invite-role"}) {
								Role 
							}
							@selectcomp.Select(selectcomp.Props{Name: "role", DefaultValue: model.WorkspaceRoleMember, Items: workspaceRoleItems}) {
								@selectcomp.Trigger(selectcomp.TriggerProps{ID: "invite-role", Class: "w-full"}) {
									@selectcomp.Value()
								}
								@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart}) {
									@selectcomp.Item(selectcomp.ItemProps{Value: model.WorkspaceRoleMember}) {
										Member 
									}
									@selectcomp.Item(selectcomp.ItemProps{Value: model.WorkspaceRoleAdmin}) {
										Admin 
									}
								}
							}
						}
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							Send invite 
						}
					</form>
				}
			}
		}
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Members 
				}
				@card.Description() {
					Roles apply only inside this workspace. 
				}
			}
			@card.Content() {
				<div class="divide-y rounded-lg border">
					for _, member := range members {
						<div class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between">
							<div class="min-w-0">
								<p class="truncate font-medium">{ member.Name }</p>
								if member.Email != "" {
									<p class="truncate text-sm text-muted-foreground">{ member.Email }</p>
								}
							</div>
							<div class="flex flex-wrap items-center gap-2">
								if viewer.Can(model.WorkspacePermissionManageMembers) && (member.Role != model.WorkspaceRoleOwner || viewer.Can(model.WorkspacePermissionManageOwners)) {
									<form
										action={ templ.SafeURL(basePath + "/workspace/members/" + member.ID + "/role") }
										method="POST"
										class="flex items-center gap-2"
										data-on:submit={ fmt.Sprintf("@post(%q, {contentType: 'form'})", basePath+"/workspace/members/"+member.ID+"/role") }
										data-indicator:_workspace-action
										data-attr:inert="$_workspaceAction"
										data-attr:aria-busy="$_workspaceAction"
									>
										@csrf.Token()
										@selectcomp.Select(selectcomp.Props{Name: "role", DefaultValue: member.Role, Items: workspaceRoleItems}) {
											@selectcomp.Trigger(selectcomp.TriggerProps{Class: "w-32"}) {
												@selectcomp.Value()
											}
											@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart}) {
												if viewer.Can(model.WorkspacePermissionManageOwners) {
													@selectcomp.Item(selectcomp.ItemProps{Value: model.WorkspaceRoleOwner}) {
														Owner 
													}
												}
												@selectcomp.Item(selectcomp.ItemProps{Value: model.WorkspaceRoleAdmin}) {
													Admin 
												}
												@selectcomp.Item(selectcomp.ItemProps{Value: model.WorkspaceRoleMember}) {
													Member 
												}
											}
										}
										@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
											Save 
										}
									</form>
									<form
										action={ templ.SafeURL(basePath + "/workspace/members/" + member.ID + "/remove") }
										method="POST"
										data-on:submit={ fmt.Sprintf("@post(%q, {contentType: 'form'})", basePath+"/workspace/members/"+member.ID+"/remove") }
										data-indicator:_workspace-action
										data-attr:inert="$_workspaceAction"
										data-attr:aria-busy="$_workspaceAction"
									>
										@csrf.Token()
										@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
											Remove 
										}
									</form>
								} else {
									@badge.Badge() {
										{ model.WorkspaceRoleLabel(member.Role) }
									}
								}
							</div>
						</div>
					}
				</div>
			}
		}
		if viewer.Can(model.WorkspacePermissionManageMembers) && len(invitations) > 0 {
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Pending invitations 
					}
				}
				@card.Content() {
					<div class="divide-y rounded-lg border">
						for _, invitation := range invitations {
							<div class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between">
								<div>
									<p class="font-medium">{ invitation.Email }</p>
									<p class="text-sm text-muted-foreground">{ model.WorkspaceRoleLabel(invitation.Role) }, expires { invitation.ExpiresAt.Local().Format("Jan 2, 2006") }</p>
								</div>
								<div class="flex gap-2">
									<form
										action={ templ.SafeURL(basePath + "/workspace/invitations/" + invitation.ID + "/resend") }
										method="POST"
										data-on:submit={ fmt.Sprintf("@post(%q, {contentType: 'form'})", basePath+"/workspace/invitations/"+invitation.ID+"/resend") }
										data-indicator:_workspace-action
										data-attr:inert="$_workspaceAction"
										data-attr:aria-busy="$_workspaceAction"
									>
										@csrf.Token()
										@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
											Resend 
										}
									</form>
									<form
										action={ templ.SafeURL(basePath + "/workspace/invitations/" + invitation.ID + "/revoke") }
										method="POST"
										data-on:submit={ fmt.Sprintf("@post(%q, {contentType: 'form'})", basePath+"/workspace/invitations/"+invitation.ID+"/revoke") }
										data-indicator:_workspace-action
										data-attr:inert="$_workspaceAction"
										data-attr:aria-busy="$_workspaceAction"
									>
										@csrf.Token()
										@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm}) {
											Revoke 
										}
									</form>
								</div>
							</div>
						}
					</div>
				}
			}
		}
		@card.Card(card.Props{Class: "border-destructive/30"}) {
			@card.Header() {
				@card.Title() {
					Leave or delete workspace 
				}
				@card.Description() {
					The last Owner must transfer ownership or delete the workspace. 
				}
			}
			@card.Content() {
				<div class="flex flex-wrap gap-3">
					@dialog.Dialog(dialog.Props{ID: "leave-workspace-dialog"}) {
						@button.Button(button.Props{Type: "button", Variant: button.VariantOutline, Attributes: dialog.Trigger(ctx)}) {
							Leave workspace 
						}
						@dialog.Content() {
							@dialog.Header() {
								@dialog.Title() {
									Leave { workspace.Name }? 
								}
								@dialog.Description() {
									You will lose access to this workspace. A sole Owner must transfer ownership first. 
								}
							}
							@dialog.Footer() {
								@button.Button(button.Props{Type: "button", Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
									Cancel 
								}
								<form
									action={ templ.SafeURL(basePath + "/workspace/leave") }
									method="POST"
									data-on:submit={ fmt.Sprintf("@post(%q, {contentType: 'form'})", basePath+"/workspace/leave") }
									data-indicator:_workspace-action
									data-attr:inert="$_workspaceAction"
									data-attr:aria-busy="$_workspaceAction"
								>
									@csrf.Token()
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
										Leave workspace 
									}
								</form>
							}
						}
					}
					if viewer.Can(model.WorkspacePermissionDeleteWorkspace) {
						@dialog.Dialog(dialog.Props{ID: "delete-workspace-dialog"}) {
							@button.Button(button.Props{Type: "button", Variant: button.VariantDestructive, Attributes: dialog.Trigger(ctx)}) {
								Delete workspace 
							}
							@dialog.Content() {
								@dialog.Header() {
									@dialog.Title() {
										Permanently delete { workspace.Name }? 
									}
									@dialog.Description() {
										This deletes the workspace, members, invitations, audit history, and free subscription record. Pending checkouts must expire. Paid subscriptions must be cancelled and fully expired first. This cannot be undone. 
									}
								}
								@dialog.Footer() {
									@button.Button(button.Props{Type: "button", Variant: button.VariantOutline, Attributes: dialog.Close(ctx)}) {
										Cancel 
									}
									<form
										action={ templ.SafeURL(basePath + "/workspace/delete") }
										method="POST"
										data-on:submit={ fmt.Sprintf("@post(%q, {contentType: 'form'})", basePath+"/workspace/delete") }
										data-indicator:_workspace-action
										data-attr:inert="$_workspaceAction"
										data-attr:aria-busy="$_workspaceAction"
									>
										@csrf.Token()
										@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
											Delete permanently 
										}
									</form>
								}
							}
						}
					}
				</div>
			}
		}
	</div>
}
