package pages

import (
	"strconv"

	"{{.ModulePath}}/internal/brand"
	"{{.ModulePath}}/internal/ctxkeys"
	"{{.ModulePath}}/internal/ui/blocks"
	"{{.ModulePath}}/internal/ui/components/button"
	"{{.ModulePath}}/internal/ui/components/field"
	"{{.ModulePath}}/internal/ui/components/input"
	"{{.ModulePath}}/internal/ui/csrf"
	"{{.ModulePath}}/internal/ui/layouts"
)

templ AuthForgotPassword(errorMsg string) {
	@layouts.Auth(layouts.SEOProps{
		Title:       "Forgot Password",
		Description: "Reset your password",
		Path:        ctxkeys.URLPath(ctx),
	}) {
		@blocks.AuthShell(brand.Name) {
			@blocks.AuthCard("Forgot password?", "We'll email you a secure reset link") {
				@AuthForgotPasswordForm(errorMsg)
			}
		}
	}
}

templ AuthForgotPasswordForm(errorMsg string) {
	<form
		id="forgot-password-form"
		action="/auth/forgot-password"
		method="POST"
		hx-post="/auth/forgot-password"
		hx-target="#forgot-password-form"
		hx-swap="outerHTML"
		hx-disable="find button[type='submit']"
	>
		@csrf.Token()
		@field.Group() {
			@field.Field() {
				@field.Label(field.LabelProps{For: "email"}) {
					Email
				}
				@input.Input(input.Props{ID: "email", Name: "email", Type: "email", Placeholder: "you@example.com", Attributes: templ.Attributes{"aria-invalid": strconv.FormatBool(errorMsg != "")}})
				if errorMsg != "" {
					@field.Error() {
						{ errorMsg }
					}
				}
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
				Send reset link 
			}
			@button.Button(button.Props{Href: "/auth", Variant: button.VariantLink, Class: "w-full"}) {
				Back to sign in 
			}
		}
	</form>
}

templ AuthForgotPasswordSent(email string) {
	@layouts.Auth(layouts.SEOProps{
		Title:       "Check Your Email",
		Description: "Password reset link sent",
		Path:        ctxkeys.URLPath(ctx),
	}) {
		@blocks.AuthShell(brand.Name) {
			@blocks.AuthCard("Check your email", "We sent a reset link to "+email) {
				@field.Field() {
					@button.Button(button.Props{Href: "/auth", Variant: button.VariantOutline, Class: "w-full"}) {
						Back to sign in 
					}
				}
			}
		}
	}
}
