package pages

import (
	"{{.ModulePath}}/internal/ctxkeys"
	"{{.ModulePath}}/internal/ui/components/badge"
	"{{.ModulePath}}/internal/ui/components/button"
	"{{.ModulePath}}/internal/ui/components/card"
	"{{.ModulePath}}/internal/ui/components/dialog"
	field "{{.ModulePath}}/internal/ui/components/field"
	"{{.ModulePath}}/internal/ui/components/icon"
	"{{.ModulePath}}/internal/ui/components/input"
	selectcomp "{{.ModulePath}}/internal/ui/components/select"
	"{{.ModulePath}}/internal/ui/components/table"
	"{{.ModulePath}}/internal/ui/csrf"
	"{{.ModulePath}}/internal/ui/utils"
)

// SettingsAPITokensSection is the API tokens card of the security settings.
// Requests replace its parts by id: the create dialog, the token list and
// the one-time reveal. The card and its script are only rendered with the
// page.
templ SettingsAPITokensSection(view APITokensView) {
	@card.Card(card.Props{ID: "settings-api-tokens"}) {
		@card.Header() {
			@card.Title() {
				API Tokens
			}
			@card.Description() {
				Personal tokens let scripts and AI agents use the JSON API as you. Treat them like passwords.
			}
			@APITokenCreateDialog(view)
		}
		@card.Content() {
			@APITokenList(view)
			<div id="api-token-reveal" hx-swap-oob="true"></div>
		}
	}
	@apiTokenScript()
}

// APITokenCreateDialog is the create button with its dialog. A successful
// create replaces it, which closes the dialog and resets the form.
templ APITokenCreateDialog(view APITokensView) {
	@card.Action(card.ActionProps{ID: "api-token-create", Attributes: templ.Attributes{"hx-swap-oob": "true"}}) {
		@dialog.Dialog(dialog.Props{ID: "api-token-create-dialog"}) {
			@button.Button(button.Props{Size: button.SizeSm, Attributes: dialog.Trigger(ctx)}) {
				@icon.Plus(icon.Props{Class: "size-4"})
				Create Token
			}
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
				@dialog.Header() {
					@dialog.Title() {
						Create API Token
					}
					@dialog.Description() {
						The token is shown once after you create it.
					}
				}
				@APITokenCreateForm(view, false)
			}
		}
	}
}

// APITokenCreateForm is the create form. With oob it replaces the form in the
// open dialog, for example to show validation errors.
templ APITokenCreateForm(view APITokensView, oob bool) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	{{ form := view.Form }}
	<form
		id="api-token-form"
		if oob {
			hx-swap-oob="true"
		}
		class="space-y-4"
		hx-post={ basePath + "/settings/api-tokens" }
		hx-swap="none"
		hx-disable="find button[type='submit']"
	>
		@csrf.Token()
		@field.Field() {
			@field.Label(field.LabelProps{For: "api-token-name"}) {
				Name
			}
			@input.Input(input.Props{
				ID:          "api-token-name",
				Name:        "name",
				Type:        "text",
				Value:       form.Name,
				Placeholder: "Claude Desktop",
				Required:    true,
				Attributes:  templ.Attributes{"maxlength": "64", "autocomplete": "off", "aria-invalid": apiTokenInvalid(form.Errors["name"])},
			})
			if form.Errors["name"] != "" {
				@field.Error() {
					{ form.Errors["name"] }
				}
			}
		}
		@field.Field() {
			@field.Label(field.LabelProps{For: "api-token-access"}) {
				Access
			}
			@selectcomp.Select(selectcomp.Props{Name: "access", DefaultValue: form.Access, Items: apiTokenAccessItems}) {
				@selectcomp.Trigger(selectcomp.TriggerProps{ID: "api-token-access", Class: "w-full", Attributes: templ.Attributes{"aria-invalid": apiTokenInvalid(form.Errors["access"])}}) {
					@selectcomp.Value()
				}
				@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart}) {
					for _, item := range apiTokenAccessItems {
						@selectcomp.Item(selectcomp.ItemProps{Value: item.Value}) {
							{ item.Label.(string) }
						}
					}
				}
			}
			@field.Description() {
				Read only tokens can look but not change anything.
			}
			if form.Errors["access"] != "" {
				@field.Error() {
					{ form.Errors["access"] }
				}
			}
		}
		@field.Field() {
			@field.Label(field.LabelProps{For: "api-token-expiry"}) {
				Expiration
			}
			@selectcomp.Select(selectcomp.Props{Name: "expiry", DefaultValue: form.Expiry, Items: apiTokenExpiryItems}) {
				@selectcomp.Trigger(selectcomp.TriggerProps{ID: "api-token-expiry", Class: "w-full", Attributes: templ.Attributes{"aria-invalid": apiTokenInvalid(form.Errors["expiry"])}}) {
					@selectcomp.Value()
				}
				@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart}) {
					for _, item := range apiTokenExpiryItems {
						@selectcomp.Item(selectcomp.ItemProps{Value: item.Value}) {
							{ item.Label.(string) }
						}
					}
				}
			}
			if form.Errors["expiry"] != "" {
				@field.Error() {
					{ form.Errors["expiry"] }
				}
			}
		}
		if len(view.Workspaces) > 0 {
			@field.Field() {
				@field.Label(field.LabelProps{For: "api-token-workspace"}) {
					Workspace
				}
				@selectcomp.Select(selectcomp.Props{Name: "workspace_id", DefaultValue: form.WorkspaceID, Items: view.workspaceItems()}) {
					@selectcomp.Trigger(selectcomp.TriggerProps{ID: "api-token-workspace", Class: "w-full", Attributes: templ.Attributes{"aria-invalid": apiTokenInvalid(form.Errors["workspace_id"])}}) {
						@selectcomp.Value()
					}
					@selectcomp.Content(selectcomp.ContentProps{AlignItemWithTrigger: utils.Ptr(false), Align: selectcomp.AlignStart}) {
						for _, workspace := range view.Workspaces {
							@selectcomp.Item(selectcomp.ItemProps{Value: workspace.ID}) {
								{ workspace.Name }
							}
						}
					}
				}
				@field.Description() {
					The token can only reach this workspace.
				}
				if form.Errors["workspace_id"] != "" {
					@field.Error() {
						{ form.Errors["workspace_id"] }
					}
				}
			}
		}
		if form.Errors["form"] != "" {
			@field.Error() {
				{ form.Errors["form"] }
			}
		}
		@dialog.Footer() {
			@button.Button(button.Props{Type: "button", Variant: button.VariantOutline, Attributes: dialog.CloseFor("api-token-create-dialog")}) {
				Cancel
			}
			@button.Button(button.Props{Type: "submit"}) {
				Create Token
			}
		}
	</form>
}

// APITokenList lists the tokens with a revoke button each.
templ APITokenList(view APITokensView) {
	{{ basePath := ctxkeys.AppBasePath(ctx) }}
	<div id="api-token-list" hx-swap-oob="true">
		if len(view.Tokens) == 0 {
			<p class="rounded-lg border border-dashed p-6 text-center text-sm text-muted-foreground">
				No API tokens yet. Create one to connect a script or an AI agent.
			</p>
		} else {
			<div class="overflow-hidden rounded-lg border">
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head(table.HeadProps{Class: "px-4"}) {
								Token
							}
							@table.Head(table.HeadProps{Class: "hidden px-4 sm:table-cell"}) {
								Access
							}
							@table.Head(table.HeadProps{Class: "hidden px-4 md:table-cell"}) {
								Usage
							}
							@table.Head(table.HeadProps{Class: "px-4 text-right"}) {
								<span class="sr-only">Actions</span>
							}
						}
					}
					@table.Body() {
						for _, token := range view.Tokens {
							@table.Row(table.RowProps{Attributes: templ.Attributes{"data-api-token-row": token.ID}}) {
								@table.Cell(table.CellProps{Class: "px-4 py-3 whitespace-normal align-top"}) {
									<div class="flex flex-wrap items-center gap-2">
										<span class="font-medium break-all">{ token.Name }</span>
										if token.IsExpired(view.Now) {
											@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
												Expired
											}
										}
									</div>
									<p class="mt-1 font-mono text-xs text-muted-foreground">pat_{ token.Prefix }…</p>
									if view.WorkspaceNames[token.ID] != "" {
										<p class="mt-1 text-xs text-muted-foreground">{ view.WorkspaceNames[token.ID] }</p>
									}
									<p class="mt-1 text-xs text-muted-foreground sm:hidden">{ apiTokenAccessLabel(token) }</p>
									<p class="mt-1 text-xs text-muted-foreground md:hidden">{ apiTokenLastUsed(token) } · { apiTokenExpiry(token, view.Now) }</p>
								}
								@table.Cell(table.CellProps{Class: "hidden px-4 py-3 align-top sm:table-cell"}) {
									@badge.Badge(badge.Props{Variant: utils.IfElse(token.CanWrite(), badge.VariantDefault, badge.VariantSecondary)}) {
										{ apiTokenAccessLabel(token) }
									}
								}
								@table.Cell(table.CellProps{Class: "hidden px-4 py-3 align-top text-xs text-muted-foreground md:table-cell"}) {
									<p>{ apiTokenLastUsed(token) }</p>
									<p class="mt-1">{ apiTokenExpiry(token, view.Now) }</p>
								}
								@table.Cell(table.CellProps{Class: "px-4 py-3 text-right align-top"}) {
									@button.Button(button.Props{
										Type:    "button",
										Variant: button.VariantOutline,
										Size:    button.SizeSm,
										Attributes: templ.Attributes{
											"aria-label": "Revoke " + token.Name,
											"hx-delete":  basePath + "/settings/api-tokens/" + token.ID,
											"hx-swap":    "none",
											"hx-disable": "this",
											"hx-confirm": "Revoke " + token.Name + "? Requests with it stop working right away.",
										},
									}) {
										Revoke
									}
								}
							}
						}
					}
				}
			</div>
		}
	</div>
}

// APITokenReveal shows a new raw token once, in a dialog that opens when it
// arrives. Closing it removes the token from the page.
templ APITokenReveal(raw string) {
	<div id="api-token-reveal" hx-swap-oob="true">
		@dialog.Dialog(dialog.Props{ID: "api-token-reveal-dialog", DefaultOpen: true, DisablePointerDismissal: true}) {
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
				@dialog.Header() {
					@dialog.Title() {
						Copy Your New Token
					}
					@dialog.Description() {
						This is the only time the token is shown. Store it somewhere safe, for example in your password manager.
					}
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: "api-token-value"}) {
						Token
					}
					<div class="flex gap-2">
						@input.Input(input.Props{ID: "api-token-value", Type: "text", Value: raw, ReadOnly: true, Class: "font-mono text-xs", Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false"}})
						@button.Button(button.Props{Type: "button", Variant: button.VariantOutline, Attributes: templ.Attributes{"data-api-token-copy": "api-token-value"}}) {
							@icon.Copy(icon.Props{Class: "size-4"})
							<span data-api-token-copy-label>Copy</span>
						}
					</div>
					<p class="sr-only" role="status" aria-live="polite" data-api-token-copy-status></p>
				}
				@dialog.Footer() {
					@button.Button(button.Props{Attributes: dialog.Close(ctx)}) {
						Done
					}
				}
			}
		}
	</div>
}

// apiTokenScript copies a revealed token and removes it from the page when
// its dialog closes. It is rendered once with the page, so swapped parts
// carry no script.
templ apiTokenScript() {
	<script nonce={ templ.GetNonce(ctx) }>
		(function () {
			document.addEventListener("click", async function (event) {
				const button = event.target instanceof Element ? event.target.closest("[data-api-token-copy]") : null;
				if (!button) return;
				const input = document.getElementById(button.getAttribute("data-api-token-copy"));
				const label = button.querySelector("[data-api-token-copy-label]");
				const status = button.closest("[data-slot=field]")?.querySelector("[data-api-token-copy-status]");
				if (!input) return;
				try {
					await navigator.clipboard.writeText(input.value);
					if (label) label.textContent = "Copied";
					if (status) status.textContent = "Token copied to the clipboard";
				} catch (error) {
					input.select();
					if (status) status.textContent = "Copy failed. Select the token and copy it manually";
				}
			});
			document.addEventListener("dialog-close", function (event) {
				if (!(event.target instanceof Element) || event.target.id !== "api-token-reveal-dialog") return;
				document.getElementById("api-token-reveal")?.replaceChildren();
			});
		})();
	</script>
}
