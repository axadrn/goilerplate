func TestRequireAuthRedirectsGuestsAndIncompleteProfiles(t *testing.T) {
	tests := []struct {
		name         string
		context      func(*http.Request) *http.Request
		wantLocation string
		wantCalled   bool
	}{
		{name: "guest", wantLocation: "/auth"},
		{
			name: "incomplete profile",
			context: func(request *http.Request) *http.Request {
				return request.WithContext(ctxkeys.WithUser(request.Context(), &model.User{ID: "user-1"}))
			},
			wantLocation: "/auth/onboarding",
		},
		{
			name: "authenticated",
			context: func(request *http.Request) *http.Request {
				return request.WithContext(ctxkeys.WithUser(request.Context(), &model.User{ID: "user-1", Name: "User"}))
			},
			wantCalled: true,
		},
	}

	for _, test := range tests {
		t.Run(test.name, func(t *testing.T) {
			called := false
			handler := RequireAuth(func(w http.ResponseWriter, r *http.Request) {
				called = true
				w.WriteHeader(http.StatusNoContent)
			})
			request := httptest.NewRequest(http.MethodGet, "/app/example/dashboard", nil)
			if test.context != nil {
				request = test.context(request)
			}
			recorder := httptest.NewRecorder()

			handler(recorder, request)

			if called != test.wantCalled {
				t.Fatalf("handler called = %t, want %t", called, test.wantCalled)
			}
			if test.wantCalled {
				if recorder.Code != http.StatusNoContent {
					t.Fatalf("status = %d, want %d", recorder.Code, http.StatusNoContent)
				}
				return
			}
			if got := recorder.Header().Get("Location"); got != test.wantLocation {
				t.Fatalf("Location = %q, want %q", got, test.wantLocation)
			}
		})
	}
}

