func TestWithWorkspaceLoadsWorkspaceAndRejectsCrossTenantAccess(t *testing.T) {
	database := testutil.NewDatabase(t)
	alice := testutil.SeedUser(t, database, testutil.UserOptions{ID: "scope-alice", Name: "Alice"})
	bob := testutil.SeedUser(t, database, testutil.UserOptions{ID: "scope-bob", Name: "Bob"})
	users := repository.NewUserRepository(database)
	subscriptions := service.NewSubscriptionService(repository.NewSubscriptionRepository(database), repository.NewAdminRepository(database))
	workspaces := service.NewWorkspaceService(
		repository.NewWorkspaceRepository(database),
		repository.NewWorkspaceMemberRepository(database),
		repository.NewWorkspaceInvitationRepository(database),
		repository.NewWorkspaceAuditRepository(database),
		users,
		subscriptions,
		service.NewEmailService(testutil.NewMemoryMailer(), "http://localhost:8090", "Test App"),
	)

	next := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if ctxkeys.Workspace(r.Context()).ID != alice.Workspace.ID {
			t.Fatalf("workspace context = %#v", ctxkeys.Workspace(r.Context()))
		}
		if ctxkeys.WorkspaceMember(r.Context()).UserID != alice.User.ID {
			t.Fatalf("member context = %#v", ctxkeys.WorkspaceMember(r.Context()))
		}
		if ctxkeys.Subscription(r.Context()).WorkspaceID != alice.Workspace.ID {
			t.Fatalf("subscription context = %#v", ctxkeys.Subscription(r.Context()))
		}
		if len(ctxkeys.Workspaces(r.Context())) != 1 {
			t.Fatalf("workspace switcher entries = %#v", ctxkeys.Workspaces(r.Context()))
		}
		w.WriteHeader(http.StatusNoContent)
	})

	request := httptest.NewRequest(http.MethodGet, "/app/"+alice.Workspace.Slug+"/dashboard", nil)
	request.SetPathValue("workspaceSlug", alice.Workspace.Slug)
	request = request.WithContext(ctxkeys.WithUser(request.Context(), alice.User))
	recorder := httptest.NewRecorder()
	WithWorkspace(workspaces, subscriptions)(next).ServeHTTP(recorder, request)
	if recorder.Code != http.StatusNoContent {
		t.Fatalf("member status = %d, want %d", recorder.Code, http.StatusNoContent)
	}

	crossTenant := httptest.NewRequest(http.MethodGet, "/app/"+bob.Workspace.Slug+"/dashboard", nil)
	crossTenant.SetPathValue("workspaceSlug", bob.Workspace.Slug)
	crossTenant = crossTenant.WithContext(ctxkeys.WithUser(crossTenant.Context(), alice.User))
	crossTenantRecorder := httptest.NewRecorder()
	WithWorkspace(workspaces, subscriptions)(next).ServeHTTP(crossTenantRecorder, crossTenant)
	if crossTenantRecorder.Code != http.StatusNotFound {
		t.Fatalf("cross-tenant status = %d, want %d", crossTenantRecorder.Code, http.StatusNotFound)
	}
}

func TestWithWorkspaceRestoresMissingFreeSubscription(t *testing.T) {
	database := testutil.NewDatabase(t)
	fixture := testutil.SeedUser(t, database, testutil.UserOptions{ID: "missing-subscription-user"})
	if _, err := database.Exec(`DELETE FROM subscriptions WHERE workspace_id = $1`, fixture.Workspace.ID); err != nil {
		t.Fatalf("delete fixture subscription: %v", err)
	}
	users := repository.NewUserRepository(database)
	subscriptions := service.NewSubscriptionService(repository.NewSubscriptionRepository(database), repository.NewAdminRepository(database))
	workspaces := service.NewWorkspaceService(
		repository.NewWorkspaceRepository(database),
		repository.NewWorkspaceMemberRepository(database),
		repository.NewWorkspaceInvitationRepository(database),
		repository.NewWorkspaceAuditRepository(database),
		users,
		subscriptions,
		service.NewEmailService(testutil.NewMemoryMailer(), "http://localhost:8090", "Test App"),
	)

	request := httptest.NewRequest(http.MethodGet, "/app/"+fixture.Workspace.Slug+"/dashboard", nil)
	request.SetPathValue("workspaceSlug", fixture.Workspace.Slug)
	request = request.WithContext(ctxkeys.WithUser(request.Context(), fixture.User))
	recorder := httptest.NewRecorder()
	WithWorkspace(workspaces, subscriptions)(func(w http.ResponseWriter, r *http.Request) {
		subscription := ctxkeys.Subscription(r.Context())
		if subscription.PlanID != model.SubscriptionPlanFree || subscription.Status != model.SubscriptionStatusActive {
			t.Fatalf("subscription context = %#v", subscription)
		}
		w.WriteHeader(http.StatusNoContent)
	}).ServeHTTP(recorder, request)

	if recorder.Code != http.StatusNoContent {
		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusNoContent)
	}
}

func authenticationServices(database *sqlx.DB) (*service.AuthService, *service.UserService, *service.SubscriptionService) {
	userRepository := repository.NewUserRepository(database)
	subscriptionRepository := repository.NewSubscriptionRepository(database)
	fileService := service.NewFileService(repository.NewFileRepository(database), testutil.NewMemoryStorage())
	subscriptionService := service.NewSubscriptionService(subscriptionRepository, repository.NewAdminRepository(database))
	emailService := service.NewEmailService(testutil.NewMemoryMailer(), "http://localhost:8090", "Test App")
	workspaceService := service.NewWorkspaceService(
		repository.NewWorkspaceRepository(database),
		repository.NewWorkspaceMemberRepository(database),
		repository.NewWorkspaceInvitationRepository(database),
		repository.NewWorkspaceAuditRepository(database),
		userRepository,
		subscriptionService,
		emailService,
	)
	authService := service.NewAuthService(
		userRepository,
		repository.NewTokenRepository(database),
		repository.NewSessionRepository(database),
		workspaceService,
		emailService,
		false,
		7*24*time.Hour,
		24*time.Hour,
		time.Hour,
		24*time.Hour,
		10*time.Minute,
	)
	userService := service.NewUserService(userRepository, fileService, nil, workspaceService)
	return authService, userService, subscriptionService
}
