// requestIdentity records what the authentication middleware put into the
// context of one request.
type requestIdentity struct {
	userID  string
	session bool
	token   bool
	bearer  bool
}

func identify(t *testing.T, environment bearerTestEnvironment, path, authorization string) requestIdentity {
	t.Helper()
	var identity requestIdentity
	next := http.HandlerFunc(func(_ http.ResponseWriter, r *http.Request) {
		user := ctxkeys.User(r.Context())
		if user != nil {
			identity.userID = user.ID
		}
		identity.session = ctxkeys.Session(r.Context()) != nil
		identity.token = ctxkeys.APIToken(r.Context()) != nil
		identity.bearer = ctxkeys.IsBearer(r.Context())
	})
	request := httptest.NewRequest(http.MethodGet, path, nil)
	if authorization != "" {
		request.Header.Set("Authorization", authorization)
	}
	environment.authenticate(environment.tokenAuth(next)).ServeHTTP(httptest.NewRecorder(), request)
	return identity
}

func TestAPITokenAuthenticatesOnlyTheJSONAPI(t *testing.T) {
	environment := newBearerTestEnvironment(t)
	fixture := testutil.SeedUser(t, environment.database, testutil.UserOptions{ID: "agent", Email: "agent@example.com", Name: "Agent", Verified: true})
	_, raw, err := environment.tokens.Create(fixture.User.ID, service.CreateAPITokenInput{
		Name: "Agent",
{{- if .Workspaces }}
		WorkspaceID: fixture.Workspace.ID,
{{- end }}
	})
	if err != nil {
		t.Fatalf("Create() error = %v", err)
	}

	identity := identify(t, environment, "/api/v1/account", "Bearer "+raw)
	if identity != (requestIdentity{userID: fixture.User.ID, token: true}) {
		t.Fatalf("API identity = %#v", identity)
	}
	for _, path := range []string{"/app", "/app/settings", "/admin", "/auth/logout", "/"} {
		identity = identify(t, environment, path, "Bearer "+raw)
		if identity != (requestIdentity{}) {
			t.Fatalf("%s identity = %#v, want unauthenticated", path, identity)
		}
	}
	identity = identify(t, environment, "/api/v1/account", "Bearer pat_unknown")
	if identity != (requestIdentity{}) {
		t.Fatalf("unknown token identity = %#v", identity)
	}

	session := startCookieSession(t, environment.auth, fixture.User.ID)
	identity = identify(t, environment, "/api/v1/account", "Bearer "+session.Value)
	if identity != (requestIdentity{userID: fixture.User.ID, session: true, bearer: true}) {
		t.Fatalf("session bearer identity = %#v", identity)
	}
}
