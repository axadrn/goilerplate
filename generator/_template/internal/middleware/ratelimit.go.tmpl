// RateLimiter tracks request counts per IP address
type RateLimiter struct {
	mu        sync.RWMutex
	requests  map[string][]time.Time
	limit     int           // Max requests allowed
	window    time.Duration // Time window for rate limiting
	done      chan struct{}
	closeOnce sync.Once
}

type ClientIPResolver struct {
	trustedProxyCIDRs []netip.Prefix
}

func NewClientIPResolver(trustedProxyCIDRs []netip.Prefix) ClientIPResolver {
	return ClientIPResolver{
		trustedProxyCIDRs: append([]netip.Prefix(nil), trustedProxyCIDRs...),
	}
}

func (resolver ClientIPResolver) ClientIP(r *http.Request) string {
	return getClientIPWithTrustedProxies(r, resolver.trustedProxyCIDRs)
}

// NewRateLimiter creates a new rate limiter
func NewRateLimiter(limit int, window time.Duration) *RateLimiter {
	rl := &RateLimiter{
		requests: make(map[string][]time.Time),
		limit:    limit,
		window:   window,
		done:     make(chan struct{}),
	}

	// Start cleanup goroutine to prevent memory leak
	go rl.cleanupLoop()

	return rl
}

// Close stops the background cleanup loop.
func (rl *RateLimiter) Close() {
	rl.closeOnce.Do(func() {
		close(rl.done)
	})
}

// Allow checks if request from IP should be allowed
func (rl *RateLimiter) Allow(ip string) bool {
	rl.mu.Lock()
	defer rl.mu.Unlock()

	now := time.Now()
	cutoff := now.Add(-rl.window)

	// Get requests for this IP
	requests := rl.requests[ip]

	// Remove old requests outside time window
	validRequests := []time.Time{}
	for _, reqTime := range requests {
		if reqTime.After(cutoff) {
			validRequests = append(validRequests, reqTime)
		}
	}

	// Check if limit exceeded
	if len(validRequests) >= rl.limit {
		rl.requests[ip] = validRequests
		return false
	}

	// Add current request
	validRequests = append(validRequests, now)
	rl.requests[ip] = validRequests

	return true
}

// cleanupLoop periodically removes old entries to prevent memory leak
func (rl *RateLimiter) cleanupLoop() {
	ticker := time.NewTicker(5 * time.Minute)
	defer ticker.Stop()

	for {
		select {
		case <-ticker.C:
			rl.cleanup()
		case <-rl.done:
			return
		}
	}
}

// cleanup removes IPs with no recent requests
func (rl *RateLimiter) cleanup() {
	rl.mu.Lock()
	defer rl.mu.Unlock()

	now := time.Now()
	cutoff := now.Add(-rl.window * 2) // Keep data for 2x window

	for ip, requests := range rl.requests {
		// Check if all requests are old
		allOld := true
		for _, reqTime := range requests {
			if reqTime.After(cutoff) {
				allOld = false
				break
			}
		}

		// Remove IP if all requests are old
		if allOld {
			delete(rl.requests, ip)
		}
	}
}

// RateLimitAuth creates middleware for auth endpoints
// Limits: 5 requests per 15 minutes per IP
func RateLimitAuth(clientIPs ClientIPResolver) func(http.HandlerFunc) http.HandlerFunc {
	limiter := NewRateLimiter(5, 15*time.Minute)

	return func(next http.HandlerFunc) http.HandlerFunc {
		return func(w http.ResponseWriter, r *http.Request) {
			// Get real IP (handle proxies)
			ip := clientIPs.ClientIP(r)

			// Check rate limit
			if !limiter.Allow(ip) {
				slog.Warn("rate limit exceeded",
					"ip", ip,
					"path", r.URL.Path,
				)
				writeRateLimitError(w, r, limiter)
				return
			}

			next(w, r)
		}
	}
}

// RateLimitAuthEmail limits authentication email delivery by client and recipient.
func RateLimitAuthEmail(clientIPs ClientIPResolver) func(http.HandlerFunc) http.HandlerFunc {
	return rateLimitAuthEmail(clientIPs, NewRateLimiter(10, time.Hour), NewRateLimiter(3, time.Hour))
}

func rateLimitAuthEmail(clientIPs ClientIPResolver, ipLimiter, recipientLimiter *RateLimiter) func(http.HandlerFunc) http.HandlerFunc {
	return func(next http.HandlerFunc) http.HandlerFunc {
		return func(w http.ResponseWriter, r *http.Request) {
			ip := clientIPs.ClientIP(r)
			if !ipLimiter.Allow(ip) {
				slog.Warn("authentication email rate limit exceeded", "ip", ip, "path", r.URL.Path)
				writeRateLimitError(w, r, ipLimiter)
				return
			}

			{{if .API}}email := requestEmail(r){{else}}email := strings.ToLower(strings.TrimSpace(r.FormValue("email"))){{end}}
			if email != "" && !recipientLimiter.Allow(rateLimitEmailKey(email)) {
				slog.Warn("authentication email recipient rate limit exceeded", "path", r.URL.Path)
				writeRateLimitError(w, r, recipientLimiter)
				return
			}

			next(w, r)
		}
	}
}

// RateLimitUserEmailChanges limits verification email delivery per signed-in user.
func RateLimitUserEmailChanges() func(http.HandlerFunc) http.HandlerFunc {
	return rateLimitUserEmailChanges(NewRateLimiter(5, time.Hour), NewRateLimiter(3, time.Hour))
}

func rateLimitUserEmailChanges(userLimiter, recipientLimiter *RateLimiter) func(http.HandlerFunc) http.HandlerFunc {
	return func(next http.HandlerFunc) http.HandlerFunc {
		return func(w http.ResponseWriter, r *http.Request) {
			user := ctxkeys.User(r.Context())
			if user == nil {
				next(w, r)
				return
			}
			if !userLimiter.Allow(user.ID) {
				slog.Warn("email change rate limit exceeded", "user_id", user.ID)
				writeRateLimitError(w, r, userLimiter)
				return
			}
			{{if .API}}email := requestEmail(r){{else}}email := strings.ToLower(strings.TrimSpace(r.FormValue("email"))){{end}}
			if email != "" && !recipientLimiter.Allow(rateLimitEmailKey(email)) {
				slog.Warn("email change recipient rate limit exceeded", "user_id", user.ID)
				writeRateLimitError(w, r, recipientLimiter)
				return
			}
			next(w, r)
		}
	}
}

func rateLimitEmailKey(email string) string {
	sum := sha256.Sum256([]byte(email))
	return hex.EncodeToString(sum[:])
}

func writeRateLimitError(w http.ResponseWriter, r *http.Request, limiter *RateLimiter) {
	w.Header().Set("Retry-After", strconv.Itoa(int(limiter.window.Seconds())))
	renderMiddlewareError(w, r, http.StatusTooManyRequests, "Too many requests", "Please wait a moment and try again.")
}

func getClientIPWithTrustedProxies(r *http.Request, trustedProxyCIDRs []netip.Prefix) string {
	remoteIP := remoteAddressIP(r.RemoteAddr)
	parsedRemoteIP, err := netip.ParseAddr(remoteIP)
	if err == nil && isTrustedProxy(parsedRemoteIP, trustedProxyCIDRs) {
		xff := r.Header.Get("X-Forwarded-For")
		if xff != "" {
			ips := strings.Split(xff, ",")
			for index := len(ips) - 1; index >= 0; index-- {
				clientIP, parseErr := netip.ParseAddr(strings.TrimSpace(ips[index]))
				if parseErr != nil || isTrustedProxy(clientIP, trustedProxyCIDRs) {
					continue
				}
				return clientIP.Unmap().String()
			}
		}

		clientIP, parseErr := netip.ParseAddr(strings.TrimSpace(r.Header.Get("X-Real-IP")))
		if parseErr == nil && !isTrustedProxy(clientIP, trustedProxyCIDRs) {
			return clientIP.Unmap().String()
		}
	}

	return remoteIP
}

func remoteAddressIP(address string) string {
	parsed, err := netip.ParseAddrPort(address)
	if err == nil {
		return parsed.Addr().Unmap().String()
	}
	parsedAddress, err := netip.ParseAddr(strings.Trim(address, "[]"))
	if err == nil {
		return parsedAddress.Unmap().String()
	}
	return address
}

func isTrustedProxy(address netip.Addr, trustedProxyCIDRs []netip.Prefix) bool {
	address = address.Unmap()
	for _, prefix := range trustedProxyCIDRs {
		if prefix.Contains(address) {
			return true
		}
	}
	return false
}
