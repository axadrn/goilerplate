func TestWithWorkspaceAPIAnswersJSONNotFound(t *testing.T) {
	environment := newBearerTestEnvironment(t)
	alice := testutil.SeedUser(t, environment.database, testutil.UserOptions{ID: "api-alice", Email: "alice@example.com", Name: "Alice"})
	bob := testutil.SeedUser(t, environment.database, testutil.UserOptions{ID: "api-bob", Email: "bob@example.com", Name: "Bob"})

	request := httptest.NewRequest(http.MethodGet, "/api/v1/workspaces/"+bob.Workspace.Slug, nil)
	request.SetPathValue("workspaceSlug", bob.Workspace.Slug)
	request = request.WithContext(ctxkeys.WithUser(request.Context(), alice.User))
	recorder := httptest.NewRecorder()
	WithWorkspaceAPI(environment.workspaces, environment.subscriptions)(func(w http.ResponseWriter, r *http.Request) {
		t.Fatal("foreign workspace reached the handler")
	})(recorder, request)

	if recorder.Code != http.StatusNotFound {
		t.Fatalf("status = %d, want 404", recorder.Code)
	}
	detail := decodeAPIError(t, recorder)
	if detail.Code != "not_found" {
		t.Fatalf("code = %q, want not_found", detail.Code)
	}

	own := httptest.NewRequest(http.MethodGet, "/api/v1/workspaces/"+alice.Workspace.Slug, nil)
	own.SetPathValue("workspaceSlug", alice.Workspace.Slug)
	own = own.WithContext(ctxkeys.WithUser(own.Context(), alice.User))
	ownRecorder := httptest.NewRecorder()
	WithWorkspaceAPI(environment.workspaces, environment.subscriptions)(func(w http.ResponseWriter, r *http.Request) {
		if ctxkeys.Workspace(r.Context()).ID != alice.Workspace.ID {
			t.Fatalf("workspace context = %#v", ctxkeys.Workspace(r.Context()))
		}
		w.WriteHeader(http.StatusNoContent)
	})(ownRecorder, own)
	if ownRecorder.Code != http.StatusNoContent {
		t.Fatalf("own workspace status = %d, want 204", ownRecorder.Code)
	}
}
