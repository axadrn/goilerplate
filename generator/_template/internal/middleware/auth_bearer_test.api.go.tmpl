func TestAuthMiddlewareRejectsImpersonationBearer(t *testing.T) {
	environment := newBearerTestEnvironment(t)
	operator := testutil.SeedUser(t, environment.database, testutil.UserOptions{ID: "bearer-operator", Email: "operator@example.com", Name: "Operator", Verified: true})
	target := testutil.SeedUser(t, environment.database, testutil.UserOptions{ID: "bearer-target", Email: "target@example.com", Name: "Target"})
	operatorCookie := startCookieSession(t, environment.auth, operator.User.ID)

	impersonationRecorder := httptest.NewRecorder()
	impersonationRequest := httptest.NewRequest(http.MethodPost, "/admin/users/bearer-target/impersonate", nil)
	impersonationRequest.AddCookie(operatorCookie)
	_, err := environment.auth.StartImpersonation(impersonationRecorder, impersonationRequest, operator.User.ID, target.User.ID)
	if err != nil {
		t.Fatalf("StartImpersonation() error = %v", err)
	}
	impersonationToken := impersonationRecorder.Result().Cookies()[0].Value

	request := httptest.NewRequest(http.MethodGet, "/api/v1/account", nil)
	request.Header.Set("Authorization", "Bearer "+impersonationToken)
	recorder := httptest.NewRecorder()
	environment.authenticate(RequireAuthAPI(func(w http.ResponseWriter, r *http.Request) {
		t.Fatalf("impersonation bearer reached the handler as %#v", ctxkeys.User(r.Context()))
	})).ServeHTTP(recorder, request)

	if recorder.Code != http.StatusUnauthorized {
		t.Fatalf("status = %d, want 401", recorder.Code)
	}
	detail := decodeAPIError(t, recorder)
	if detail.Code != "unauthenticated" {
		t.Fatalf("code = %q, want unauthenticated", detail.Code)
	}
}

func TestRequireAdminAPI(t *testing.T) {
	member := &model.User{ID: "member", Name: "Member"}
	for _, test := range []struct {
		name       string
		user       *model.User
		admin      bool
		wantStatus int
		wantCode   string
	}{
		{name: "guest", wantStatus: http.StatusUnauthorized, wantCode: "unauthenticated"},
		{name: "member", user: member, wantStatus: http.StatusForbidden, wantCode: "forbidden"},
		{name: "admin", user: member, admin: true, wantStatus: http.StatusNoContent},
	} {
		t.Run(test.name, func(t *testing.T) {
			request := httptest.NewRequest(http.MethodGet, "/api/v1/admin/users", nil)
			ctx := ctxkeys.WithAdmin(request.Context(), test.admin)
			if test.user != nil {
				ctx = ctxkeys.WithUser(ctx, test.user)
			}
			recorder := httptest.NewRecorder()
			RequireAdminAPI(func(w http.ResponseWriter, r *http.Request) {
				w.WriteHeader(http.StatusNoContent)
			})(recorder, request.WithContext(ctx))

			if recorder.Code != test.wantStatus {
				t.Fatalf("status = %d, want %d", recorder.Code, test.wantStatus)
			}
			if test.wantCode == "" {
				return
			}
			detail := decodeAPIError(t, recorder)
			if detail.Code != test.wantCode {
				t.Fatalf("code = %q, want %q", detail.Code, test.wantCode)
			}
		})
	}
}
