func TestMiddlewareErrorsAnswerJSONForAPIRequests(t *testing.T) {
	for _, test := range []struct {
		name          string
		path          string
		authorization string
	}{
		{name: "api path", path: "/api/v1/account"},
		{name: "authorization header", path: "/app/settings", authorization: "Bearer token"},
	} {
		t.Run(test.name, func(t *testing.T) {
			request := httptest.NewRequest(http.MethodPost, test.path, nil)
			if test.authorization != "" {
				request.Header.Set("Authorization", test.authorization)
			}
			recorder := httptest.NewRecorder()
			renderMiddlewareError(recorder, request, http.StatusTooManyRequests, "Too many requests", "Please wait a moment and try again.")

			if recorder.Code != http.StatusTooManyRequests {
				t.Fatalf("status = %d, want 429", recorder.Code)
			}
			detail := decodeAPIError(t, recorder)
			if detail.Code != "rate_limited" || detail.Message != "Please wait a moment and try again." {
				t.Fatalf("detail = %#v", detail)
			}
		})
	}
}

func TestBearerToken(t *testing.T) {
	for _, test := range []struct {
		header string
		want   string
		wantOK bool
	}{
		{header: "Bearer abc123", want: "abc123", wantOK: true},
		{header: "bearer abc123", want: "abc123", wantOK: true},
		{header: "Bearer  abc123 ", want: "abc123", wantOK: true},
		{header: "", wantOK: false},
		{header: "Bearer", wantOK: false},
		{header: "Bearer ", wantOK: false},
		{header: "Basic abc123", wantOK: false},
		{header: "Bearer abc 123", wantOK: false},
	} {
		got, ok := bearerToken(test.header)
		if got != test.want || ok != test.wantOK {
			t.Fatalf("bearerToken(%q) = %q, %t, want %q, %t", test.header, got, ok, test.want, test.wantOK)
		}
	}
}
