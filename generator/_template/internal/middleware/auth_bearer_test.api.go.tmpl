func TestBearerRequestSkipsCSRFAndCookieRequestNeedsIt(t *testing.T) {
	environment := newBearerTestEnvironment(t)
	fixture := testutil.SeedUser(t, environment.database, testutil.UserOptions{ID: "chain-user", Name: "Chain User", Verified: true})
	_, token, err := environment.auth.CreateSession(httptest.NewRequest(http.MethodPost, "/api/v1/auth/password", nil), fixture.User.ID)
	if err != nil {
		t.Fatalf("CreateSession() error = %v", err)
	}
	cookie := startCookieSession(t, environment.auth, fixture.User.ID)
	handler := Chain(
		http.HandlerFunc(RequireAuthAPI(func(w http.ResponseWriter, r *http.Request) {
			w.WriteHeader(http.StatusNoContent)
		})),
		CSRFProtection(false, NewClientIPResolver(nil)),
		environment.authenticate,
	)

	bearerRequest := httptest.NewRequest(http.MethodPost, "/api/v1/auth/logout", nil)
	bearerRequest.Header.Set("Authorization", "Bearer "+token)
	bearerRecorder := httptest.NewRecorder()
	handler.ServeHTTP(bearerRecorder, bearerRequest)
	if bearerRecorder.Code != http.StatusNoContent {
		t.Fatalf("bearer status = %d, want 204, body %q", bearerRecorder.Code, bearerRecorder.Body.String())
	}

	// A cookie request needs the CSRF token, also when it carries another
	// Authorization scheme, because the cookie still authenticates it.
	csrfToken := generateCSRFToken()
	for _, authorization := range []string{"", "Basic dXNlcjpwYXNz"} {
		cookieRequest := httptest.NewRequest(http.MethodPost, "/api/v1/auth/logout", nil)
		if authorization != "" {
			cookieRequest.Header.Set("Authorization", authorization)
		}
		cookieRequest.AddCookie(cookie)
		cookieRequest.AddCookie(&http.Cookie{Name: csrfCookieName, Value: csrfToken})
		cookieRecorder := httptest.NewRecorder()
		handler.ServeHTTP(cookieRecorder, cookieRequest)
		if cookieRecorder.Code != http.StatusForbidden {
			t.Fatalf("cookie status with Authorization %q = %d, want 403", authorization, cookieRecorder.Code)
		}
		detail := decodeAPIError(t, cookieRecorder)
		if detail.Code != "forbidden" {
			t.Fatalf("code = %q, want forbidden", detail.Code)
		}

		cookieRequest.Header.Set(csrfHeader, csrfToken)
		cookieRecorder = httptest.NewRecorder()
		handler.ServeHTTP(cookieRecorder, cookieRequest)
		if cookieRecorder.Code != http.StatusNoContent {
			t.Fatalf("cookie status with Authorization %q and CSRF token = %d, want 204", authorization, cookieRecorder.Code)
		}
	}
}

func TestRequireOnboardedAPI(t *testing.T) {
	user := &model.User{ID: "new-user"}

	guestRecorder := httptest.NewRecorder()
	RequireOnboardedAPI(func(w http.ResponseWriter, r *http.Request) {
		t.Fatal("guest reached the handler")
	})(guestRecorder, httptest.NewRequest(http.MethodGet, "/api/v1/account/sessions", nil))
	if guestRecorder.Code != http.StatusUnauthorized {
		t.Fatalf("guest status = %d, want 401", guestRecorder.Code)
	}

	request := httptest.NewRequest(http.MethodGet, "/api/v1/account/sessions", nil)
	request = request.WithContext(ctxkeys.WithUser(request.Context(), user))
	recorder := httptest.NewRecorder()
	RequireOnboardedAPI(func(w http.ResponseWriter, r *http.Request) {
		t.Fatal("user without a name reached the handler")
	})(recorder, request)
	if recorder.Code != http.StatusForbidden {
		t.Fatalf("status = %d, want 403", recorder.Code)
	}
	detail := decodeAPIError(t, recorder)
	if detail.Code != "onboarding_required" {
		t.Fatalf("code = %q, want onboarding_required", detail.Code)
	}

	user.Name = "Named User"
	named := httptest.NewRequest(http.MethodGet, "/api/v1/account/sessions", nil)
	named = named.WithContext(ctxkeys.WithUser(named.Context(), user))
	namedRecorder := httptest.NewRecorder()
	RequireOnboardedAPI(func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusNoContent)
	})(namedRecorder, named)
	if namedRecorder.Code != http.StatusNoContent {
		t.Fatalf("named status = %d, want 204", namedRecorder.Code)
	}
}

