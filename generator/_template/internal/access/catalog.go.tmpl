			},
			Purchasable: true,
		},
	},
}

type Catalog struct {
	Signup    SignupPolicy
	Lifecycle LifecyclePolicy
	Plans     []Plan
}

func PlanByID(planID string) (Plan, bool) {
	for _, plan := range Product.Plans {
		if plan.ID == planID {
			return plan, true
		}
	}
	return Plan{}, false
}
