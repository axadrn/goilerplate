{{- if .OAuth }}

func expectProviderRedirect(t *testing.T, recorder *httptest.ResponseRecorder, host, clientID, callback string) {
	t.Helper()
	if recorder.Code != http.StatusTemporaryRedirect {
		t.Fatalf("status = %d", recorder.Code)
	}
	location, err := url.Parse(recorder.Header().Get("Location"))
	if err != nil {
		t.Fatalf("parse redirect: %v", err)
	}
	query := location.Query()
	if location.Host != host || query.Get("client_id") != clientID || query.Get("redirect_uri") != callback || query.Get("state") == "" {
		t.Fatalf("redirect = %q", location)
	}
}
{{- end }}

func expectRedirect(t *testing.T, recorder *httptest.ResponseRecorder, status int, location string) {
	t.Helper()
	if recorder.Code != status || recorder.Header().Get("Location") != location {
		t.Fatalf("status = %d, Location = %q, want %d %q", recorder.Code, recorder.Header().Get("Location"), status, location)
	}
}
