openapi: 3.1.0
info:
  title: {{ printf "%s API" .ProjectName | printf "%q" }}
  version: v1
  description: |
{{- if .IsHeadless }}
    JSON API of {{ .ProjectName }}. The project has no web pages: `GET /` names the
    project and the API base path, `GET /healthz` reports health, and every other
    unknown path answers the `Error` envelope with `not_found`.
{{- else if .IsSvelte }}
    JSON API of {{ .ProjectName }}. The SvelteKit app served on the same origin uses it
    with the session cookie. `GET /healthz` reports health, and every unknown path under
    `/api/` answers the `Error` envelope with `not_found`.
{{- else }}
    JSON API of {{ .ProjectName }}. Every endpoint under `/api/v1` uses the same
    services and rules as the web app.
{{- end }}

    Authentication: sign in with one of the `/api/v1/auth` endpoints and send the returned
    token as `Authorization: Bearer <token>`. A browser frontend on the same site may use
    the `session_token` cookie instead. Cookie requests that change state need the
    `X-CSRF-Token` header with the token from `GET /api/v1/csrf`. Requests with an
    `Authorization: Bearer` header never use cookies and need no CSRF token. Other
    schemes, such as Basic auth added by a proxy, keep the cookie and its CSRF check.

    Cookie sign-in: a browser app on the same origin adds `?session=cookie` to a sign-in
    endpoint. The answer then sets the HttpOnly `session_token` cookie and carries no token,
    so scripts never see it. These sign-ins always need the `X-CSRF-Token` header.

    Personal API tokens: a signed-in user creates them with `POST /api/v1/account/tokens`
    and sends one as `Authorization: Bearer pat_...` from scripts, integrations and AI agents.
    A token acts for its user on the operations that list `apiTokenAuth`, with the scope the
    operation names: `read` for reads, `write` for changes. A token without that scope gets
    403 `insufficient_scope`, and a token on any other operation gets 403 `forbidden`.
    Tokens never manage sessions, tokens, email, password, billing, admin or deletions.
{{- if .Workspaces }}
    Tokens never change member roles or remove members.
    Each token is bound to one workspace: other workspaces answer 404 and are left out of
    lists.
{{- end }}

    Errors: every non-2xx JSON answer is the `Error` envelope with a stable lowercase
    snake case `code`. `fields` is present only for `validation_failed`.

    Times are RFC 3339 in UTC. Lists answer `{"items": [...]}`. Request bodies are
    `application/json` unless an endpoint says otherwise, at most 1 MiB, and unknown
    fields are rejected.

    CORS: browsers on the origins in `CORS_ALLOWED_ORIGINS` may call `/api/` with
    credentials and read the `Retry-After` header of a 429 answer.
servers:
  - url: /
security:
  - bearerAuth: []
  - cookieAuth: []
tags:
  - name: Meta
    description: The API description, the project name and support address, and the CSRF token for cookie sessions.
  - name: Auth
    description: Sign-in, onboarding and logout. Sign-in answers carry a bearer token and set no cookie, unless they ask for a cookie session with `session=cookie`.
  - name: Account
    description: The signed-in account.
  - name: Sessions
    description: Active sessions of the signed-in account.
  - name: API tokens
    description: Personal API tokens of the signed-in account. Only a signed-in session manages them. Recovering the account with a forgot password link, changing, setting or removing the password, and an admin signing the user out everywhere revoke every token. Signing out other sessions keeps them.
{{- if .Workspaces }}
  - name: Workspaces
    description: Workspaces, members, invitations and activity.
  - name: Invitations
    description: Workspace invitations opened with the token from the invitation email.
{{- end }}
  - name: Billing
    description: {{ if .Workspaces }}Workspace subscriptions, checkout and billing management.{{ else }}The subscription, checkout and the customer portal.{{ end }}
  - name: Admin
    description: Operator dashboard data and session revocation. Admins only.
{{- if or .HasGoogleOAuth .HasGitHubOAuth }}
  - name: OAuth
    description: Browser redirect flows. They end in a cookie session and are not JSON endpoints.
{{- end }}

paths:
  /api/v1/openapi.yaml:
    get:
      tags: [Meta]
      operationId: getOpenAPI
      summary: Get this OpenAPI document
      security: []
      responses:
        '200':
          description: The OpenAPI 3.1 document.
          content:
            application/yaml:
              schema:
                type: string

  /api/v1/csrf:
    get:
      tags: [Meta]
      operationId: getCSRFToken
      summary: Get the CSRF token
      description: |
        Returns the CSRF token for cookie requests and sets the `csrf_token` cookie when it is
        missing. Send the token as `X-CSRF-Token` on every cookie request that changes state.
        Bearer clients do not need it.
      security: []
      responses:
        '200':
          description: The CSRF token of this browser.
          headers:
            Set-Cookie:
              description: The HttpOnly `csrf_token` cookie, when the request had none.
              schema:
                type: string
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CSRFToken'

  /api/v1/meta:
    get:
      tags: [Meta]
      operationId: getMeta
      summary: Get the project name and support address
      security: []
      responses:
        '200':
          description: Public facts about the project.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Meta'

  /api/v1/auth/password:
    post:
      tags: [Auth]
      operationId: signInWithPassword
      summary: Sign in with email and password
      security: []
      parameters:
        - $ref: '#/components/parameters/SessionMode'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordSignInRequest'
      responses:
        '200':
          $ref: '#/components/responses/Session'
        '400':
          $ref: '#/components/responses/InvalidBody'
        '401':
          description: '`invalid_credentials`. Wrong email or password, an unverified address, or an account without a password.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '403':
          $ref: '#/components/responses/Forbidden'
        '415':
          $ref: '#/components/responses/UnsupportedMediaType'
        '422':
          $ref: '#/components/responses/ValidationFailed'
          description: '`validation_failed` with `fields.email` or `fields.password`.'
        '429':
          $ref: '#/components/responses/RateLimited'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/auth/magic-link:
    post:
      tags: [Auth]
      operationId: sendMagicLink
      summary: Email a sign-in link
      description: |
        Emails a link to `APP_URL/auth/magic-link/{token}` and creates the account when the
        address is new. The answer is the same whether or not an account exists. The page at
        that link calls `POST /api/v1/auth/magic-link/verify` with the token.
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EmailRequest'
      responses:
        '202':
          description: The link is on its way when the address can receive one.
        '400':
          $ref: '#/components/responses/InvalidBody'
        '403':
          $ref: '#/components/responses/Forbidden'
        '415':
          $ref: '#/components/responses/UnsupportedMediaType'
        '422':
          $ref: '#/components/responses/ValidationFailed'
          description: '`validation_failed` with `fields.email`.'
        '429':
          $ref: '#/components/responses/RateLimited'
          description: '`rate_limited`. Too many links for this client IP or this address.'

  /api/v1/auth/magic-link/verify:
    post:
      tags: [Auth]
      operationId: verifyMagicLink
      summary: Sign in with a magic link token
      security: []
      parameters:
        - $ref: '#/components/parameters/SessionMode'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TokenRequest'
      responses:
        '200':
          $ref: '#/components/responses/Session'
        '400':
          $ref: '#/components/responses/InvalidToken'
        '403':
          $ref: '#/components/responses/Forbidden'
        '415':
          $ref: '#/components/responses/UnsupportedMediaType'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/auth/forgot-password:
    post:
      tags: [Auth]
      operationId: sendForgotPasswordLink
      summary: Email a password reset link
      description: |
        Emails a link to `APP_URL/auth/forgot-password/{token}`. The answer is the same whether
        or not an account exists. The page at that link calls
        `POST /api/v1/auth/forgot-password/verify` with the token.
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EmailRequest'
      responses:
        '202':
          description: The link is on its way when an account exists.
        '400':
          $ref: '#/components/responses/InvalidBody'
        '403':
          $ref: '#/components/responses/Forbidden'
        '415':
          $ref: '#/components/responses/UnsupportedMediaType'
        '422':
          $ref: '#/components/responses/ValidationFailed'
          description: '`validation_failed` with `fields.email`.'
        '429':
          $ref: '#/components/responses/RateLimited'
          description: '`rate_limited`. Too many links for this client IP or this address.'

  /api/v1/auth/forgot-password/verify:
    post:
      tags: [Auth]
      operationId: verifyForgotPassword
      summary: Sign in with a password reset token
      description: Removes the password, signs out every other session, revokes every personal API token, and returns a new session. Set a new password with `POST /api/v1/account/password/set`.
      security: []
      parameters:
        - $ref: '#/components/parameters/SessionMode'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TokenRequest'
      responses:
        '200':
          $ref: '#/components/responses/Session'
        '400':
          $ref: '#/components/responses/InvalidToken'
        '403':
          $ref: '#/components/responses/Forbidden'
        '415':
          $ref: '#/components/responses/UnsupportedMediaType'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/auth/email-change/verify:
    post:
      tags: [Auth]
      operationId: verifyEmailChange
      summary: Confirm an email change
      description: |
        Moves the pending address to the account, signs out every session of the account, and
        returns a new session. A cookie caller also gets the new session cookie. The link in the
        email points to `APP_URL/auth/verify-email-change/{token}`.
      security: []
      parameters:
        - $ref: '#/components/parameters/SessionMode'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TokenRequest'
      responses:
        '200':
          $ref: '#/components/responses/Session'
        '400':
          $ref: '#/components/responses/InvalidToken'
        '403':
          $ref: '#/components/responses/Forbidden'
        '415':
          $ref: '#/components/responses/UnsupportedMediaType'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/auth/onboarding:
    post:
      tags: [Auth]
      operationId: completeOnboarding
      summary: Complete onboarding
      description: {{ if .Workspaces }}Sets the name of a new account and creates its first workspace when it has none. With `invitation_token` of an available invitation for the account's email address no workspace is created, because the account joins the invited workspace next through `POST /api/v1/invitations/{token}/accept`.{{ if .IsSvelte }} Without `invitation_token` the `pending_invitation` cookie of the invitation preview counts the same way.{{ end }}{{ else }}Sets the name of a new account.{{ end }} Every other endpoint answers `onboarding_required` until this is done.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/{{ if .Workspaces }}OnboardingRequest{{ else }}NameRequest{{ end }}'
      responses:
        '200':
          description: The onboarded account.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/{{ if .Workspaces }}OnboardingResponse{{ else }}UserResponse{{ end }}'
        '400':
          $ref: '#/components/responses/InvalidBody'
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/Forbidden'
        '415':
          $ref: '#/components/responses/UnsupportedMediaType'
        '422':
          $ref: '#/components/responses/ValidationFailed'
          description: '`validation_failed` with `fields.name`.'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/auth/logout:
    post:
      tags: [Auth]
      operationId: signOut
      summary: Sign out
      description: Revokes the session of the bearer token, or the cookie session and its cookie.
      responses:
        '204':
          description: The session is revoked.
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/Forbidden'
          description: '`forbidden` for a cookie request without a valid `X-CSRF-Token` header. Logout stays available during impersonation.'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/account:
    get:
      tags: [Account]
      operationId: getAccount
      summary: Get the signed-in account
      description: Works before onboarding and reports `onboarding_required`.
      security:
        - bearerAuth: []
        - cookieAuth: []
        - apiTokenAuth: [read]
      responses:
        '200':
          description: The account.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Account'
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '500':
          $ref: '#/components/responses/Internal'
    delete:
      tags: [Account]
      operationId: deleteAccount
      summary: Delete the account
      description: Deletes the account after the caller types its email address. Every session ends with it.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/DeleteAccountRequest'
      responses:
        '204':
          description: The account is deleted.
        '400':
          $ref: '#/components/responses/InvalidBody'
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/OnboardedForbidden'
{{- if .Workspaces }}
        '409':
          $ref: '#/components/responses/Conflict'
          description: '`sole_workspace_owner`. Transfer or delete the workspaces the account owns alone first.'
{{- else }}
        '409':
          $ref: '#/components/responses/Conflict'
          description: '`active_subscription`. End paid access first.'
{{- end }}
        '415':
          $ref: '#/components/responses/UnsupportedMediaType'
        '422':
          $ref: '#/components/responses/ValidationFailed'
          description: '`validation_failed` with `fields.confirm_email` when it does not match the account email.'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/account/name:
    patch:
      tags: [Account]
      operationId: updateAccountName
      summary: Change the display name
      security:
        - bearerAuth: []
        - cookieAuth: []
        - apiTokenAuth: [write]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NameRequest'
      responses:
        '200':
          description: The updated account.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserResponse'
        '400':
          $ref: '#/components/responses/InvalidBody'
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/OnboardedForbidden'
        '415':
          $ref: '#/components/responses/UnsupportedMediaType'
        '422':
          $ref: '#/components/responses/ValidationFailed'
          description: '`validation_failed` with `fields.name`.'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/account/email:
    patch:
      tags: [Account]
      operationId: requestEmailChange
      summary: Change the email address
      description: |
        Emails a verification link to the new address. The address changes once the link is
        confirmed with `POST /api/v1/auth/email-change/verify`.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EmailRequest'
      responses:
        '202':
          description: The verification link is on its way.
        '400':
          $ref: '#/components/responses/InvalidBody'
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/OnboardedForbidden'
        '409':
          $ref: '#/components/responses/Conflict'
          description: '`email_taken`. Another account uses this address.'
        '415':
          $ref: '#/components/responses/UnsupportedMediaType'
        '422':
          $ref: '#/components/responses/ValidationFailed'
          description: '`validation_failed` with `fields.email`, also when the address is the current one.'
        '429':
          $ref: '#/components/responses/RateLimited'
          description: '`rate_limited`. Too many email changes for this account or this address.'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/account/password:
    post:
      tags: [Account]
      operationId: changePassword
      summary: Change the password
      description: Replaces the password, signs out every other session, and revokes every personal API token.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChangePasswordRequest'
      responses:
        '204':
          description: The password is changed.
        '400':
          $ref: '#/components/responses/InvalidBody'
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/OnboardedForbidden'
        '409':
          $ref: '#/components/responses/Conflict'
          description: '`password_not_set`. The account has no password, set one first.'
        '415':
          $ref: '#/components/responses/UnsupportedMediaType'
        '422':
          $ref: '#/components/responses/ValidationFailed'
          description: '`validation_failed` with `fields.current_password` or `fields.new_password`.'
        '500':
          $ref: '#/components/responses/Internal'
    delete:
      tags: [Account]
      operationId: removePassword
      summary: Remove the password
      description: Makes the account passwordless, signs out every other session, and revokes every personal API token.
      responses:
        '204':
          description: The password is removed.
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/OnboardedForbidden'
        '409':
          $ref: '#/components/responses/Conflict'
          description: '`password_not_set`. The account has no password.'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/account/password/set:
    post:
      tags: [Account]
      operationId: setPassword
      summary: Add a password
      description: Adds a password to a passwordless account, signs out every other session, and revokes every personal API token.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SetPasswordRequest'
      responses:
        '204':
          description: The password is set.
        '400':
          $ref: '#/components/responses/InvalidBody'
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/OnboardedForbidden'
        '409':
          $ref: '#/components/responses/Conflict'
          description: '`password_already_set`. Change the password instead.'
        '415':
          $ref: '#/components/responses/UnsupportedMediaType'
        '422':
          $ref: '#/components/responses/ValidationFailed'
          description: '`validation_failed` with `fields.password`.'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/account/sessions:
    get:
      tags: [Sessions]
      operationId: listSessions
      summary: List active sessions
      responses:
        '200':
          description: Every active session. The session of this request has `current` set.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SessionList'
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/OnboardedForbidden'
        '500':
          $ref: '#/components/responses/Internal'
    delete:
      tags: [Sessions]
      operationId: revokeOtherSessions
      summary: Sign out every other session
      description: Personal API tokens stay valid. Revoke them one by one with `DELETE /api/v1/account/tokens/{id}`.
      responses:
        '204':
          description: Only the current session is left.
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/OnboardedForbidden'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/account/sessions/{id}:
    parameters:
      - $ref: '#/components/parameters/SessionID'
    delete:
      tags: [Sessions]
      operationId: revokeSession
      summary: Sign out one session
      description: Revoking the current session signs the caller out, and a cookie caller also loses the cookie.
      responses:
        '204':
          description: The session is revoked.
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/OnboardedForbidden'
        '404':
          $ref: '#/components/responses/NotFound'
          description: '`not_found`. No active session with this ID belongs to the account.'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/account/tokens:
    get:
      tags: [API tokens]
      operationId: listAPITokens
      summary: List personal API tokens
      description: Newest first. Expired tokens stay listed with `expired` set until they are revoked. The token itself is never shown again.
      responses:
        '200':
          description: Every token of the account.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/APITokenList'
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/OnboardedForbidden'
          description: '`onboarding_required`, `forbidden` for a personal API token.'
        '500':
          $ref: '#/components/responses/Internal'
    post:
      tags: [API tokens]
      operationId: createAPIToken
      summary: Create a personal API token
      description: Answers the token once. Store it right away; only its hash is kept. An account holds at most 50 tokens.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreateAPITokenRequest'
      responses:
        '201':
          description: The new token and its raw value.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CreatedAPIToken'
        '400':
          $ref: '#/components/responses/InvalidBody'
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/OnboardedForbidden'
          description: '`onboarding_required`, `forbidden` for a personal API token or a cookie request without a valid `X-CSRF-Token` header, `impersonation_read_only` during impersonation.'
        '409':
          $ref: '#/components/responses/Conflict'
          description: '`token_limit`. Revoke a token first.'
        '415':
          $ref: '#/components/responses/UnsupportedMediaType'
        '422':
          $ref: '#/components/responses/ValidationFailed'
          description: '`validation_failed` with `fields.name`, `fields.scopes`, `fields.expires_in_days`{{ if .Workspaces }} or `fields.workspace_id`{{ end }}.'
        '500':
          $ref: '#/components/responses/Internal'

  /api/v1/account/tokens/{id}:
    parameters:
      - $ref: '#/components/parameters/APITokenID'
    delete:
      tags: [API tokens]
      operationId: revokeAPIToken
      summary: Revoke a personal API token
      description: Requests with the token answer 401 from now on.
      responses:
        '204':
          description: The token is revoked.
        '401':
          $ref: '#/components/responses/Unauthenticated'
        '403':
          $ref: '#/components/responses/OnboardedForbidden'
          description: '`onboarding_required`, `forbidden` for a personal API token or a cookie request without a valid `X-CSRF-Token` header, `impersonation_read_only` during impersonation.'
        '404':
          $ref: '#/components/responses/NotFound'
          description: '`not_found`. No token with this ID belongs to the account.'
        '500':
          $ref: '#/components/responses/Internal'
{{- if .Storage }}

  /api/v1/account/avatar:
    post:
      tags: [Account]
      operationId: uploadAvatar
      summary: Upload an avatar
      description: Replaces the avatar. The request is `multipart/form-data` with the image in the field `file`, at most 10 MB.
      security:
        - bearerAuth: []
        - cookieAuth: []
        - apiTokenAuth: [write]
      requestBody:
        required: true
        content:
          multipart/form-data:
            schema:
              type: object
              required: [file]
              properties:
                file:
                  type: string
                  contentMediaType: application/octet-stream
                  description: A JPEG, PNG or WebP image.
      responses:
