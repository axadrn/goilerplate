{{- if .HasGoogleOAuth }}

  /auth/google:
    get:
      tags: [OAuth]
      operationId: startGoogleSignIn
      summary: Start Google sign-in
      description: Open in a browser, not with fetch. Redirects to Google, which returns to `API_URL/auth/google/callback`. `API_URL` defaults to `APP_URL`.
      security: []
      responses:
        '307':
          description: Redirect to Google.
        '303':
          description: The browser is already signed in and goes to {{ if not .HasHTMLFrontend }}`APP_URL/app`{{ else }}the app{{ end }}.
        '429':
          description: Too many attempts from this client IP.

  /auth/google/callback:
    get:
      tags: [OAuth]
      operationId: finishGoogleSignIn
      summary: Finish Google sign-in
{{- if not .HasHTMLFrontend }}
      description: Google redirects the browser here. On success the browser gets the `session_token` cookie and goes to `APP_URL/app`, where the frontend reads `GET /api/v1/account` for `onboarding_required`. A failed sign-in goes to `APP_URL/auth?error=oauth_failed`.
      security: []
      parameters:
        - $ref: '#/components/parameters/OAuthCode'
        - $ref: '#/components/parameters/OAuthState'
      responses:
        '303':
          description: Signed in, redirect to `APP_URL/app` with the `session_token` cookie. Or sign-in failed, redirect to `APP_URL/auth?error=oauth_failed` without a cookie.
          headers:
            Set-Cookie:
              description: The `session_token` cookie after a successful sign-in.
              schema:
                type: string
{{- else }}
      description: Google redirects the browser here. On success the browser gets the `session_token` cookie and goes to the app or to onboarding.
      security: []
      parameters:
        - $ref: '#/components/parameters/OAuthCode'
        - $ref: '#/components/parameters/OAuthState'
      responses:
        '303':
          description: Signed in. Redirect to the app or to onboarding.
          headers:
            Set-Cookie:
              description: The `session_token` cookie.
              schema:
                type: string
        '200':
          description: Sign-in failed. The sign-in page with the error.
          content:
            text/html:
              schema:
                type: string
{{- end }}
        '429':
          description: Too many attempts from this client IP.
{{- end }}
