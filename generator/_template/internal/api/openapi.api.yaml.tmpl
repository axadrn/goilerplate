      parameters:
        - $ref: '#/components/parameters/OAuthCode'
        - $ref: '#/components/parameters/OAuthState'
      responses:
        '303':
          description: Signed in, redirect to `APP_URL/app` with the `session_token` cookie. Or sign-in failed, redirect to `APP_URL/auth?error=oauth_failed` without a cookie.
          headers:
            Set-Cookie:
              description: The `session_token` cookie after a successful sign-in.
              schema:
                type: string
{{- else }}
      description: GitHub redirects the browser here. On success the browser gets the `session_token` cookie and goes to the app or to onboarding.
      security: []
      parameters:
        - $ref: '#/components/parameters/OAuthCode'
        - $ref: '#/components/parameters/OAuthState'
      responses:
        '303':
          description: Signed in. Redirect to the app or to onboarding.
          headers:
            Set-Cookie:
              description: The `session_token` cookie.
              schema:
                type: string
        '200':
          description: Sign-in failed. The sign-in page with the error.
          content:
            text/html:
              schema:
                type: string
{{- end }}
        '429':
          description: Too many attempts from this client IP.
{{- end }}

components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      description: The `token` from a sign-in endpoint. It is the session and expires with it.
    cookieAuth:
      type: apiKey
      in: cookie
      name: session_token
      description: The session cookie of a same-site browser frontend. Requests that change state also need the `X-CSRF-Token` header.
    apiTokenAuth:
      type: http
      scheme: bearer
      bearerFormat: pat_
      description: 'A personal API token from `POST /api/v1/account/tokens`, sent as `Authorization: Bearer pat_...`. The role in the security entry of an operation is the scope it needs.'

  parameters:
    SessionMode:
      name: session
      in: query
      required: false
      description: '`cookie` sets the HttpOnly `session_token` cookie and answers without the token. A session the browser already had in that cookie is revoked. Such a request always needs the `X-CSRF-Token` header. Leave it out for a bearer token.'
      schema:
        type: string
        enum: [cookie]
    SessionID:
      name: id
      in: path
      required: true
      description: The session ID from `GET /api/v1/account/sessions`.
      schema:
        type: string
    APITokenID:
      name: id
      in: path
      required: true
      description: The token ID from `GET /api/v1/account/tokens`.
      schema:
        type: string
{{- if .Workspaces }}
    WorkspaceSlug:
      name: workspaceSlug
      in: path
      required: true
      description: The workspace slug. Unknown workspaces and workspaces the account does not belong to answer 404.
      schema:
        type: string
    InvitationID:
      name: invitationID
      in: path
      required: true
      description: The invitation ID from `GET /api/v1/workspaces/{workspaceSlug}`.
      schema:
        type: string
    MemberID:
      name: memberID
      in: path
      required: true
      description: The member ID from `GET /api/v1/workspaces/{workspaceSlug}`.
      schema:
        type: string
    InvitationToken:
      name: token
      in: path
      required: true
      description: The token from the invitation email.
      schema:
        type: string
{{- end }}
    UserID:
      name: userID
      in: path
      required: true
      description: The user ID from the admin dashboard.
      schema:
        type: string
{{- if or .HasGoogleOAuth .HasGitHubOAuth }}
    OAuthCode:
      name: code
      in: query
      required: true
      description: The authorization code from the provider.
      schema:
        type: string
    OAuthState:
      name: state
      in: query
      required: true
      description: The state value, checked against the `oauth_state` cookie.
      schema:
        type: string
{{- end }}

  responses:
    Session:
      description: 'A new session. Send `token` as `Authorization: Bearer <token>`. With `session=cookie` the answer is a `CookieSession` and the token is only in the cookie.'
      headers:
        Set-Cookie:
          description: The HttpOnly `session_token` cookie, only with `session=cookie`.
          schema:
            type: string
      content:
        application/json:
          schema:
            oneOf:
              - $ref: '#/components/schemas/SessionToken'
              - $ref: '#/components/schemas/CookieSession'
    InvalidBody:
      description: '`invalid_body`. The body is empty, not valid JSON, has unknown fields, or is larger than 1 MiB.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    InvalidToken:
      description: '`invalid_token` when the token is unknown, expired or used, or `invalid_body`.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    Unauthenticated:
      description: '`unauthenticated`. No valid session.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    Forbidden:
      description: '`forbidden` for a cookie request without a valid `X-CSRF-Token` header, `impersonation_read_only` during impersonation.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    OnboardedForbidden:
      description: '`onboarding_required` until `POST /api/v1/auth/onboarding`, `forbidden` for a cookie request without a valid `X-CSRF-Token` header, `impersonation_read_only` for writes during impersonation.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
{{- if .Workspaces }}
    WorkspaceForbidden:
      description: '`forbidden` when the workspace role does not allow the action or a cookie request has no valid `X-CSRF-Token` header, `onboarding_required`, `impersonation_read_only` for writes during impersonation.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    WorkspaceNotFound:
      description: '`not_found`. Unknown workspace, or the account is not a member.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    InvitationUnavailable:
      description: '`invitation_unavailable`. The invitation expired, was revoked or was used.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
{{- end }}
    AdminForbidden:
      description: '`forbidden` for accounts that are not admins or a cookie request without a valid `X-CSRF-Token` header, `onboarding_required`, `impersonation_read_only` for writes during impersonation.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    Billing:
      description: The subscription, its access, and the plans a checkout can start.
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Billing'
    ProviderURL:
      description: A URL hosted by the payment provider.
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/URLResponse'
    InvalidCheckout:
      description: '`invalid_plan` for an unknown or unpurchasable plan, `invalid_interval` for an interval other than monthly or yearly.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    NoBillingAccount:
      description: '`no_billing_account`. Start a paid plan first.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    NotFound:
      description: '`not_found`.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    Conflict:
      description: The request conflicts with the current state.
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    UnsupportedMediaType:
      description: '`unsupported_media_type`. Send the body as `application/json`.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    ValidationFailed:
      description: '`validation_failed` with one message per invalid field in `fields`.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    RateLimited:
      description: '`rate_limited`. Wait for `Retry-After` seconds.'
      headers:
        Retry-After:
          description: Seconds until the limit resets.
          schema:
            type: integer
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'
    Internal:
      description: '`internal`. The error is logged on the server.'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Error'

  schemas:
    Error:
      type: object
      required: [error]
      properties:
        error:
          type: object
          required: [code, message]
          properties:
            code:
              type: string
              description: Stable lowercase snake case code.
              examples: [validation_failed]
            message:
              type: string
              description: A sentence for humans.
            fields:
              type: object
              description: One message per invalid field. Present only for `validation_failed`.
              additionalProperties:
                type: string
    CSRFToken:
      type: object
      required: [token]
      properties:
        token:
          type: string
    Meta:
      type: object
      required: [name, support_email]
      properties:
        name:
          type: string
          description: The project name.
        support_email:
          type: string
          format: email
          description: The `SUPPORT_EMAIL` address.
    EmailRequest:
      type: object
      additionalProperties: false
      required: [email]
      properties:
        email:
          type: string
          format: email
    TokenRequest:
      type: object
      additionalProperties: false
      required: [token]
      properties:
        token:
          type: string
          description: The token from the emailed link.
    NameRequest:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
{{- if .Workspaces }}
    OnboardingRequest:
      type: object
      additionalProperties: false
      required: [name]
      properties:
        name:
          type: string
        invitation_token:
          type: string
          description: The token of the workspace invitation the person arrived with. An unknown, used, revoked, expired or foreign invitation is ignored and the default workspace is created.
{{- end }}
    PasswordSignInRequest:
      type: object
      additionalProperties: false
      required: [email, password]
      properties:
        email:
          type: string
          format: email
        password:
          type: string
          format: password
    ChangePasswordRequest:
      type: object
      additionalProperties: false
      required: [current_password, new_password]
      properties:
        current_password:
          type: string
          format: password
        new_password:
          type: string
          format: password
          minLength: 12
          description: 12 to 72 bytes, not a common password.
    SetPasswordRequest:
      type: object
      additionalProperties: false
      required: [password]
      properties:
        password:
          type: string
          format: password
          minLength: 12
          description: 12 to 72 bytes, not a common password.
    DeleteAccountRequest:
      type: object
      additionalProperties: false
      required: [confirm_email]
      properties:
        confirm_email:
          type: string
          description: The account email address, compared without case.
    User:
      type: object
      required: [id, email, name, password_set, created_at]
      properties:
        id:
          type: string
        email:
          type: string
          format: email
        name:
          type: string
          description: Empty until onboarding.
        password_set:
          type: boolean
        created_at:
          type: string
          format: date-time
    UserResponse:
      type: object
      required: [user]
      properties:
        user:
          $ref: '#/components/schemas/User'
    CookieSession:
      type: object
      additionalProperties: false
      required: [expires_at, user]
      description: A sign-in with `session=cookie`. The token is only in the HttpOnly `session_token` cookie.
      properties:
        expires_at:
          type: string
          format: date-time
        user:
          $ref: '#/components/schemas/User'
    SessionToken:
      type: object
      required: [token, expires_at, user]
      properties:
        token:
          type: string
          description: The bearer token. It is shown once.
        expires_at:
          type: string
          format: date-time
        user:
          $ref: '#/components/schemas/User'
    Account:
      type: object
      required: [user, onboarding_required{{ if .Workspaces }}, workspaces{{ else }}, subscription, access{{ end }}, is_admin{{ if and .Workspaces .IsSvelte }}, pending_invitation{{ end }}{{ if .Storage }}, avatar_url{{ end }}]
      properties:
        user:
          $ref: '#/components/schemas/User'
        onboarding_required:
          type: boolean
{{- if .Workspaces }}
        workspaces:
          type: array
          description: The workspaces of the account. Subscriptions belong to workspaces, see the workspace billing endpoint.
          items:
            $ref: '#/components/schemas/Membership'
{{- else }}
        subscription:
          oneOf:
            - $ref: '#/components/schemas/Subscription'
            - type: 'null'
        access:
          oneOf:
            - $ref: '#/components/schemas/Access'
            - type: 'null'
{{- end }}
        is_admin:
          type: boolean
          description: True when the signed-in session belongs to an operator listed in `ADMIN_EMAILS` with a verified email. False for API tokens and during impersonation. The admin endpoints answer 403 when it is false.
{{- if and .Workspaces .IsSvelte }}
        pending_invitation:
          type: [string, 'null']
          description: The token of the available invitation for this account that the browser opened before signing in, from the `pending_invitation` cookie. The app returns to it after sign-in.
{{- end }}
{{- if .Storage }}
        avatar_url:
          type: [string, 'null']
          format: uri
{{- end }}
    Session:
      type: object
      required: [id, display_name, current, last_seen_at, created_at]
      properties:
        id:
          type: string
        display_name:
          type: string
          description: Browser and system, for example "Chrome on macOS".
        current:
          type: boolean
        last_seen_at:
          type: string
          format: date-time
        created_at:
          type: string
          format: date-time
    SessionList:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/Session'
    APIToken:
      type: object
      required: [id, name, prefix, scopes, {{ if .Workspaces }}workspace_id, {{ end }}last_used_at, expires_at, expired, created_at]
      properties:
        id:
          type: string
        name:
          type: string
        prefix:
          type: string
          description: The first 8 characters after `pat_`, to tell tokens apart.
        scopes:
          type: array
          items:
            type: string
            enum: [read, write]
          description: '`["read"]` or `["read", "write"]`.'
{{- if .Workspaces }}
        workspace_id:
          type: string
          description: The only workspace the token can reach.
{{- end }}
        last_used_at:
          type: [string, 'null']
          format: date-time
          description: Updated at most once a minute.
        expires_at:
          type: [string, 'null']
          format: date-time
          description: '`null` for a token that never expires.'
        expired:
          type: boolean
        created_at:
          type: string
          format: date-time
    APITokenList:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/APIToken'
    CreateAPITokenRequest:
      type: object
      required: [name{{ if .Workspaces }}, workspace_id{{ end }}]
      additionalProperties: false
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 64
          description: A label such as "Claude Desktop" or "Nightly export".
        scopes:
          type: array
          items:
            type: string
            enum: [read, write]
          description: '`write` includes `read`. Defaults to `["read"]`.'
        expires_in_days:
          type: [integer, 'null']
          minimum: 1
          maximum: 365
          description: '`null` or missing for a token that never expires.'
{{- if .Workspaces }}
        workspace_id:
          type: string
          description: The workspace the token is bound to, one of `GET /api/v1/workspaces`.
{{- end }}
    CreatedAPIToken:
      type: object
      required: [token, api_token]
      properties:
        token:
          type: string
          description: 'The raw token, `pat_` and 52 characters. It is shown only in this answer.'
        api_token:
          $ref: '#/components/schemas/APIToken'
{{- if .Storage }}
    AvatarResponse:
      type: object
      required: [avatar_url]
      properties:
        avatar_url:
          type: [string, 'null']
          format: uri
{{- end }}
{{- if .Workspaces }}
    Workspace:
      type: object
      required: [id, name, slug]
      properties:
        id:
          type: string
        name:
          type: string
        slug:
          type: string
    WorkspaceRole:
      type: string
      enum: [owner, admin, member]
    Membership:
      type: object
      required: [workspace, role]
      properties:
        workspace:
          $ref: '#/components/schemas/Workspace'
        role:
          $ref: '#/components/schemas/WorkspaceRole'
    MembershipList:
      type: object
      required: [items]
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/Membership'
    OnboardingResponse:
      type: object
      required: [user, workspace]
      properties:
        user:
          $ref: '#/components/schemas/User'
        workspace:
          description: The workspace created by onboarding, or null when the account already had one or onboarding came with an available invitation.
          oneOf:
            - $ref: '#/components/schemas/Workspace'
            - type: 'null'
    WorkspaceResponse:
      type: object
      required: [workspace]
      properties:
        workspace:
          $ref: '#/components/schemas/Workspace'
    WorkspaceMember:
      type: object
      required: [id, user_id, name, role, created_at]
      properties:
        id:
          type: string
        user_id:
          type: string
        name:
          type: string
        email:
          type: string
          format: email
          description: Present only for members who may manage members.
        role:
          $ref: '#/components/schemas/WorkspaceRole'
        created_at:
          type: string
          format: date-time
    MemberResponse:
      type: object
      required: [member]
      properties:
        member:
          $ref: '#/components/schemas/WorkspaceMember'
    PendingInvitation:
      type: object
      required: [id, email, role, expires_at, created_at]
      properties:
        id:
          type: string
        email:
          type: string
          format: email
        role:
          $ref: '#/components/schemas/WorkspaceRole'
        expires_at:
          type: string
          format: date-time
        created_at:
          type: string
          format: date-time
    WorkspacePermissions:
      type: object
      required: [manage_workspace, manage_members, manage_owners, manage_billing, delete_workspace, view_audit_log]
      properties:
        manage_workspace:
          type: boolean
        manage_members:
          type: boolean
        manage_owners:
          type: boolean
        manage_billing:
          type: boolean
        delete_workspace:
          type: boolean
        view_audit_log:
          type: boolean
    WorkspaceDetail:
      type: object
      required: [workspace, role, permissions, members, invitations, seats]
      properties:
        workspace:
          $ref: '#/components/schemas/Workspace'
        role:
          $ref: '#/components/schemas/WorkspaceRole'
        permissions:
          $ref: '#/components/schemas/WorkspacePermissions'
        members:
          type: array
          items:
            $ref: '#/components/schemas/WorkspaceMember'
        invitations:
          type: array
          description: Pending invitations. Empty for members who may not manage members.
          items:
            $ref: '#/components/schemas/PendingInvitation'
        seats:
          type: object
          required: [used, limit]
          properties:
            used:
              type: integer
            limit:
              type: [integer, 'null']
              description: Null when the plan has no member limit.
    InvitationRequest:
      type: object
      additionalProperties: false
      required: [email, role]
      properties:
        email:
          type: string
          format: email
        role:
          type: string
          enum: [admin, member]
    RoleRequest:
      type: object
      additionalProperties: false
      required: [role]
      properties:
        role:
          $ref: '#/components/schemas/WorkspaceRole'
    WorkspaceEvent:
      type: object
      required: [id, actor_user_id, actor_email, action, target_type, target_id, metadata, created_at]
      properties:
        id:
          type: string
        actor_user_id:
          type: [string, 'null']
        actor_email:
          type: string
        action:
          type: string
          examples: [member.invited]
        target_type:
          type: string
        target_id:
          type: string
        metadata:
          type: string
          description: JSON text with details of the event.
        created_at:
          type: string
          format: date-time
    ActivityPage:
      type: object
      required: [items, next_cursor]
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/WorkspaceEvent'
        next_cursor:
          type: [string, 'null']
          description: Null on the last page.
    InvitationPreview:
      type: object
      required: [workspace_name, inviter_name, role, expires_at]
      properties:
        workspace_name:
          type: string
        inviter_name:
          type: string
        role:
          $ref: '#/components/schemas/WorkspaceRole'
        expires_at:
          type: string
          format: date-time
{{- end }}
    Subscription:
      type: object
      required: [id, plan_id, status, provider, current_period_end, amount, currency, interval, created_at, updated_at]
      properties:
        id:
          type: string
        plan_id:
          type: string
        status:
          type: string
          enum: [active, trialing, past_due, incomplete, inactive, cancelled, blocked]
        provider:
          type: string
        current_period_end:
          type: [string, 'null']
          format: date-time
        amount:
          type: [integer, 'null']
          description: In the smallest currency unit.
        currency:
          type: string
        interval:
          type: [string, 'null']
          enum: [monthly, yearly, null]
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
    Access:
      type: object
      required: [plan_id, state, trial_ends_at, access_ends_at]
      properties:
        plan_id:
          type: string
        state:
          type: string
          enum: [free, trial, paid, grace, blocked]
        trial_ends_at:
          type: [string, 'null']
          format: date-time
        access_ends_at:
          type: [string, 'null']
          format: date-time
    Plan:
      type: object
      required: [id, name, description, benefits, current, prices]
      properties:
        id:
          type: string
        name:
          type: string
        description:
          type: string
        benefits:
          type: array
          items:
            type: string
        current:
          type: boolean
          description: True for the plan of the current access.
        prices:
          type: array
          items:
            $ref: '#/components/schemas/PlanPrice'
    PlanPrice:
      type: object
      required: [interval, amount, display_price]
      properties:
        interval:
          type: string
          enum: [monthly, yearly]
        amount:
          type: integer
          description: In the smallest currency unit.
        display_price:
          type: string
    Billing:
      type: object
      required: [subscription, access, plans]
      properties:
        subscription:
          oneOf:
            - $ref: '#/components/schemas/Subscription'
            - type: 'null'
        access:
          oneOf:
            - $ref: '#/components/schemas/Access'
            - type: 'null'
        plans:
          type: array
          description: Plans a checkout can start.
          items:
            $ref: '#/components/schemas/Plan'
    CheckoutRequest:
      type: object
      additionalProperties: false
      required: [plan_id]
      properties:
        plan_id:
          type: string
        interval:
          type: string
          enum: [monthly, yearly]
          default: monthly
    URLResponse:
      type: object
      required: [url]
      properties:
        url:
          type: string
          format: uri
    AdminMetrics:
      type: object
      required: [users, verified_users, {{ if .Workspaces }}workspaces, paid_workspaces{{ else }}paid_users{{ end }}, active_sessions]
      properties:
        users:
          type: integer
        verified_users:
          type: integer
{{- if .Workspaces }}
        workspaces:
          type: integer
        paid_workspaces:
          type: integer
{{- else }}
        paid_users:
          type: integer
{{- end }}
        active_sessions:
          type: integer
    AdminUser:
      type: object
      required: [id, email, name, email_verified_at, created_at{{ if .Workspaces }}, workspace_count{{ end }}, active_session_count, is_admin]
      properties:
        id:
          type: string
        email:
          type: string
          format: email
        name:
          type: string
        email_verified_at:
          type: [string, 'null']
          format: date-time
        created_at:
          type: string
          format: date-time
{{- if .Workspaces }}
        workspace_count:
          type: integer
{{- end }}
        active_session_count:
          type: integer
        is_admin:
          type: boolean
    AdminUserPage:
      type: object
      required: [items, query, page, total_pages, total_users]
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/AdminUser'
        query:
          type: string
        page:
          type: integer
        total_pages:
          type: integer
        total_users:
          type: integer
    AdminAuditEvent:
      type: object
      required: [id, actor_user_id, actor_email{{ if .Workspaces }}, workspace_id{{ end }}, action, target_type, target_id, metadata, created_at]
      properties:
        id:
          type: string
        actor_user_id:
          type: [string, 'null']
        actor_email:
          type: string
{{- if .Workspaces }}
        workspace_id:
          type: [string, 'null']
{{- end }}
        action:
          type: string
        target_type:
          type: string
        target_id:
          type: string
        metadata:
          type: string
          description: JSON text with details of the event.
        created_at:
          type: string
          format: date-time
    AdminDashboard:
      type: object
      required: [metrics, users, events]
      properties:
        metrics:
          $ref: '#/components/schemas/AdminMetrics'
        users:
          $ref: '#/components/schemas/AdminUserPage'
        events:
          type: array
          items:
            $ref: '#/components/schemas/AdminAuditEvent'
