// cookieValue returns the value of the named Set-Cookie header, or "".
func cookieValue(recorder *httptest.ResponseRecorder, name string) string {
	for _, cookie := range recorder.Result().Cookies() {
		if cookie.Name == name {
			return cookie.Value
		}
	}
	return ""
}
