// invitationCookie returns the pending_invitation cookie a response set,
// or nil.
func invitationCookie(recorder *httptest.ResponseRecorder) *http.Cookie {
	for _, cookie := range recorder.Result().Cookies() {
		if cookie.Name == "pending_invitation" {
			return cookie
		}
	}
	return nil
}

func expectInvitationCleared(t *testing.T, recorder *httptest.ResponseRecorder) {
	t.Helper()
	cookie := invitationCookie(recorder)
	if cookie == nil || cookie.MaxAge >= 0 || cookie.Value != "" {
		t.Fatalf("pending_invitation = %#v, want it cleared", cookie)
	}
}

func pendingInvitationOf(t *testing.T, environment *apiEnvironment, session string, cookie *http.Cookie) (any, *httptest.ResponseRecorder) {
	t.Helper()
	recorder := environment.send(t, apiRequest{method: http.MethodGet, path: "/api/v1/account", cookie: session, cookies: []*http.Cookie{cookie}})
	expectStatus(t, recorder, http.StatusOK)
	body := decodeBody[map[string]any](t, recorder)
	value, ok := body["pending_invitation"]
	if !ok {
		t.Fatalf("account has no pending_invitation: %s", recorder.Body.String())
	}
	return value, recorder
}

// A guest opens the invitation in one tab and finishes sign-in and
// onboarding in another: the pending_invitation cookie carries the
// invitation, so no default workspace is created and the app returns to it.
func TestInvitationCookieCarriesTheInvitationThroughOnboarding(t *testing.T) {
	environment := newAPIEnvironment(t)
	seeded := seedTeam(t, environment)
	invited := environment.send(t, apiRequest{method: http.MethodPost, path: seeded.path("/invitations"), body: `{"email":"newcomer@example.com","role":"member"}`, bearer: seeded.owner})
	expectStatus(t, invited, http.StatusAccepted)
	token := environment.invitationToken(t)

	preview := environment.send(t, apiRequest{method: http.MethodGet, path: "/api/v1/invitations/" + token})
	expectStatus(t, preview, http.StatusOK)
	pending := invitationCookie(preview)
	if pending == nil || pending.Value != token || !pending.HttpOnly || pending.Path != "/" || pending.MaxAge != 7*24*60*60 || pending.SameSite != http.SameSiteLaxMode {
		t.Fatalf("preview cookie = %#v", pending)
	}

	sent := environment.send(t, apiRequest{method: http.MethodPost, path: "/api/v1/auth/magic-link", body: `{"email":"newcomer@example.com"}`})
	expectStatus(t, sent, http.StatusAccepted)
	verified := environment.send(t, apiRequest{method: http.MethodPost, path: "/api/v1/auth/magic-link/verify", body: `{"token":"` + environment.mailedToken(t, "/auth/magic-link/") + `"}`})
	expectStatus(t, verified, http.StatusOK)
	session := decodeBody[api.SessionToken](t, verified).Token

	shown, _ := pendingInvitationOf(t, environment, session, pending)
	if shown != token {
		t.Fatalf("pending_invitation = %v, want %q", shown, token)
	}

	onboarded := environment.send(t, apiRequest{method: http.MethodPost, path: "/api/v1/auth/onboarding", body: `{"name":"Newcomer"}`, cookie: session, cookies: []*http.Cookie{pending}})
	expectStatus(t, onboarded, http.StatusOK)
	if body := decodeBody[map[string]any](t, onboarded); body["workspace"] != nil {
		t.Fatalf("onboarding with a pending invitation created a workspace: %s", onboarded.Body.String())
	}

	// The signed-in preview forgets the cookie, the accept joins.
	again := environment.send(t, apiRequest{method: http.MethodGet, path: "/api/v1/invitations/" + token, cookie: session, cookies: []*http.Cookie{pending}})
	expectStatus(t, again, http.StatusOK)
	expectInvitationCleared(t, again)
	accepted := environment.send(t, apiRequest{method: http.MethodPost, path: "/api/v1/invitations/" + token + "/accept", cookie: session, cookies: []*http.Cookie{pending}})
	expectStatus(t, accepted, http.StatusOK)
	expectInvitationCleared(t, accepted)
	joined := decodeBody[struct {
		Items []api.Membership `json:"items"`
	}](t, environment.send(t, apiRequest{method: http.MethodGet, path: "/api/v1/workspaces", cookie: session}))
	if len(joined.Items) != 1 || joined.Items[0].Workspace.ID != seeded.workspace.ID {
		t.Fatalf("newcomer workspaces = %#v", joined.Items)
	}

	// A used invitation is no longer pending.
	shown, recorder := pendingInvitationOf(t, environment, session, pending)
	if shown != nil {
		t.Fatalf("pending_invitation after accept = %v", shown)
	}
	expectInvitationCleared(t, recorder)
	used := environment.send(t, apiRequest{method: http.MethodGet, path: "/api/v1/invitations/" + token, cookies: []*http.Cookie{pending}})
	expectError(t, used, http.StatusGone, "invitation_unavailable")
	expectInvitationCleared(t, used)
}

// A cookie for an unknown invitation or for another address is ignored:
// onboarding creates the default workspace and the cookie is cleared.
func TestInvitationCookieIgnoresUnavailableInvitations(t *testing.T) {
	environment := newAPIEnvironment(t)
	seeded := seedTeam(t, environment)
	invited := environment.send(t, apiRequest{method: http.MethodPost, path: seeded.path("/invitations"), body: `{"email":"someone-else@example.com","role":"member"}`, bearer: seeded.owner})
	expectStatus(t, invited, http.StatusAccepted)
	foreign := environment.invitationToken(t)

	for index, token := range []string{"unknown", foreign} {
		fresh := testutil.SeedUser(t, environment.database, testutil.UserOptions{ID: "fresh-" + token[:4], Email: "fresh-" + token[:4] + "@example.com", Verified: true})
		_, err := environment.database.Exec(`DELETE FROM workspaces WHERE id = $1`, fresh.Workspace.ID)
		if err != nil {
			t.Fatalf("remove fixture workspace: %v", err)
		}
		session := environment.signIn(t, fresh.User.ID)
		cookie := &http.Cookie{Name: "pending_invitation", Value: token}

		shown, recorder := pendingInvitationOf(t, environment, session, cookie)
		if shown != nil {
			t.Fatalf("case %d: pending_invitation = %v", index, shown)
		}
		expectInvitationCleared(t, recorder)

		onboarded := environment.send(t, apiRequest{method: http.MethodPost, path: "/api/v1/auth/onboarding", body: `{"name":"Fresh"}`, cookie: session, cookies: []*http.Cookie{cookie}})
		expectStatus(t, onboarded, http.StatusOK)
		if body := decodeBody[map[string]any](t, onboarded); body["workspace"] == nil {
			t.Fatalf("case %d: cookie %q skipped the default workspace: %s", index, token, onboarded.Body.String())
		}
		expectInvitationCleared(t, onboarded)
	}
}
