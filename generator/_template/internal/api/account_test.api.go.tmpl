func TestDeleteAccountRefusesActiveSubscription(t *testing.T) {
	environment := newAPIEnvironment(t)
	fixture := testutil.SeedUser(t, environment.database, testutil.UserOptions{ID: "subscriber", Email: "subscriber@example.com", Name: "Subscriber", Verified: true})
	_, err := environment.database.Exec(`UPDATE subscriptions SET plan_id = $1, status = $2 WHERE user_id = $3`, "pro", "active", fixture.User.ID)
	if err != nil {
		t.Fatalf("mark subscription paid: %v", err)
	}
	token := environment.signIn(t, fixture.User.ID)

	recorder := environment.send(t, apiRequest{method: http.MethodDelete, path: "/api/v1/account", body: `{"confirm_email":"subscriber@example.com"}`, bearer: token})
	expectError(t, recorder, http.StatusConflict, "active_subscription")
}
{{- end }}

func TestAccountRoutesRequireOnboarding(t *testing.T) {
	environment := newAPIEnvironment(t)
	user := testutil.SeedUser(t, environment.database, testutil.UserOptions{ID: "unnamed", Email: "unnamed@example.com", Verified: true}).User
	token := environment.signIn(t, user.ID)

	routes := []apiRequest{
		{method: http.MethodPatch, path: "/api/v1/account/name", body: `{"name":"Named"}`},
		{method: http.MethodPatch, path: "/api/v1/account/email", body: `{"email":"named@example.com"}`},
		{method: http.MethodPost, path: "/api/v1/account/password", body: `{"current_password":"x","new_password":"y"}`},
		{method: http.MethodPost, path: "/api/v1/account/password/set", body: `{"password":"x"}`},
		{method: http.MethodDelete, path: "/api/v1/account/password"},
		{method: http.MethodDelete, path: "/api/v1/account", body: `{"confirm_email":"unnamed@example.com"}`},
		{method: http.MethodGet, path: "/api/v1/account/sessions"},
		{method: http.MethodDelete, path: "/api/v1/account/sessions/any"},
		{method: http.MethodDelete, path: "/api/v1/account/sessions"},
{{- if .Storage }}
		{method: http.MethodPost, path: "/api/v1/account/avatar"},
		{method: http.MethodDelete, path: "/api/v1/account/avatar"},
{{- end }}
	}
	for _, route := range routes {
		t.Run(route.method+" "+route.path, func(t *testing.T) {
			anonymous := route
			expectError(t, environment.send(t, anonymous), http.StatusUnauthorized, "unauthenticated")
			route.bearer = token
			expectError(t, environment.send(t, route), http.StatusForbidden, "onboarding_required")
		})
	}
}
