-- +goose Up
-- Initial database schema for goilerplate
-- Compatible with both PostgreSQL and SQLite

-- ============================================================================
-- USERS TABLE
-- Core user accounts with optional password (supports OAuth/magic link)
-- ============================================================================
CREATE TABLE IF NOT EXISTS users (
    id TEXT PRIMARY KEY,
    email TEXT UNIQUE NOT NULL,
    -- Explicitly nullable for passwordless authentication.
    password_hash TEXT NULL,
    pending_email TEXT NULL,
    email_verified_at {{.DatabaseTimestamp}} NULL,
    created_at {{.DatabaseTimestamp}} NOT NULL DEFAULT CURRENT_TIMESTAMP,
    name TEXT NOT NULL DEFAULT '',
    updated_at {{.DatabaseTimestamp}}
);

CREATE INDEX IF NOT EXISTS idx_users_passwordless ON users(id) WHERE password_hash IS NULL;

-- ============================================================================
-- TOKENS TABLE
-- Verification tokens, password reset tokens, magic links
-- ============================================================================
CREATE TABLE IF NOT EXISTS tokens (
    id TEXT PRIMARY KEY,
    user_id TEXT NOT NULL,
    type TEXT NOT NULL,
    token_hash TEXT UNIQUE NOT NULL,
    expires_at {{.DatabaseTimestamp}} NOT NULL,
    created_at {{.DatabaseTimestamp}} DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_tokens_expires_at ON tokens(expires_at);
CREATE INDEX IF NOT EXISTS idx_tokens_user_id ON tokens(user_id);

-- ============================================================================
-- SESSIONS TABLE
-- Revocable browser sessions. Only a hash of the browser token is stored.
-- ============================================================================
CREATE TABLE IF NOT EXISTS sessions (
    id TEXT PRIMARY KEY,
    user_id TEXT NOT NULL,
    impersonator_user_id TEXT,
    token_hash TEXT UNIQUE NOT NULL,
    user_agent TEXT NOT NULL DEFAULT '',
    expires_at {{.DatabaseTimestamp}} NOT NULL,
    last_seen_at {{.DatabaseTimestamp}} NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_at {{.DatabaseTimestamp}} NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (impersonator_user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_sessions_user_id ON sessions(user_id);
CREATE INDEX IF NOT EXISTS idx_sessions_impersonator_user_id ON sessions(impersonator_user_id);
CREATE INDEX IF NOT EXISTS idx_sessions_expires_at ON sessions(expires_at);

{{- if .API }}

-- ============================================================================
-- API TOKENS TABLE
-- Personal API tokens for scripts and agents. Only a hash of the token is
-- stored; prefix is the start of the token for display.
-- ============================================================================
CREATE TABLE IF NOT EXISTS api_tokens (
    id TEXT PRIMARY KEY,
    user_id TEXT NOT NULL,
    name TEXT NOT NULL,
    token_hash TEXT UNIQUE NOT NULL,
    prefix TEXT NOT NULL,
    scopes TEXT NOT NULL CHECK (scopes IN ('read', 'read,write')),
    last_used_at {{.DatabaseTimestamp}},
    expires_at {{.DatabaseTimestamp}},
    created_at {{.DatabaseTimestamp}} NOT NULL DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_api_tokens_user_id ON api_tokens(user_id);
{{- end }}

-- ============================================================================
-- ADMIN AUDIT EVENTS
-- Operator-level security and billing history retained after tenant deletion.
-- ============================================================================
CREATE TABLE IF NOT EXISTS admin_audit_events (
    id TEXT PRIMARY KEY,
    actor_user_id TEXT,
    workspace_id TEXT,
    action TEXT NOT NULL,
    target_type TEXT NOT NULL,
    target_id TEXT NOT NULL,
    metadata TEXT NOT NULL DEFAULT '{}',
    created_at {{.DatabaseTimestamp}} NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_admin_audit_events_created_at ON admin_audit_events(created_at);


-- ============================================================================
-- SUBSCRIPTIONS TABLE
-- Subscription plans and billing information
-- ============================================================================
CREATE TABLE IF NOT EXISTS subscriptions (
    id TEXT PRIMARY KEY,
    user_id TEXT UNIQUE NOT NULL,
    plan_id TEXT NOT NULL DEFAULT 'free',
    status TEXT NOT NULL DEFAULT 'active',
    provider_customer_id TEXT,
    provider_subscription_id TEXT,
    provider_subscription_created_at {{.DatabaseTimestamp}},
    provider_state_updated_at {{.DatabaseTimestamp}},
    provider_payment_updated_at {{.DatabaseTimestamp}},
    current_period_end {{.DatabaseTimestamp}},
    amount INTEGER,
    currency TEXT,
    interval TEXT,
    created_at {{.DatabaseTimestamp}} DEFAULT CURRENT_TIMESTAMP,
    updated_at {{.DatabaseTimestamp}} DEFAULT CURRENT_TIMESTAMP,
    provider TEXT NOT NULL DEFAULT '',
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_subscriptions_status ON subscriptions(status);
CREATE INDEX IF NOT EXISTS idx_subscriptions_provider ON subscriptions(provider);

{{ if .Storage }}
-- ============================================================================
-- FILES TABLE
-- Stored file metadata for the selected storage provider.
-- ============================================================================
CREATE TABLE IF NOT EXISTS files (
    id TEXT PRIMARY KEY,
    user_id TEXT NOT NULL,
    owner_type TEXT NOT NULL,
    owner_id TEXT NOT NULL,
    type TEXT NOT NULL,
    filename TEXT NOT NULL,
    original_name TEXT,
    mime_type TEXT,
    size INTEGER,
    storage_path TEXT NOT NULL,
    public BOOLEAN DEFAULT true,
    created_at {{.DatabaseTimestamp}} DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_files_user_id ON files(user_id);
CREATE INDEX IF NOT EXISTS idx_files_owner ON files(owner_type, owner_id);
CREATE UNIQUE INDEX IF NOT EXISTS idx_files_owner_type ON files(owner_type, owner_id, type) WHERE type IN ('avatar');
{{ end }}
{{ if .HasBlog }}
-- ============================================================================
-- NEWSLETTER SUBSCRIBERS TABLE
-- Email addresses captured by the selected blog module.
-- ============================================================================
CREATE TABLE IF NOT EXISTS newsletter_subscribers (
    email TEXT PRIMARY KEY,
    created_at {{.DatabaseTimestamp}} NOT NULL DEFAULT CURRENT_TIMESTAMP
);
{{ end }}

