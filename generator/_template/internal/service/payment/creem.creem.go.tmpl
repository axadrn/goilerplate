func (p *CreemProvider) CreateCheckoutURL(accountID, planID, interval, email, _ string) (string, error) {
	successURL := p.cfg.AppURL + "/app/billing"
{{- end }}
	productID := p.checkoutProduct(planID, interval)
	if productID == "" {
		return "", fmt.Errorf("no Creem product configured for %s (%s)", planID, interval)
	}

	sub, err := p.subscriptions.Subscription(accountID)
	if err != nil {
		return "", err
	}

	{{- if not .Workspaces }}
	if sub.HasProviderSubscription() {
		return "", errors.New("manage the existing Creem subscription before starting another checkout")
	}
{{- end }}

	checkout := creemCheckoutRequest{
		ProductID: productID,
		SuccessURL: successURL,
		Metadata: creemMetadata{AccountID: accountID, SubscriptionID: sub.ID},
	}
	if email != "" {
		checkout.Customer = map[string]string{"email": email}
	}
{{- if .Workspaces }}
	expiresAt := time.Now().Add(creemCheckoutReuseWindow)
	pendingUntil := expiresAt.Add(checkoutWebhookGrace)
	checkoutURL, attemptID, reused, err := p.subscriptions.BeginCheckout(accountID, p.Name(), planID, interval, expiresAt, pendingUntil)
	if err != nil {
		return "", err
	}
	if reused {
		return checkoutURL, nil
	}
	checkout.RequestID = attemptID
	checkout.Metadata.AttemptID = attemptID
	checkoutURL, status, err := p.createCheckout(checkout)
	if err != nil {
		switch status {
		case http.StatusBadRequest, http.StatusUnauthorized, http.StatusForbidden, http.StatusNotFound, http.StatusUnprocessableEntity:
			p.subscriptions.RejectCheckout(accountID, attemptID)
		}
		return "", err
	}
	if err := p.subscriptions.FinishCheckout(accountID, attemptID, checkoutURL, expiresAt, pendingUntil); err != nil {
		return "", err
	}
	return checkoutURL, nil
{{- else }}
	checkoutURL, _, err := p.createCheckout(checkout)
	return checkoutURL, err
{{- end }}
}

func (p *CreemProvider) createCheckout(checkout creemCheckoutRequest) (string, int, error) {
	body, err := json.Marshal(checkout)
	if err != nil {
		return "", 0, fmt.Errorf("encode Creem checkout: %w", err)
	}
	req, err := http.NewRequest(http.MethodPost, p.baseURL+"/v1/checkouts", bytes.NewReader(body))
	if err != nil {
		return "", 0, fmt.Errorf("build Creem checkout request: %w", err)
	}
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("x-api-key", p.cfg.CreemAPIKey)
	resp, err := p.client.Do(req)
	if err != nil {
		return "", 0, fmt.Errorf("create Creem checkout: %w", err)
	}
	defer resp.Body.Close()

	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return "", resp.StatusCode, fmt.Errorf("create Creem checkout: HTTP %d", resp.StatusCode)
	}
	var result struct {
		URL string `json:"checkout_url"`
	}
	if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
		return "", resp.StatusCode, fmt.Errorf("decode Creem checkout: %w", err)
	}
	if result.URL == "" {
		return "", resp.StatusCode, errors.New("Creem checkout response has no URL")
	}
	return result.URL, resp.StatusCode, nil
}

