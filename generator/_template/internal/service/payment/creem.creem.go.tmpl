type CreemProvider struct {
	cfg *config.Config
	subscriptions *service.SubscriptionService
	client *http.Client
	baseURL string
}

func NewCreemProvider(cfg *config.Config, subscriptions *service.SubscriptionService) *CreemProvider {
	baseURL := creemAPI
	if cfg.CreemSandboxMode {
		baseURL = creemTestAPI
	}
	return &CreemProvider{
		cfg: cfg,
		subscriptions: subscriptions,
		client: &http.Client{
			Timeout: 10 * time.Second,
			// Keep the API key on Creem's API origin.
			CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
		},
		baseURL: baseURL,
	}
}

func (p *CreemProvider) Name() string {
	return model.ProviderCreem
}

type creemProduct struct {
	id string
	plan string
	interval string
}

func (p *CreemProvider) products() [4]creemProduct {
	return [4]creemProduct{
		{p.cfg.CreemProductIDProMonthly, model.SubscriptionPlanPro, model.SubscriptionIntervalMonthly},
		{p.cfg.CreemProductIDProYearly, model.SubscriptionPlanPro, model.SubscriptionIntervalYearly},
		{p.cfg.CreemProductIDEnterpriseMonthly, model.SubscriptionPlanEnterprise, model.SubscriptionIntervalMonthly},
		{p.cfg.CreemProductIDEnterpriseYearly, model.SubscriptionPlanEnterprise, model.SubscriptionIntervalYearly},
	}
}

func (p *CreemProvider) checkoutProduct(plan, interval string) string {
	for _, product := range p.products() {
		if product.plan == plan && product.interval == interval {
			return product.id
		}
	}
	return ""
}

func (p *CreemProvider) product(id string) creemProduct {
	for _, product := range p.products() {
		if id != "" && id == product.id {
			return product
		}
	}
	return creemProduct{}
}

